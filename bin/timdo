#!/usr/bin/env bash
# timdo: command line client for the TimDo API (tasks, epics, goals, workspaces and sharing).
# Run `timdo help` for usage. Needs bash, curl and jq.
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration. Environment variables win over the config file, so
#   TIMDO_API=http://127.0.0.1:8788/api/v2 TIMDO_SECRET=local-dev-secret timdo list
# talks to a local API even when ~/.config/timdo/config holds the production secret.
# ---------------------------------------------------------------------------
_env_secret="${TIMDO_SECRET:-}"
_env_token="${TIMDO_TOKEN:-}"
_env_api="${TIMDO_API:-}"
_env_as="${TIMDO_AS:-}"
TIMDO_CONFIG="${TIMDO_CONFIG:-$HOME/.config/timdo/config}"
if [[ -f "$TIMDO_CONFIG" ]]; then
  # shellcheck disable=SC1090
  source "$TIMDO_CONFIG"
fi
[[ -n "$_env_secret" ]] && TIMDO_SECRET="$_env_secret"
[[ -n "$_env_token" ]] && TIMDO_TOKEN="$_env_token"
TIMDO_TOKEN="${TIMDO_TOKEN:-}"
[[ -n "$_env_api" ]] && TIMDO_API="$_env_api"
[[ -n "$_env_as" ]] && TIMDO_AS="$_env_as"
TIMDO_API="${TIMDO_API:-https://timdo-v2-api.tdobson.net/api/v2}"
while [[ "$TIMDO_API" == */ && "$TIMDO_API" != "/" ]]; do TIMDO_API="${TIMDO_API%/}"; done
TIMDO_AS="${TIMDO_AS:-}"
TIMDO_FORMAT="${TIMDO_FORMAT:-text}"
FORMAT_EXPLICIT=0
APP_URL="${TIMDO_APP_URL:-https://timdo.tdobson.net}"
ERR_HINT=""
CLASH_HINT=""
BOT_OWNER_SECRET_SELECTED=false

# ---------------------------------------------------------------------------
# Global flags may appear anywhere: --json, --text, --as <email>, --no-color
# ---------------------------------------------------------------------------
_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) TIMDO_FORMAT="json"; FORMAT_EXPLICIT=1 ;;
    --text) TIMDO_FORMAT="text"; FORMAT_EXPLICIT=1 ;;
    --no-color|--no-colour) NO_COLOR=1 ;;
    --as)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --as needs an email address, e.g. --as robin@example.com" >&2
        exit 1
      fi
      TIMDO_AS="$2"; shift ;;
    --as=*) TIMDO_AS="${1#--as=}" ;;
    --limit|--cursor|--group-by|--fields|--status)
      _args+=("$1")
      if [[ $# -gt 1 ]]; then _args+=("$2"); shift; fi
      ;;
    --)
      [[ "${_args[0]:-}" == bot ]] && _args+=("--")
      shift; _args+=("$@"); break ;;
    *) _args+=("$1") ;;
  esac
  shift
done
set -- ${_args[@]+"${_args[@]}"}

TIMDO_SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -h "$TIMDO_SOURCE_PATH" ]]; do
  TIMDO_SOURCE_DIR=$(cd -P "$(dirname "$TIMDO_SOURCE_PATH")" >/dev/null 2>&1 && pwd)
  TIMDO_SOURCE_PATH=$(readlink "$TIMDO_SOURCE_PATH")
  [[ "$TIMDO_SOURCE_PATH" == /* ]] || TIMDO_SOURCE_PATH="$TIMDO_SOURCE_DIR/$TIMDO_SOURCE_PATH"
done
TIMDO_SCRIPT_DIR=$(cd -P "$(dirname "$TIMDO_SOURCE_PATH")" >/dev/null 2>&1 && pwd)
unset TIMDO_SOURCE_PATH TIMDO_SOURCE_DIR
TMPD=$(mktemp -d "${TMPDIR:-/tmp}/timdo.XXXXXX")
trap 'rm -rf "$TMPD"' EXIT

# ---------------------------------------------------------------------------
# Colour (only on a terminal, and never when NO_COLOR is set)
# ---------------------------------------------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; GRN=$'\e[32m'; YEL=$'\e[33m'; CYN=$'\e[36m'; RED=$'\e[31m'
  COLORS='{"bold":"\u001b[1m","dim":"\u001b[2m","reset":"\u001b[0m","green":"\u001b[32m","yellow":"\u001b[33m","cyan":"\u001b[36m","red":"\u001b[31m","magenta":"\u001b[35m"}'
else
  B=""; D=""; R=""; GRN=""; YEL=""; CYN=""; RED=""
  COLORS='{}'
fi
if [[ -t 1 ]]; then
  COLS=$(tput cols 2>/dev/null || echo 120)
  [[ "$COLS" =~ ^[0-9]+$ ]] || COLS=120
else
  COLS=0 # 0 = not a terminal, so never truncate
fi
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then E_RED=$'\e[31m'; E_R=$'\e[0m'; else E_RED=""; E_R=""; fi

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
die() {
  echo "${E_RED}$*${E_R}" >&2
  exit 1
}

usage_die() {
  echo "$*" >&2
  exit 1
}

is_text() { [[ "$TIMDO_FORMAT" == "text" ]]; }

# Older write commands (add, update, delete, add-note, epic add/update/delete) printed JSON.
# They still do when piped (scripts and agents rely on it), unless --text is given.
# On a terminal they print a readable confirmation instead.
text_out() { [[ "$TIMDO_FORMAT" == "text" && ( "$FORMAT_EXPLICIT" == "1" || -t 1 ) ]]; }

urlencode() { jq -rn --arg v "$1" '$v | @uri'; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Ask before doing something drastic. Returns 0 when confirmed.
# With --yes it never asks. Off a terminal it refuses (exit 1) and says how to confirm.
confirm_or_exit() {
  local prompt="$1" assume_yes="$2"
  [[ "$assume_yes" == "true" ]] && return 0
  if [[ -t 0 && -t 1 ]]; then
    local answer=""
    read -r -p "$prompt [y/N] " answer || true
    if [[ "$answer" =~ ^[Yy] ]]; then
      return 0
    fi
    echo "Cancelled. Nothing changed."
    exit 0
  fi
  die "Nothing changed. Re-run with --yes to confirm."
}

# Questions that are not about something drastic (like "is this a duplicate?") only need a
# person at a terminal. TIMDO_FORCE_TTY=1 lets the tests answer them through a pipe; only the
# prompt helpers read it.
can_prompt() {
  [[ "${TIMDO_FORCE_TTY:-}" == "1" ]] && return 0
  [[ -t 0 && -t 1 ]]
}

# ask_similar <similar json>: show likely duplicates on stderr and ask what to do.
# Prints "create", "cancel" or the number (from 1) of the task to add a note to instead.
# The default (Enter, end of input, or three answers it cannot read) is "cancel".
ask_similar() {
  local similar="$1" count range answer tries=0
  count=$(echo "$similar" | jq 'length')
  range="1"
  [[ "$count" -gt 1 ]] && range="1-$count"
  {
    if [[ "$count" -eq 1 ]]; then echo "${B}This looks like an open task:${R}"; else echo "${B}These look like open tasks:${R}"; fi
    echo "$similar" | jqt 'similar_lines(true; $me)' --arg me "$( (my_id) 2>/dev/null || true)"
  } >&2
  while true; do
    printf 'Create anyway? [y]es / [n]o / [%s] add as a note to that task: ' "$range" >&2
    answer=""
    if ! IFS= read -r answer; then
      echo >&2
      echo "cancel"
      return
    fi
    # A terminal echoes the answer and its newline; piped answers (tests) do not
    [[ -t 0 ]] || echo >&2
    answer=$(lower "$(printf '%s' "$answer" | tr -d '[:space:]')")
    case "$answer" in
      y|yes) echo "create"; return ;;
      ""|n|no) echo "cancel"; return ;;
    esac
    if [[ "$answer" =~ ^[0-9]{1,3}$ ]] && (( 10#$answer >= 1 && 10#$answer <= count )); then
      if [[ "$(echo "$similar" | jq -r --argjson i "$answer" '.[$i - 1].canEdit == false')" == "true" ]]; then
        echo "You can view that task but cannot add a note there. Choose another match or press n." >&2
      else
        echo $(( 10#$answer ))
        return
      fi
    fi
    tries=$((tries + 1))
    if [[ "$tries" -ge 3 ]]; then
      echo "cancel"
      return
    fi
    echo "Answer y to create it, n to stop, or $range to add a note to that task instead." >&2
  done
}

# ---------------------------------------------------------------------------
# jq library shared by every formatter
# ---------------------------------------------------------------------------
read -r -d '' JQ_LIB <<'JQ' || true
def pad($n): tostring | if length < $n then . + (" " * ($n - length)) else . end;
def lpad($n): tostring | if length < $n then (" " * ($n - length)) + . else . end;
def trunc($n): tostring | if ($n > 3) and (length > $n) then .[0:($n - 3)] + "..." else . end;
def oneline: (. // "") | tostring | gsub("[\r\n\t]+"; " ");
def maxlen(f): ([.[] | f | tostring | length] + [0]) | max;
def epoch: (. // "") | tostring | sub(" "; "T") | .[0:16] | (try (strptime("%Y-%m-%dT%H:%M") | mktime) catch null);
def fdate($f): epoch as $t | if $t == null then "" else ($t | strflocaltime($f)) end;
def short_dt: fdate("%d %b %H:%M");
def long_dt: fdate("%d %b %Y %H:%M");
def day: fdate("%d %b %Y");
def first_name: (. // "") | tostring | split(" ")[0];
def c($k): ($C[$k] // "");
def paint($k): if c($k) == "" or . == "" then . else c($k) + . + c("reset") end;
def status_order: ({"do":0,"awaiting":1,"delegate":2,"delay":3,"done":4}[.] // 9);
def who: if .assigneeId == null then "unassigned" elif .isMine == true then "me" else ((.assigneeName // "someone") | first_name) end;
def where: (.projectName // .category // "") as $p
  | if .isShared == true then (if ($p | ascii_downcase) == ((.orgName // "") | ascii_downcase) then $p else "\(.orgName // "?")/\($p)" end) else $p end;
def role_note: if .canEdit == false then "view only" else "" end;
def task_widths: {t: ([maxlen(.project | oneline), 52] | min), w: maxlen(where), h: maxlen(select(.isShared == true) | who)};
def task_line($w):
  . as $task
  | who as $who
  | (.project | oneline | if $cols > 0 then trunc($w.t) else . end) as $title
  | (if .status == "awaiting" then "returns \((.awaitUntil // "no date") | tostring | .[0:10])  " else "" end) as $aw
  | (if .canEdit == false then "view only  " else "" end) as $ro
  | (2 + 4 + 2 + 8 + 2 + $w.t + 2 + $w.w + 2 + (if $w.h > 0 then $w.h + 2 else 0 end) + ($aw | length) + ($ro | length)) as $used
  | ((.reason // "") | oneline | if $cols > 0 then trunc([$cols - $used - 2, 12] | max) else . end) as $why
  | ("  " + ("[\(.priority)]" | lpad(4) | paint("bold"))
    + "  " + ((.id // "")[0:8] | paint("dim"))
    + "  " + ($title | pad($w.t))
    + "  " + (where | pad($w.w) | paint("cyan"))
    + (if $w.h > 0 then "  " + (if $task.isShared == true then $who else "" end | pad($w.h)
        | paint(if $who == "me" then "green" elif $who == "unassigned" then "dim" else "yellow" end)) else "" end)
    + "  " + ($aw | paint("yellow")) + ($ro | paint("red"))
    + (if $why == "" then "" else ("- " + $why | paint("dim")) end))
  | sub(" +$"; "");
def task_group_key($by):
  if $by == "project" then (.projectId // .projectName // .category // "")
  elif $by == "epic" then (.epicId // "")
  else (.assigneeId // "") end | tostring;
def task_group_label($by):
  if $by == "project" then (where | if . == "" then "No project" else . end)
  elif $by == "epic" then (if .epicId then (.epicTitle // .epicName // ("Epic " + (.epicId[0:8]))) else "No epic" end)
  else (if .assigneeId == null then "Unassigned" else (.assigneeName // .assigneeId) end) end | tostring | gsub("[\\p{Cc}]+"; " ");
def activity_actor: (.actorName // "Someone") as $name
  | (if .actorKind == "bot" then $name + " [bot]" else $name end)
  + (if .via == "owner_secret" then " (via owner secret)" else "" end);
def activity_line($aw):
  "  " + ((.createdAt | short_dt) | pad(12) | paint("dim"))
  + "  " + (activity_actor | pad($aw) | paint("bold"))
  + "  " + (.summary // .action // "" | oneline)
  + (if .projectName then "  " + ("[\(.projectName)]" | paint("cyan")) else "" end);
def activity_lines: (maxlen(activity_actor)) as $aw | .[] | activity_line($aw);
def note_author: (.authorName // "Someone") + (if .authorKind == "bot" then " [bot]" else "" end);
def note_lines:
  maxlen(note_author) as $aw
  | .[]
  | "  " + ((.createdAt | long_dt) | pad(17) | paint("dim"))
    + "  " + (note_author | pad($aw) | paint("bold"))
    + "  " + ((.note // "") | tostring | gsub("\n"; "\n" + (" " * (2 + 17 + 2 + $aw + 2))))
    + (if .gmailThreadId then ("  (thread: \(.gmailThreadId))" | paint("dim")) else "" end);
# Refs: links from a task to things outside TimDo, shown as kind:ref
def role_label: {"link":"Link","source":"Source","reported_by":"Reported by","about":"About"}[.] // .;
# The word the activity log uses for a role: "Removed reporter acme.member:200 from ..."
def role_noun: {"link":"link","source":"source","reported_by":"reporter","about":"about"}[.] // .;
# Control characters (line breaks, escapes) never reach the terminal from a ref or label
def safe: (. // "") | tostring | gsub("[\\p{Cc}]+"; " ");
def role_order: ({"source":0,"about":1,"reported_by":2,"link":3}[.role] // 9);
def ref_canonical: (.canonical // "\(.kind):\(.ref)") | safe;
def ref_extra: ([(.label // empty | safe), (.url // empty | safe | paint("dim"))] | join("  "));
def ref_cell($cw): ref_canonical | if $cols > 0 then trunc(60) else . end | pad($cw);
def ref_line($cw): "  " + (.role | role_label | pad(11)) + "  " + ref_cell($cw) + "  " + ref_extra | sub(" +$"; "");
def ref_width: [maxlen(ref_canonical), 60] | min;
def ref_done_line: "  " + (if .existing == true then "Already linked" else "Linked" end) + " " + ref_canonical
  + (if .role != "link" then " (" + (.role | role_label | ascii_downcase) + ")" else "" end)
  + (if .existing == true then (", nothing changed" | paint("dim")) else "" end);
# Similar open tasks (GET /tasks/similar, and `similar` on a create response)
def sim_id: (.shortId // (.id // "")[0:8]);
def sim_title: .title | oneline | safe;
def sim_who($me): if .assigneeId == null and .assigneeName == null then "unassigned"
  elif $me != "" and .assigneeId == $me then "me" else ((.assigneeName // "someone") | safe | first_name) end;
def similar_hint: "Similar open task: \(sim_id) \"\(sim_title)\" (\(.projectName // "" | safe))";
def similar_lines($numbered; $me):
  {t: ([maxlen(sim_title), 52] | min), p: maxlen(.projectName // "" | safe), n: (length | tostring | length)} as $w
  | to_entries[] | .key as $i | .value | sim_who($me) as $who
  | "  " + (if $numbered then ("\($i + 1)" | lpad($w.n)) + "  " else "" end)
    + (sim_id | paint("dim"))
    + "  " + (sim_title | if $cols > 0 then trunc($w.t) else . end | pad($w.t))
    + "  " + (.projectName // "" | safe | pad($w.p) | paint("cyan"))
    + "  " + ($who | paint(if $who == "me" then "green" elif $who == "unassigned" then "dim" else "yellow" end))
    + (if .status != null and .status != "do" then "  " + (.status | paint("dim")) else "" end)
    + (if .canEdit == false then "  " + ("view only" | paint("red")) else "" end)
  | sub(" +$"; "");
JQ

# jqt PROGRAM [jq options...]: run a jq program with the shared library and raw output
jqt() {
  local prog="$1"; shift
  jq -r --argjson C "$COLORS" --argjson cols "$COLS" "$@" "$JQ_LIB
$prog"
}

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Credentials: a personal token (from `timdo login`) acts as you; the owner's internal
# secret (TIMDO_SECRET) is for the account owner's own tooling only.
require_credentials() {
  if [[ "$BOT_OWNER_SECRET_SELECTED" == true && -z "${TIMDO_SECRET:-}" ]]; then
    if [[ "${EVENT_FOLLOW_ACTIVE:-}" == "1" ]]; then
      printf 'The --owner-secret option needs TIMDO_SECRET configured in the environment or %s.\n' "$TIMDO_CONFIG" >&2
      return 1
    fi
    die "The --owner-secret option needs TIMDO_SECRET configured in the environment or $TIMDO_CONFIG."
  fi
  if [[ -z "$TIMDO_TOKEN" && -z "${TIMDO_SECRET:-}" ]]; then
    if [[ "${EVENT_FOLLOW_ACTIVE:-}" == "1" ]]; then
      printf 'Not logged in. Create a token at %s/settings/access, then run: timdo login\n' "$APP_URL" >&2
      return 1
    fi
    echo "Not logged in. Create a token at $APP_URL/settings/access, then run: timdo login" >&2
    exit 1
  fi
}

# Print a readable message for a failed API call and exit non-zero.
api_error() {
  local code="$1" file="$2" msg=""
  msg=$(jq -r '
      if type == "object" then
        if (.error | type) == "string" then
          (.error + (if (.message | type) == "string" and .message != .error then ": " + .message else "" end))
        elif (.error | type) == "object" then
          ((.error.issues // [])[0] | if . then ((.path // []) | map(tostring) | join(".")) + (if (.path // []) | length > 0 then ": " else "" end) + (.message // "invalid input") else null end)
          // (.error.message // "invalid input")
        elif (.message | type) == "string" then .message
        else empty end
      else empty end' "$file" 2>/dev/null || true)
  if [[ -z "$msg" ]]; then
    msg=$(head -c 300 "$file" | tr '\n' ' ')
    [[ -z "$msg" ]] && msg="HTTP $code"
  fi
  # "You have view-only access to X" reads best as "View only: you have view-only access to X"
  local soft="$msg"
  if [[ "$soft" =~ ^[A-Z][a-z] ]]; then soft="$(lower "${soft:0:1}")${soft:1}"; fi
  local prefix
  case "$code" in
    401) prefix="Not signed in" ;;
    403) if [[ "$msg" == *view-only* ]]; then prefix="View only"; else prefix="Not allowed"; fi ;;
    404) prefix="Not found" ;;
    400|422) prefix="Invalid request" ;;
    *) prefix="Error ($code)" ;;
  esac
  if [[ "$msg" == *"invalid or has been revoked"* ]]; then
    die "Not signed in: your token was rejected (revoked or mistyped). Create a new one at $APP_URL/settings/access and run: timdo login"
  fi
  if [[ "$msg" == *"Invalid internal secret"* ]]; then
    die "Not signed in: the API rejected TIMDO_SECRET. Check the environment or $TIMDO_CONFIG (API: $TIMDO_API)."
  fi
  # A 409 with a taskId means the ref is already the source of another task: name it so scripts can recover.
  # Commands can set CLASH_HINT to say what else they could do (add: --on-duplicate report).
  if [[ "$code" == "409" ]]; then
    local other
    other=$(jq -r '.taskId // empty' "$file" 2>/dev/null || true)
    if [[ -n "$other" ]]; then
      die "Already tracked: $msg. Open it with: timdo get ${other:0:8}${CLASH_HINT:+. $CLASH_HINT}"
    fi
  fi
  local who_note=""
  [[ -n "$TIMDO_AS" && ( "$code" == "403" || "$code" == "404" ) && "$msg" != *"$TIMDO_AS"* ]] && who_note=" (acting as $TIMDO_AS)"
  # Commands can set ERR_HINT to say what to try next when the input was wrong or not found
  local hint=""
  [[ "$code" == "400" || "$code" == "404" ]] && hint="$ERR_HINT"
  die "$prefix: $soft$who_note${hint:+. $hint}"
}

# Extract list metadata from the final HTTP response block. curl's -D output can contain
# interim/proxy blocks; header names and line endings are deliberately normalised here.
response_headers_json() {
  local file="$1" line name value total="" cursor=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ "$line" == HTTP/* ]]; then
      total=""
      cursor=""
      continue
    fi
    [[ "$line" == *:* ]] || continue
    name="${line%%:*}"
    value="${line#*:}"
    name="${name,,}"
    value="${value#"${value%%[![:space:]]*}"}"
    case "$name" in
      x-total-count) total="$value" ;;
      x-next-cursor) cursor="$value" ;;
    esac
  done < "$file"
  jq -cn --arg total "$total" --arg cursor "$cursor" '{totalCount:(if $total == "" then null else $total end), nextCursor:(if $cursor == "" then null else $cursor end)}'
}

# api_response returns body and final headers together, so command substitutions cannot lose them.
api_response() {
  API_CAPTURE_RESPONSE=1 api "$@"
}

# Remove one request's private response files before the next follow poll.
api_cleanup_files() {
  local out="$1" err="$2" request_status="$3" header_file="${4:-}"
  rm -f "$out" "$err" "$request_status" 2>/dev/null || true
  [[ -z "$header_file" ]] || rm -f "$header_file" 2>/dev/null || true
}

# api METHOD PATH [curl args...]: prints the response body, or exits non-zero with the API error
api() {
  local method="$1" path="$2"
  shift 2
  require_credentials || return $?
  # Credentials go to curl as a config on stdin (-K -), never as arguments, so they don't
  # show up in `ps` for other users on the machine.
  local auth_header
  if [[ "$BOT_OWNER_SECRET_SELECTED" == true ]]; then
    auth_header="X-Internal-Secret: $TIMDO_SECRET"
  elif [[ -n "$TIMDO_TOKEN" ]]; then
    auth_header="Authorization: Bearer $TIMDO_TOKEN"
  else
    auth_header="X-Internal-Secret: ${TIMDO_SECRET:-}"
  fi
  local headers=(-H "Content-Type: application/json")
  [[ -n "$TIMDO_AS" ]] && headers+=(-H "X-Timdo-User: $TIMDO_AS")
  local out err code header_file="" dump_header=() curl_status request_status_file=""
  out=$(mktemp "$TMPD/resp.XXXXXX")
  err="$out.err"
  request_status_file="$out.status"
  if [[ "${API_CAPTURE_RESPONSE:-}" == "1" ]]; then
    header_file="$out.headers"
    dump_header=(-D "$header_file")
  fi
  if [[ "${EVENT_FOLLOW_ACTIVE:-}" == "1" ]]; then
    local request_pid tracked_request
    [[ ! -e "${EVENT_STOP_FILE:-}" ]] || { rm -f "$out" "$err" "$request_status_file" 2>/dev/null || true; return 1; }
    curl -sS -K - -o "$out" "${dump_header[@]}" -w '%{http_code}' -X "$method" "${headers[@]}" "$@" "${TIMDO_API}${path}" \
      >"$request_status_file" 2>"$err" <<<"header = \"$auth_header\"" &
    request_pid=$!
    if ! printf '%s\n' "$request_pid" > "$EVENT_REQUEST_PID_FILE"; then
      kill -TERM "$request_pid" 2>/dev/null || true
      wait "$request_pid" 2>/dev/null || true
      api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
      die "Error: could not track the active events request."
    fi
    if [[ "${EVENT_STOP:-}" == "1" || -e "${EVENT_STOP_FILE:-}" ]]; then
      kill -TERM "$request_pid" 2>/dev/null || true
    fi
    if wait "$request_pid"; then curl_status=0; else curl_status=$?; fi
    if [[ -r "$EVENT_REQUEST_PID_FILE" ]]; then
      IFS= read -r tracked_request < "$EVENT_REQUEST_PID_FILE" || true
      [[ "$tracked_request" != "$request_pid" ]] || rm -f "$EVENT_REQUEST_PID_FILE"
    fi
    if [[ "$curl_status" -ne 0 ]]; then
      if [[ "${EVENT_STOP:-}" == "1" ]]; then
        api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
        return 1
      fi
      if [[ "${EVENT_FOLLOW_ACTIVE:-}" == "1" ]]; then
        printf 'Error: could not reach the TimDo API at %s (%s)\n' "$TIMDO_API" "$(head -c 200 "$err" | tr '\n' ' ')" >&2
        api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
        return 1
      fi
      die "Error: could not reach the TimDo API at $TIMDO_API ($(head -c 200 "$err" | tr '\n' ' '))"
    fi
    code=$(<"$request_status_file")
    rm -f "$request_status_file" 2>/dev/null || true
  elif ! code=$(printf 'header = "%s"\n' "$auth_header" | curl -sS -K - -o "$out" "${dump_header[@]}" -w '%{http_code}' -X "$method" "${headers[@]}" "$@" "${TIMDO_API}${path}" 2>"$err"); then
    die "Error: could not reach the TimDo API at $TIMDO_API ($(head -c 200 "$err" | tr '\n' ' '))"
  fi
  if [[ "$code" -ge 400 ]]; then
    if [[ "${EVENT_FOLLOW_ACTIVE:-}" == "1" ]]; then
      if (api_error "$code" "$out"); then
        api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
        return 0
      else
        local api_error_status=$?
        api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
        return "$api_error_status"
      fi
    fi
    api_error "$code" "$out"
  fi
  if [[ "${API_CAPTURE_RESPONSE:-}" == "1" ]]; then
    local response_headers response response_status
    response_headers=$(response_headers_json "$header_file")
    if response=$(jq -cn --rawfile body "$out" --argjson headers "$response_headers" '{body:(try ($body | fromjson) catch $body), headers:$headers}'); then
      response_status=0
    else
      response_status=$?
    fi
    api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
    if [[ "$response_status" -ne 0 ]]; then return "$response_status"; fi
    printf '%s\n' "$response"
  else
    local output_status
    if cat "$out"; then output_status=0; else output_status=$?; fi
    api_cleanup_files "$out" "$err" "$request_status_file" "$header_file"
    return "$output_status"
  fi
}

# Cached GET for the lifetime of one command (each command makes few distinct reads)
api_cached() {
  local key f
  key=$(printf '%s|%s' "$TIMDO_AS" "$1" | md5sum | cut -c1-16)
  f="$TMPD/cache-$key"
  if [[ ! -f "$f" ]]; then
    api GET "$1" > "$f.tmp"
    mv "$f.tmp" "$f"
  fi
  cat "$f"
}

cache_clear() { rm -f "$TMPD"/cache-* 2>/dev/null || true; }

# Optional reads: an empty array (or object) when the endpoint fails, so older APIs still work
api_optional() {
  local fallback="${2:-[]}"
  ( api_cached "$1" ) 2>/dev/null || echo "$fallback"
}

# ---------------------------------------------------------------------------
# Lookups
# ---------------------------------------------------------------------------
me_json() { api_cached /users/me; }
my_id() { me_json | jq -r '.id'; }
all_tasks() { api_cached /projects; }
sharing_json() { api_cached /organisations/sharing; }
orgs_json() { api_cached /organisations; }

# resolve_task <id or prefix>: prints one task (TaskView) or exits with a clear message
resolve_task() {
  local q="$1"
  [[ -z "$q" ]] && die "Error: a task ID is needed."
  local matches count
  matches=$(all_tasks | jq --arg id "$q" '[.[] | select((.id // "") | startswith($id))]')
  count=$(echo "$matches" | jq 'length')
  if [[ "$count" -eq 1 ]]; then
    echo "$matches" | jq '.[0]'
    return
  fi
  if [[ "$count" -gt 1 ]]; then
    local exact
    exact=$(echo "$matches" | jq --arg id "$q" '[.[] | select(.id == $id)][0] // empty')
    if [[ -n "$exact" ]]; then echo "$exact"; return; fi
    {
      echo "Error: \"$q\" matches $count tasks. Use more characters of the ID:"
      echo "$matches" | jq -r '(.[0:10][] | "  \(.id[0:8])  \(.project)  [\(.projectName // .category // "")]"), (if length > 10 then "  ... and \(length - 10) more" else empty end)'
    } >&2
    exit 1
  fi
  if [[ "$q" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    api GET "/projects/$q"
    return
  fi
  local who="you"
  [[ -n "$TIMDO_AS" ]] && who="$TIMDO_AS"
  die "Not found: no task that $who can see has an ID starting \"$q\"."
}

resolve_task_id() { resolve_task "$1" | jq -r '.id'; }

# Resolve an epic identifier (ID prefix or exact/contained title) to an epic ID.
# Falls back to the input so a full ID the list does not show still works.
resolve_epic_id() {
  local input="$1"
  [[ -z "$input" ]] && { echo ""; return; }
  local epics_raw
  epics_raw=$(api_cached /epics)
  echo "$epics_raw" | jq -r --arg input "$input" '
    ($input | ascii_downcase) as $q
    | ([.[] | select(.id | startswith($input))][0].id)
      // ([.[] | select((.title // "") | ascii_downcase == $q)][0].id)
      // ([.[] | select((.title // "") | ascii_downcase | contains($q))][0].id)
      // $input'
}

resolve_goal_id() {
  local input="$1"
  [[ -z "$input" ]] && { echo ""; return; }
  local goals_raw
  goals_raw=$(api_cached /goals) || return $?
  echo "$goals_raw" | jq -r --arg input "$input" '
    ($input | ascii_downcase) as $q
    | ([.[] | select(.id | startswith($input))][0].id)
      // ([.[] | select((.title // "") | ascii_downcase == $q)][0].id)
      // ([.[] | select((.title // "") | ascii_downcase | contains($q))][0].id)
      // $input'
}

# resolve_org <name|id|id-prefix|slug|"personal">: prints the workspace from /organisations/sharing
resolve_org() {
  local q="$1"
  [[ -z "$q" ]] && die "Error: a workspace name is needed."
  local found
  found=$(sharing_json | jq --arg q "$q" '
    ($q | ascii_downcase) as $l
    | ([.[] | select(.id == $q)][0])
      // ([.[] | select(($l == "personal") and .isPersonal == true)][0])
      // ([.[] | select((.name // "") | ascii_downcase == $l)][0])
      // ([.[] | select((.slug // "") | ascii_downcase == $l)][0])
      // ([.[] | select(.id | startswith($q))][0])
      // (if ([.[] | select((.name // "") | ascii_downcase | contains($l))] | length) == 1
          then [.[] | select((.name // "") | ascii_downcase | contains($l))][0] else empty end)
      // empty')
  if [[ -z "$found" ]]; then
    local names
    names=$(sharing_json | jq -r '[.[].name] | join(", ")')
    die "Not found: no workspace called \"$q\". Your workspaces: $names"
  fi
  echo "$found"
}

# resolve_member <orgJson> <name|email|me>: prints {userId,userName,userEmail,role}
resolve_member() {
  local org="$1" q="$2"
  local found
  if [[ "$(lower "$q")" == "me" ]]; then
    found=$(echo "$org" | jq '[.members[] | select(.isMe == true)][0] // empty')
    if [[ -z "$found" ]]; then
      found=$(echo "$org" | jq --arg me "$(my_id)" '[.members[] | select(.userId == $me)][0] // empty')
    fi
  else
    found=$(echo "$org" | jq --arg q "$q" '
      ($q | ascii_downcase) as $l
      | [.members[] | . + {userName: (.userName // .name), userEmail: (.userEmail // .email)}] as $m
      | ([$m[] | select((.userEmail // "") | ascii_downcase == $l)])
        as $byEmail
      | if ($byEmail | length) > 0 then $byEmail[0]
        else
          ([$m[] | select(.userId == $q)])[0]
          // ([$m[] | select((.userName // "") | ascii_downcase == $l)])[0]
          // (([$m[] | select((.userName // "") | ascii_downcase | split(" ")[0] == $l)]) | if length == 1 then .[0] else empty end)
          // (([$m[] | select(((.userName // "") + " " + (.userEmail // "")) | ascii_downcase | contains($l))]) | if length == 1 then .[0] else empty end)
          // empty
        end')
  fi
  if [[ -z "$found" ]]; then
    local org_name members
    org_name=$(echo "$org" | jq -r '.name')
    members=$(echo "$org" | jq -r '[.members[] | "\(.userName // .name) <\(.userEmail // .email)>"] | join(", ")')
    die "Not found: nobody in \"$org_name\" matches \"$q\". Members: $members. To add someone: timdo workspace share \"$org_name\" <email>"
  fi
  echo "$found"
}

# resolve_user_anywhere <name|email|me|unassigned>: prints a user id for list filters
resolve_user_anywhere() {
  local q="$1" l
  l=$(lower "$q")
  case "$l" in
    me|mine) echo "me"; return ;;
    unassigned|none|nobody) echo "unassigned"; return ;;
    mine_or_unassigned|mine-or-unassigned) echo "mine_or_unassigned"; return ;;
  esac
  local everyone found count
  everyone=$(sharing_json | jq '[.[] | .members[]? | . + {userName: (.userName // .name), userEmail: (.userEmail // .email)}] | unique_by(.userId)')
  found=$(echo "$everyone" | jq --arg q "$q" '
    ($q | ascii_downcase) as $l
    | ([.[] | select(.userId == $q or ((.userEmail // "") | ascii_downcase) == $l or ((.userName // "") | ascii_downcase) == $l)])
      as $exact
    | if ($exact | length) > 0 then $exact
      else [.[] | select((((.userName // "") + " " + (.userEmail // "")) | ascii_downcase | contains($l)))] end')
  count=$(echo "$found" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    die "Not found: nobody in your workspaces matches \"$q\"."
  fi
  if [[ "$count" -gt 1 ]]; then
    die "Error: \"$q\" matches several people: $(echo "$found" | jq -r '[.[] | "\(.userName) <\(.userEmail)>"] | join(", ")'). Use their email."
  fi
  echo "$found" | jq -r '.[0].userId'
}

# resolve_project <id|KEY|name|"Workspace/Project"> [orgId]: prints {id,key,name,orgId,orgName,role,...}
resolve_project() {
  local q="$1" org_id="${2:-}"
  local found count
  found=$(sharing_json | jq --arg q "$q" --arg org "$org_id" '
    ($q | ascii_downcase) as $l
    | [.[] | . as $o | (.projects // [])[] | . + {orgId: $o.id, orgName: $o.name, role: $o.role, isPersonal: $o.isPersonal}]
    | map(select($org == "" or .orgId == $org)) as $all
    | ([$all[] | select(.id == $q)]) as $byId
    | if ($byId | length) > 0 then $byId
      else
        ([$all[] | select(((.orgName // "") + "/" + (.name // "")) | ascii_downcase == $l)]) as $byPath
        | if ($byPath | length) > 0 then $byPath
          else
            ([$all[] | select((.name // "") | ascii_downcase == $l)]) as $byName
            | if ($byName | length) > 0 then $byName
              else [$all[] | select((.key // "") | ascii_downcase == $l)] end
          end
      end')
  count=$(echo "$found" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    die "Not found: no project called \"$q\". See: timdo workspace list"
  fi
  if [[ "$count" -gt 1 ]]; then
    die "Error: \"$q\" matches several projects: $(echo "$found" | jq -r '[.[] | "\(.orgName)/\(.name)"] | join(", ")'). Use \"Workspace/Project\"."
  fi
  echo "$found" | jq '.[0]'
}

# ---------------------------------------------------------------------------
# Refs: links from a task to things outside TimDo (issues, posts, mail, member ids).
# Written as a URL or kind:id; the API parses both. See: timdo ref --help
# ---------------------------------------------------------------------------
REF_ROLE_ERROR="Role must be link, source, reported_by or about"

# normalise_role <role>: prints link|source|reported_by|about (the API accepts the same spellings)
normalise_role() {
  local r
  r=$(lower "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]-]+/_/g')
  case "$r" in
    "") echo "link" ;;
    link|source|reported_by|about) echo "$r" ;;
    *) die "Error: $REF_ROLE_ERROR, not \"$1\"." ;;
  esac
}

# need_value <flag> <value>: stop with a clear message when a flag has no value after it
need_value() {
  if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
    usage_die "Error: $1 needs a value (see: timdo ref --help)."
  fi
}

# ref_input <ref> <role> [label] [kind] [url]: one RefInput as JSON (empty fields left out)
ref_input() {
  jq -n --arg ref "$1" --arg role "$2" --arg label "${3:-}" --arg kind "${4:-}" --arg url "${5:-}" '
    {ref: $ref, role: $role}
    + (if $label == "" then {} else {label: $label} end)
    + (if $kind == "" then {} else {kind: $kind} end)
    + (if $url == "" then {} else {url: $url} end)'
}

# ref_role_for_flag <--ref|--source|--reported-by|--about>: the role a CLI flag stands for
ref_role_for_flag() {
  case "$1" in
    --source) echo "source" ;;
    --reported-by|--reported_by) echo "reported_by" ;;
    --about) echo "about" ;;
    *) echo "link" ;;
  esac
}

# refs_json_arg <json>: check a --refs-json value is an array of {ref, role?, label?, kind?, url?}
refs_json_arg() {
  echo "$1" | jq -e 'type == "array" and all(.[]; type == "object" and (.ref | type) == "string")' >/dev/null 2>&1 \
    || die "Error: --refs-json needs a JSON array like [{\"ref\":\"forum.post:4411\",\"role\":\"source\"}]."
  echo "$1" | jq -c '.'
}

# add_ref <task id> <RefInput json>: POST it; prints the RefView with "existing"
add_ref() {
  api POST "/tasks/$1/refs" -d "$2"
}

# remove_ref <task id> <url|kind:id|ref id> [role]: prints a JSON array of the refs removed.
# A hex string that starts a ref id on the task is taken as that id, anything else as a ref.
# With a ref id, a role that does not match that ref is an error rather than ignored.
remove_ref() {
  local task_id="$1" what="$2" role="${3:-}"
  local before after by_id=""
  before=$(api GET "/tasks/$task_id/refs")
  if [[ "$what" =~ ^[0-9a-fA-F-]{4,36}$ ]]; then
    by_id=$(echo "$before" | jq -r --arg p "$(lower "$what")" 'if any(.[]; .id | startswith($p)) then "yes" else "" end')
  fi
  ERR_HINT="See the task's links with: timdo ref list ${task_id:0:8}"
  if [[ -n "$by_id" && -n "$role" ]]; then
    # A ref id names one ref, so --role can only confirm it, never pick another
    local id_role
    id_role=$(echo "$before" | jq -r --arg p "$(lower "$what")" '[.[] | select(.id | startswith($p)) | .role] | unique | join(", ")')
    if [[ "$id_role" != "$role" ]]; then
      die "Error: ref $what is $id_role, not $role. Leave out --role to remove it."
    fi
  fi
  if [[ -n "$by_id" ]]; then
    api DELETE "/tasks/$task_id/refs/$(urlencode "$(lower "$what")")" >/dev/null
  else
    local q="ref=$(urlencode "$what")"
    [[ -n "$role" ]] && q="$q&role=$(urlencode "$role")"
    api DELETE "/tasks/$task_id/refs?$q" >/dev/null
  fi
  ERR_HINT=""
  after=$(api GET "/tasks/$task_id/refs")
  jq -n --argjson b "$before" --argjson a "$after" '($a | map(.id)) as $keep | [$b[] | select(.id as $i | $keep | index($i) | not)]'
}

usage_ref() {
  cat <<'EOF'
Usage: timdo ref <list|add|rm> <task id> ...      (alias: refs)

A ref links a task to something outside TimDo: a GitHub issue or PR, a forum post,
an email, a Gmail thread, an error report, a member of another system, any web page.
Paste a URL, or write it as kind:id. Kinds are lowercase and dotted, and you can
invent your own. Three examples:
  github.issue:acme/widgets#12     same as https://github.com/acme/widgets/issues/12
  forum.post:4411                  post 4411 on your forum
  acme.member:123456               member 123456 in the Acme system
Record people by their id in the other system, not by name or email.

Roles:
  link          Related material (the default)
  source        Where the task came from. A ref can be the source of only one task
                per workspace; a clash fails and names the task that has it.
  reported_by   An outside person or account who reported it (as many as you like)
  about         The outside person or thing the task concerns

Commands:
  ref list <task>                          Links on a task, grouped by role, with their ids
  ref add <task> <url|kind:id> [--role <role>] [--label "..."] [--kind <kind>] [--url <url>]
                                           Adding the same ref and role again changes nothing.
                                           --kind takes a bare id: ref add ea9f 123456 --kind acme.member
  ref rm <task> <url|kind:id|ref id> [--role <role>]
                                           Without --role, every role of that ref goes.

Elsewhere:
  add "Title" -p <project> --source <x> --reported-by <x> --about <x> --ref <x>   (each repeats)
  update <task> --ref <x> --source <x> --reported-by <x> --about <x> --unref <x>
  find <url|kind:id> [--role <role>]       Tasks carrying it, any status
  list do --ref <url|kind:id>              Combine with the usual list filters

Examples:
  timdo ref add 3f2a91c0 https://github.com/acme/widgets/issues/12
  timdo ref add 3f2a91c0 acme.member:123456 --role reported_by --label "Forum account"
  timdo ref rm 3f2a91c0 github.issue:acme/widgets#12
  timdo find forum.post:4411 --role source
EOF
}

cmd_ref() {
  local subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    ""|-h|--help|help) usage_ref; [[ -z "$subcmd" ]] && exit 1 || exit 0 ;;
    list|ls|add|rm|remove|delete) ;;
    *) usage_die "Unknown ref subcommand: $subcmd. Use list, add or rm (see: timdo ref --help)." ;;
  esac

  local id="" what="" role="" role_set=false label="" kind="" url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_ref; exit 0 ;;
      --role|-r) need_value "$1" "${2:-}"; role="$2"; role_set=true; shift 2 ;;
      --label|-l) need_value "$1" "${2:-}"; label="$2"; shift 2 ;;
      --kind|-k) need_value "$1" "${2:-}"; kind="$2"; shift 2 ;;
      --url) need_value "$1" "${2:-}"; url="$2"; shift 2 ;;
      -*) usage_die "Unknown option for ref $subcmd: $1 (see: timdo ref --help)" ;;
      *)
        if [[ -z "$id" ]]; then id="$1"
        elif [[ -z "$what" ]]; then what="$1"
        else usage_die "Unexpected argument: $1. One ref at a time; quote it if it has spaces."; fi
        shift ;;
    esac
  done
  [[ -z "$id" ]] && usage_die "Error: say which task, e.g. timdo ref $subcmd 3f2a91c0 ... (see: timdo ref --help)"
  if [[ "$subcmd" != list && "$subcmd" != ls && -z "$what" ]]; then
    usage_die "Error: say which ref: a URL or kind:id, e.g. timdo ref $subcmd $id github.issue:acme/widgets#12"
  fi
  if [[ "$role_set" == true ]]; then role=$(normalise_role "$role"); fi

  local task full_id title_note
  task=$(resolve_task "$id")
  full_id=$(echo "$task" | jq -r '.id')
  title_note=$(echo "$task" | jq -r '"\(.id[0:8]) \"\(.project)\""')

  case "$subcmd" in
    list|ls)
      local refs
      refs=$(api GET "/tasks/$full_id/refs")
      if ! is_text; then
        echo "$refs" | jq '.'
        return
      fi
      echo "$task" | jqt '"Links on \"\(.project)\"  " + (where | paint("cyan")) + "  (\($n))"' --argjson n "$(echo "$refs" | jq 'length')"
      if [[ "$(echo "$refs" | jq 'length')" -eq 0 ]]; then
        echo "  (none yet) Add one with: timdo ref add ${full_id:0:8} <url or kind:id>"
      else
        echo "$refs" | jqt '
          ref_width as $cw
          | ([maxlen(.createdByName // "" | first_name), 8] | max) as $bw
          | ("  " + ("ID" | pad(8)) + "  " + ("ROLE" | pad(11)) + "  " + ("REF" | pad($cw)) + "  " + ("ADDED BY" | pad($bw)) + "  LABEL AND URL" | paint("dim")),
            (sort_by(role_order) | .[]
              | "  " + ((.id // "")[0:8] | paint("dim")) + "  " + (.role | role_label | pad(11)) + "  " + ref_cell($cw)
                + "  " + (.createdByName // "" | first_name | pad($bw)) + "  " + ref_extra | sub(" +$"; ""))'
      fi
      ;;

    add)
      local body res
      body=$(ref_input "$what" "${role:-link}" "$label" "$kind" "$url")
      res=$(add_ref "$full_id" "$body")
      if text_out; then
        echo "$res" | jqt '
          (if .existing == true then "Already linked" else c("green") + "Linked" + c("reset") end)
          + " " + ref_canonical + (if .role != "link" then " (" + (.role | role_label | ascii_downcase) + ")" else "" end)
          + " " + (if .existing == true then "on" else "to" end) + " " + $t
          + (if .existing == true then ". Nothing changed." else "" end)' --arg t "$title_note"
      else
        echo "$res" | jq '.'
      fi
      ;;

    rm|remove|delete)
      local removed
      removed=$(remove_ref "$full_id" "$what" "$role")
      if text_out; then
        echo "$removed" | jqt '.[] | c("green") + "Removed" + c("reset") + " " + (.role | role_noun) + " " + ref_canonical + " from " + $t' --arg t "$title_note"
      else
        echo "$removed" | jq --arg id "$full_id" '{taskId: $id, removed: .}'
      fi
      ;;
  esac
}

usage_find() {
  cat <<'EOF'
Usage: timdo find <url|kind:id> [--role link|source|reported_by|about] [list options]
       (filters and --limit/--cursor/--group-by/--fields can go before or after the ref)

Tasks carrying that ref, in every workspace you can see, any status (done included).
Same as: timdo list all --ref <url|kind:id> [--ref-role <role>]

Examples:
  timdo find https://github.com/acme/widgets/issues/12 --limit 50
  timdo find forum.post:4411 --role source --cursor <cursor> --limit 50
  timdo --json find acme.member:123456 --role reported_by
EOF
}

cmd_find() {
  local what="" role="" rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_find; exit 0 ;;
      --role|-r|--ref-role) role="${2:-}"; [[ -z "$role" ]] && usage_die "Error: --role needs a value: link, source, reported_by or about."; shift 2 ;;
      # List options that take a value keep it, so it is never mistaken for the ref
      -p|--category|--project|--project-category|--project-id|-w|--workspace|--org|-e|--epic|-g|--goal|--customer|--tag|--related-to|--assignee|--unlinked|--limit|--cursor|--group-by|--fields|--status)
        need_value "$1" "${2:-}"; rest+=("$1" "$2"); shift 2 ;;
      -*) rest+=("$1"); shift ;;
      *) if [[ -z "$what" ]]; then what="$1"; else rest+=("$1"); fi; shift ;;
    esac
  done
  if [[ -z "$what" ]]; then
    usage_find >&2
    exit 1
  fi
  local args=(all --ref "$what")
  [[ -n "$role" ]] && args+=(--ref-role "$role")
  cmd_list "${args[@]}" ${rest[@]+"${rest[@]}"}
}

usage_similar() {
  cat <<'EOF'
Usage: timdo similar "Task title" [-p <project> | --project-id <id|KEY|path> | -w <workspace>]
                     [--limit <1-10>] [--exclude <task id>]

Open tasks that look like this title, best first, before you create it. Words like "the" and
"with" are ignored, and a title needs at least two other words to compare. Done and deleted
tasks never show.

  -p, --project <name>         Look in the workspace this project is in (as add -p would)
  --project-id <id|KEY|path>   Look in this project's workspace
  -w, --workspace <name>       Look in this workspace
                               Without any of these: every workspace you can see.
  --limit <n>                  How many (default 3, at most 10)
  --exclude <task id>          Leave this task out (e.g. the one you are editing)
  --title "..."                Give the title this way when it starts with a dash

If one is the same thing, add to it instead of creating a new task:
  timdo add-note 3f2a91c0 "Also seen on the checkout page"

Examples:
  timdo similar "Fix the offer page" -p "Acme Solar"
  timdo --json similar "Offer page broken" -w Acme --limit 5
EOF
}

cmd_similar() {
  local title="" category="" project_q="" workspace="" limit="" exclude=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_similar; exit 0 ;;
      -p|--project|--category) [[ -z "${2:-}" ]] && usage_die "Error: $1 needs a project name."; category="$2"; shift 2 ;;
      --project-id) [[ -z "${2:-}" ]] && usage_die "Error: --project-id needs a project id, key or \"Workspace/Project\"."; project_q="$2"; shift 2 ;;
      -w|--workspace|--org) [[ -z "${2:-}" ]] && usage_die "Error: $1 needs a workspace name."; workspace="$2"; shift 2 ;;
      --limit|-n)
        [[ "${2:-}" =~ ^[0-9]+$ && "${2:-0}" -ge 1 ]] || usage_die "Error: --limit needs a whole number from 1 to 10."
        limit="$2"; shift 2 ;;
      --exclude) [[ -z "${2:-}" ]] && usage_die "Error: --exclude needs a task id."; exclude="$2"; shift 2 ;;
      # --title (or everything after a second --) takes a title that starts with a dash
      --title|-t) [[ -z "${2:-}" ]] && usage_die "Error: --title needs the task title."; title="$2"; shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do title="${title:+$title }$1"; shift; done ;;
      -*) usage_die "Unknown option for similar: $1 (see: timdo similar --help)" ;;
      *) title="${title:+$title }$1"; shift ;;
    esac
  done
  if [[ -z "${title// /}" ]]; then
    usage_similar >&2
    exit 1
  fi

  local q project_id="" org_id=""
  [[ -n "$project_q" ]] && project_id=$(resolve_project "$project_q" | jq -r '.id')
  [[ -n "$workspace" && -z "$project_id" ]] && org_id=$(resolve_org "$workspace" | jq -r '.id')
  q=$(similar_query "$title" "$project_id" "$category" "$limit")
  [[ -n "$org_id" ]] && q+="&orgId=$(urlencode "$org_id")"
  [[ -n "$exclude" ]] && q+="&excludeId=$(urlencode "$(resolve_task_id "$exclude")")"

  local similar
  similar=$(api GET "/tasks/similar?$q")
  if ! is_text; then
    echo "$similar" | jq '.'
    return
  fi
  local count shown_title
  count=$(echo "$similar" | jq 'length')
  shown_title=$(jq -rn --arg t "$title" '$t | gsub("[\\p{Cc}]+"; " ")')
  if [[ "$count" -eq 0 ]]; then
    echo "No open tasks look like \"$shown_title\"."
    # Mirrors the API's rule loosely: under two words of 3+ letters there is nothing to compare
    local words
    words=$(printf '%s' "$title" | tr -cs '[:alnum:]' '\n' | awk 'length($0) >= 3' | wc -l)
    if [[ "$words" -lt 2 ]]; then
      echo "  A title needs at least two distinctive words to compare, e.g. \"offer page\"."
    fi
    return
  fi
  if [[ "$count" -eq 1 ]]; then
    echo "${B}1 open task looks like \"$shown_title\"${R}"
  else
    echo "${B}$count open tasks look like \"$shown_title\"${R}"
  fi
  echo "$similar" | jqt 'similar_lines(false; $me)' --arg me "$( (my_id) 2>/dev/null || true)"
  local editable read_only
  editable=$(echo "$similar" | jq '[.[] | select(.canEdit != false)] | length')
  read_only=$(echo "$similar" | jq '[.[] | select(.canEdit == false)] | length')
  if [[ "$editable" -gt 0 ]]; then
    echo 'For an editable match, add to it: timdo add-note <id> "..."'
  fi
  if [[ "$read_only" -gt 0 ]]; then
    echo 'A match marked "view only" cannot take a note or be merged by you.'
  fi
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
usage_list() {
  cat <<'EOF'
Usage: timdo list [all|do|delay|done|delegate|awaiting] [options]

Lists the tasks you can see in every workspace you belong to. Shared tasks
show their workspace/project and who they are assigned to.

Filters (applied by the server before counts or paging):
  -p, --project <name>        Project (category) name, e.g. Acme Solar
  --project-id <id|KEY>       One project by id or key (e.g. ASX)
  -w, --workspace <name>      One workspace, e.g. "Northstar Workshop" or personal
  -e, --epic <title|id>       Tasks in an epic
  -g, --goal <title|id>       Tasks linked to one of your life goals
  --customer <name>           Customer/company tag
  --tag <tag>                 Tag keyword
  --related-to <id>           Tasks linked to another task
  --mine                      Assigned to you (or unassigned and created by you)
  --unassigned                Nobody is assigned
  --assignee <who>            me, unassigned, mine_or_unassigned, a name or an email
  --shared                    Only tasks in shared workspaces
  --no-epic, --no-goal, --no-category
  --unlinked <epic|goal|category|any>
  --ref <url|kind:id>         Tasks carrying that ref, e.g. github.issue:acme/widgets#12
  --ref-role <role>           With --ref: only as link, source, reported_by or about

Page and presentation options:
  --limit <1-200>             Page size; omitted means the full legacy list
  --cursor <cursor>           Continue a page; requires --limit
  --fields <summary|full>     Choose body projection; omitted means full
  --group-by <project|epic|assignee>
                               Group the current page in text output only
  --status <status,...>       Filter one or more statuses when a comma-separated list is needed

Counts:
  timdo counts [status] [same membership filters]
  Counts returns all five status totals for the matching tasks.

Examples:
  timdo list do --mine
  timdo list do -w "Northstar Workshop" --assignee robin --limit 50 --fields summary
  timdo list all --ref https://github.com/acme/widgets/issues/12
  timdo list --status do,delay
  timdo counts --shared --no-epic
  timdo --json list awaiting
EOF
}

TASK_LIST_FILTER="all"
TASK_LIST_CATEGORY=""
TASK_LIST_PROJECT_ID=""
TASK_LIST_WORKSPACE=""
TASK_LIST_EPIC=""
TASK_LIST_GOAL=""
TASK_LIST_CUSTOMER=""
TASK_LIST_TAG=""
TASK_LIST_RELATED_TO=""
TASK_LIST_ASSIGNEE=""
TASK_LIST_SHARED=false
TASK_LIST_NO_EPIC=false
TASK_LIST_NO_GOAL=false
TASK_LIST_NO_CATEGORY=false
TASK_LIST_UNLINKED=""
TASK_LIST_REF=""
TASK_LIST_REF_ROLE=""
TASK_LIST_LIMIT=""
TASK_LIST_LIMIT_SET=false
TASK_LIST_CURSOR=""
TASK_LIST_CURSOR_SET=false
TASK_LIST_GROUP_BY=""
TASK_LIST_GROUP_BY_SET=false
TASK_LIST_FIELDS=""
TASK_LIST_FIELDS_SET=false

validate_task_status_filter() {
  local value="$1" item
  [[ -n "$value" ]] || usage_die "Error: status needs one or more of do, delay, awaiting, delegate or done."
  [[ "$value" == "all" ]] && return 0
  local -a statuses=()
  IFS=',' read -r -a statuses <<< "$value"
  for item in "${statuses[@]}"; do
    case "$item" in
      do|delay|awaiting|delegate|done) ;;
      *) usage_die "Error: invalid status '$item'. Use: do, delay, awaiting, delegate, done or all." ;;
    esac
  done
}

parse_task_list_args() {
  local mode="$1"
  shift
  TASK_LIST_FILTER="all"
  TASK_LIST_CATEGORY="" TASK_LIST_PROJECT_ID="" TASK_LIST_WORKSPACE=""
  TASK_LIST_EPIC="" TASK_LIST_GOAL="" TASK_LIST_CUSTOMER="" TASK_LIST_TAG=""
  TASK_LIST_RELATED_TO="" TASK_LIST_ASSIGNEE="" TASK_LIST_SHARED=false
  TASK_LIST_NO_EPIC=false TASK_LIST_NO_GOAL=false TASK_LIST_NO_CATEGORY=false TASK_LIST_UNLINKED=""
  TASK_LIST_REF="" TASK_LIST_REF_ROLE="" TASK_LIST_LIMIT="" TASK_LIST_LIMIT_SET=false
  TASK_LIST_CURSOR="" TASK_LIST_CURSOR_SET=false TASK_LIST_GROUP_BY="" TASK_LIST_GROUP_BY_SET=false
  TASK_LIST_FIELDS="" TASK_LIST_FIELDS_SET=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        if [[ "$mode" == "counts" ]]; then usage_counts; else usage_list; fi
        exit 0 ;;
      -p|--category|--project|--project-category)
        need_value "$1" "${2:-}"; TASK_LIST_CATEGORY="$2"; shift 2 ;;
      --project-id)
        need_value "$1" "${2:-}"; TASK_LIST_PROJECT_ID="$2"; shift 2 ;;
      -w|--workspace|--org)
        need_value "$1" "${2:-}"; TASK_LIST_WORKSPACE="$2"; shift 2 ;;
      -e|--epic)
        need_value "$1" "${2:-}"; TASK_LIST_EPIC="$2"; shift 2 ;;
      -g|--goal)
        need_value "$1" "${2:-}"; TASK_LIST_GOAL="$2"; shift 2 ;;
      --customer)
        need_value "$1" "${2:-}"; TASK_LIST_CUSTOMER="$2"; shift 2 ;;
      --tag)
        need_value "$1" "${2:-}"; TASK_LIST_TAG="$2"; shift 2 ;;
      --related-to)
        need_value "$1" "${2:-}"; TASK_LIST_RELATED_TO="$2"; shift 2 ;;
      --mine) TASK_LIST_ASSIGNEE="me"; shift ;;
      --unassigned) TASK_LIST_ASSIGNEE="unassigned"; shift ;;
      --assignee)
        need_value "$1" "${2:-}"; TASK_LIST_ASSIGNEE="$2"; shift 2 ;;
      --shared) TASK_LIST_SHARED=true; shift ;;
      --no-epic) TASK_LIST_NO_EPIC=true; shift ;;
      --no-goal) TASK_LIST_NO_GOAL=true; shift ;;
      --no-category|--no-cat) TASK_LIST_NO_CATEGORY=true; shift ;;
      --unlinked)
        need_value "$1" "${2:-}"; TASK_LIST_UNLINKED="$2"; shift 2 ;;
      --ref)
        need_value "$1" "${2:-}"; TASK_LIST_REF="$2"; shift 2 ;;
      --ref-role)
        need_value "$1" "${2:-}"; TASK_LIST_REF_ROLE=$(normalise_role "$2"); shift 2 ;;
      --status)
        need_value "$1" "${2:-}"; TASK_LIST_FILTER="$2"; shift 2 ;;
      --status=*) TASK_LIST_FILTER="${1#*=}"; shift ;;
      --limit)
        [[ "$mode" == "list" ]] || usage_die "Error: --limit does not apply to counts."
        need_value "$1" "${2:-}"; TASK_LIST_LIMIT="$2"; TASK_LIST_LIMIT_SET=true; shift 2 ;;
      --limit=*)
        [[ "$mode" == "list" ]] || usage_die "Error: --limit does not apply to counts."
        TASK_LIST_LIMIT="${1#*=}"; TASK_LIST_LIMIT_SET=true; shift ;;
      --cursor)
        [[ "$mode" == "list" ]] || usage_die "Error: --cursor does not apply to counts."
        need_value "$1" "${2:-}"; TASK_LIST_CURSOR="$2"; TASK_LIST_CURSOR_SET=true; shift 2 ;;
      --cursor=*)
        [[ "$mode" == "list" ]] || usage_die "Error: --cursor does not apply to counts."
        TASK_LIST_CURSOR="${1#*=}"; TASK_LIST_CURSOR_SET=true; shift ;;
      --group-by)
        [[ "$mode" == "list" ]] || usage_die "Error: --group-by does not apply to counts."
        need_value "$1" "${2:-}"; TASK_LIST_GROUP_BY="$2"; TASK_LIST_GROUP_BY_SET=true; shift 2 ;;
      --group-by=*)
        [[ "$mode" == "list" ]] || usage_die "Error: --group-by does not apply to counts."
        TASK_LIST_GROUP_BY="${1#*=}"; TASK_LIST_GROUP_BY_SET=true; shift ;;
      --fields)
        [[ "$mode" == "list" ]] || usage_die "Error: --fields does not apply to counts."
        need_value "$1" "${2:-}"; TASK_LIST_FIELDS="$2"; TASK_LIST_FIELDS_SET=true; shift 2 ;;
      --fields=*)
        [[ "$mode" == "list" ]] || usage_die "Error: --fields does not apply to counts."
        TASK_LIST_FIELDS="${1#*=}"; TASK_LIST_FIELDS_SET=true; shift ;;
      do|delay|done|delegate|awaiting|all)
        TASK_LIST_FILTER="$1"; shift ;;
      *) usage_die "Unknown option for $mode: $1 (see: timdo $mode --help)" ;;
    esac
  done

  validate_task_status_filter "$TASK_LIST_FILTER"
  if [[ "$TASK_LIST_LIMIT_SET" == true ]]; then
    [[ "$TASK_LIST_LIMIT" =~ ^[0-9]{1,3}$ ]] || usage_die "Error: --limit must be a whole number from 1 to 200."
    local page_limit=$((10#$TASK_LIST_LIMIT))
    (( page_limit >= 1 && page_limit <= 200 )) || usage_die "Error: --limit must be a whole number from 1 to 200."
    TASK_LIST_LIMIT="$page_limit"
  fi
  if [[ "$TASK_LIST_CURSOR_SET" == true ]]; then
    [[ "$TASK_LIST_LIMIT_SET" == true ]] || usage_die "Error: --cursor requires --limit."
    if [[ -z "$TASK_LIST_CURSOR" || ${#TASK_LIST_CURSOR} -gt 4096 || ! "$TASK_LIST_CURSOR" =~ ^[A-Za-z0-9_-]+$ ]]; then
      usage_die "Error: --cursor must be a URL-safe cursor of at most 4096 characters."
    fi
  fi
  if [[ "$TASK_LIST_GROUP_BY_SET" == true ]]; then
    case "$TASK_LIST_GROUP_BY" in project|epic|assignee) ;; *) usage_die "Error: --group-by must be project, epic or assignee." ;; esac
  fi
  if [[ "$TASK_LIST_FIELDS_SET" == true ]]; then
    case "$TASK_LIST_FIELDS" in summary|full) ;; *) usage_die "Error: --fields must be summary or full." ;; esac
  fi
  if [[ -n "$TASK_LIST_REF_ROLE" && -z "$TASK_LIST_REF" ]]; then
    usage_die "Error: --ref-role only works with --ref <url|kind:id>."
  fi
}

build_task_list_path() {
  local endpoint="$1"
  local params=()
  [[ "$TASK_LIST_FILTER" != "all" ]] && params+=("status=$(urlencode "$TASK_LIST_FILTER")")
  [[ -n "$TASK_LIST_CATEGORY" ]] && params+=("category=$(urlencode "$TASK_LIST_CATEGORY")")
  if [[ -n "$TASK_LIST_PROJECT_ID" ]]; then
    params+=("projectId=$(urlencode "$(resolve_project "$TASK_LIST_PROJECT_ID" | jq -r '.id')")")
  fi
  if [[ -n "$TASK_LIST_WORKSPACE" ]]; then
    params+=("orgId=$(urlencode "$(resolve_org "$TASK_LIST_WORKSPACE" | jq -r '.id')")")
  fi
  [[ -n "$TASK_LIST_EPIC" ]] && params+=("epicId=$(urlencode "$(resolve_epic_id "$TASK_LIST_EPIC")")")
  [[ -n "$TASK_LIST_GOAL" ]] && params+=("goalId=$(urlencode "$(resolve_goal_id "$TASK_LIST_GOAL")")")
  [[ -n "$TASK_LIST_CUSTOMER" ]] && params+=("customer=$(urlencode "$TASK_LIST_CUSTOMER")")
  [[ -n "$TASK_LIST_TAG" ]] && params+=("tag=$(urlencode "$TASK_LIST_TAG")")
  [[ -n "$TASK_LIST_RELATED_TO" ]] && params+=("relatedTo=$(urlencode "$TASK_LIST_RELATED_TO")")
  [[ -n "$TASK_LIST_ASSIGNEE" ]] && params+=("assignee=$(urlencode "$(resolve_user_anywhere "$TASK_LIST_ASSIGNEE")")")
  [[ -n "$TASK_LIST_REF" ]] && params+=("ref=$(urlencode "$TASK_LIST_REF")")
  [[ -n "$TASK_LIST_REF_ROLE" ]] && params+=("role=$(urlencode "$TASK_LIST_REF_ROLE")")
  [[ "$TASK_LIST_SHARED" == true ]] && params+=("shared=true")
  [[ "$TASK_LIST_NO_EPIC" == true ]] && params+=("noEpic=true")
  [[ "$TASK_LIST_NO_GOAL" == true ]] && params+=("noGoal=true")
  [[ "$TASK_LIST_NO_CATEGORY" == true ]] && params+=("noCategory=true")
  [[ -n "$TASK_LIST_UNLINKED" ]] && params+=("unlinked=$(urlencode "$TASK_LIST_UNLINKED")")
  if [[ "$endpoint" == "/projects" ]]; then
    [[ "$TASK_LIST_LIMIT_SET" == true ]] && params+=("limit=$TASK_LIST_LIMIT")
    [[ "$TASK_LIST_CURSOR_SET" == true ]] && params+=("cursor=$(urlencode "$TASK_LIST_CURSOR")")
    [[ -n "$TASK_LIST_FIELDS" ]] && params+=("fields=$(urlencode "$TASK_LIST_FIELDS")")
  fi
  if [[ ${#params[@]} -eq 0 ]]; then
    printf '%s' "$endpoint"
  else
    printf '%s?%s' "$endpoint" "$(IFS='&'; printf '%s' "${params[*]}")"
  fi
}

filter_unpaged_tasks() {
  jq --arg filter "$TASK_LIST_FILTER" \
    --argjson shared "$TASK_LIST_SHARED" --argjson noEpic "$TASK_LIST_NO_EPIC" \
    --argjson noGoal "$TASK_LIST_NO_GOAL" --argjson noCategory "$TASK_LIST_NO_CATEGORY" \
    --arg unlinked "$TASK_LIST_UNLINKED" '
    def blank: . == null or . == "";
    ($filter | split(",")) as $statuses
    | [ .[]
        | select(.isDeleted != true)
        | select($filter == "all" or (.status as $status | $statuses | index($status) != null))
        | select(($shared | not) or .isShared == true)
        | select((($noEpic or $unlinked == "epic") | not) or (.epicId | blank))
        | select((($noGoal or $unlinked == "goal") | not) or (.goalId | blank))
        | select((($noCategory or $unlinked == "category") | not) or (.category | blank))
        | select($unlinked != "any" or (.epicId | blank) or (.goalId | blank) or (.category | blank))
      ]
    | if $filter == "awaiting" then sort_by(.awaitUntil // "9999") else sort_by(-.priority) end'
}

cmd_list() {
  parse_task_list_args list "$@"
  local path response raw selected total="" next_cursor="" count
  path=$(build_task_list_path /projects)
  if [[ "$TASK_LIST_LIMIT_SET" == true ]]; then
    response=$(api_response GET "$path")
    raw=$(jq -c '.body' <<< "$response")
    total=$(jq -r '.headers.totalCount // empty' <<< "$response")
    next_cursor=$(jq -r '.headers.nextCursor // empty' <<< "$response")
  else
    raw=$(api GET "$path")
  fi
  jq -e 'type == "array"' >/dev/null <<< "$raw" || die "Error: the task list response was not an array."
  selected="$raw"
  if [[ "$TASK_LIST_LIMIT_SET" == false ]]; then
    selected=$(filter_unpaged_tasks <<< "$raw")
  fi
  count=$(jq 'length' <<< "$selected")

  if ! is_text; then
    if [[ "$TASK_LIST_LIMIT_SET" == true ]]; then
      jq -c --arg total "$total" --arg cursor "$next_cursor" '{items:., nextCursor:(if $cursor == "" then null else $cursor end), total:(try ($total | tonumber) catch null)}' <<< "$selected"
    else
      jq '.' <<< "$selected"
    fi
    return
  fi

  if [[ "$TASK_LIST_LIMIT_SET" == true ]]; then
    printf 'Page: %s task(s)' "$count"
    [[ -n "$total" ]] && printf ' of %s total' "$total"
    printf '.\n'
    [[ -n "$next_cursor" ]] && printf 'Next cursor: %s\n' "$next_cursor"
  fi
  if [[ "$TASK_LIST_LIMIT_SET" == false && -t 1 && "$count" -gt 200 ]]; then
    echo "Tip: this is the full list. Narrow it with status and other filters, or use --limit 50 to page through results." >&2
  fi
  if [[ "$count" -eq 0 ]]; then
    if [[ -n "$TASK_LIST_REF" ]]; then
      local note=""
      [[ -n "$TASK_LIST_REF_ROLE" ]] && note=" as $TASK_LIST_REF_ROLE"
      [[ "$TASK_LIST_FILTER" != all ]] && note="$note with status $TASK_LIST_FILTER"
      echo "No task you can see carries $TASK_LIST_REF$note."
    else
      echo "No tasks found."
    fi
    return
  fi

  if [[ -n "$TASK_LIST_GROUP_BY" ]]; then
    echo "$selected" | jqt '
      task_widths as $w
      | map(. + {_groupKey: task_group_key($by), _groupLabel: task_group_label($by)})
      | group_by(._groupKey)
      | sort_by([if .[0]._groupKey == "" then 1 else 0 end, (.[0]._groupLabel | ascii_downcase)])
      | .[]
      | ("", ((.[0]._groupLabel | safe) + " (\(length))" | paint("bold"))),
        (sort_by(-.priority) | .[] | task_line($w))' --arg by "$TASK_LIST_GROUP_BY"
  elif [[ "$TASK_LIST_FILTER" == "all" ]]; then
    echo "$selected" | jqt '
      task_widths as $w
      | group_by(.status) | sort_by(.[0].status | status_order) | .[]
      | ("", ("\(.[0].status | ascii_upcase) (\(length))" | paint("bold"))),
        (sort_by(-.priority) | .[] | task_line($w))'
  else
    echo "$selected" | jqt 'task_widths as $w | .[] | task_line($w)'
  fi
}

usage_counts() {
  cat <<'EOF'
Usage: timdo counts [all|do|delay|done|delegate|awaiting] [membership filters]

Show SQL-aggregated task totals for the same filters as `timdo list`. All five
status keys are returned, including zeroes. Paging and presentation options do
not apply to counts.

Examples:
  timdo counts
  timdo counts do --mine
  timdo counts --shared --no-epic --customer "Fictional Workshop"
EOF
}

cmd_counts() {
  parse_task_list_args counts "$@"
  local path raw
  path=$(build_task_list_path /projects/counts)
  raw=$(api GET "$path")
  if ! is_text; then
    jq '.' <<< "$raw"
    return
  fi
  jq -e 'type == "object" and (.byStatus | type == "object") and (.total | type == "number")' >/dev/null <<< "$raw" \
    || die "Error: the task counts response was not valid."
  echo "$raw" | jqt '
    ("Matching tasks: \(.total)" | paint("bold")),
    (["do", "delay", "awaiting", "delegate", "done"][] as $status
      | "  " + ($status | ascii_upcase | pad(9)) + " " + ((.byStatus[$status] // 0) | tostring))'
}

# ---------------------------------------------------------------------------
# get
# ---------------------------------------------------------------------------
cmd_get() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == "-h" || "$id" == "--help" ]]; then
    echo "Usage: timdo get <id>   Show a task with its workspace, project, people, links, notes and activity"
    [[ -z "$id" ]] && exit 1 || exit 0
  fi
  local task full_id
  task=$(resolve_task "$id")
  full_id=$(echo "$task" | jq -r '.id')

  local updates linked activity
  updates=$(api GET "/projects/$full_id/updates")
  linked=$( (api GET "/tasks/$full_id" 2>/dev/null || echo '{}') | jq '.linkedTasks // []')
  activity=$( (api GET "/activity?taskId=$(urlencode "$full_id")&limit=10" 2>/dev/null) || echo '[]')

  if ! is_text; then
    echo "$task" | jq --argjson updates "$updates" --argjson linked "$linked" --argjson activity "$activity" \
      '. + {updates: $updates, linkedTasks: $linked, activity: $activity}'
    return
  fi

  local epic_title="" goal_title=""
  local epic_id goal_id
  epic_id=$(echo "$task" | jq -r '.epicId // empty')
  goal_id=$(echo "$task" | jq -r '.goalId // empty')
  if [[ -n "$epic_id" ]]; then
    epic_title=$( (api GET "/epics/$epic_id" 2>/dev/null || echo '{}') | jq -r '.title // empty')
  fi
  if [[ -n "$goal_id" ]]; then
    goal_title=$(api_optional /goals | jq -r --arg g "$goal_id" '[.[] | select(.id == $g)][0].title // empty')
  fi

  echo "$task" | jqt '
    def row($k; $v): if ($v // "") == "" then empty else "  " + ($k | pad(15) | paint("dim")) + ($v | tostring | gsub("\n"; "\n" + (" " * 17))) end;
    (("[\(.priority)] " + .project) | paint("bold")),
    row("ID:"; .id),
    row("Status:"; .status + (if .status == "awaiting" then " until \(.awaitUntil // "no date")" else "" end) + "   size \(.size // "?")"),
    row("Workspace:"; (.orgName // "") + (if .isShared == true then "  (shared, your role: \(.myRole // "?"))" else (if .orgName then "  (personal)" else "" end) end)),
    row("Project:"; (.projectName // .category // "") + (if .projectKey then " (\(.projectKey))" else "" end)),
    row("Epic:"; if .epicId then (if $epic != "" then "\($epic) (\(.epicId[0:8]))" else .epicId end) else "" end),
    row("Life goal:"; if .goalId then (if $goal != "" then "\($goal) (\(.goalId[0:8]))" else .goalId end) else "" end),
    row("Assignee:"; if .assigneeId == null then "unassigned" else ((.assigneeName // .assigneeId) + (if .assigneeKind == "bot" then " [bot]" else "" end)) + (if .isMine == true then " (you)" else "" end) end),
    row("Created by:"; (((.reporterName // "") + (if .reporterKind == "bot" then " [bot]" else "" end)) + "  " + (.createdAt | long_dt)) | sub("^ +"; "")),
    row("Last updated:"; (((.updatedByName // "") + (if .updatedByKind == "bot" then " [bot]" else "" end)) + "  " + (.updatedAt | long_dt)) | sub("^ +"; "")),
    row("Access:"; if .canEdit == false then "view only" else "" end),
    row("Customer:"; .customer),
    row("Tags:"; .tags),
    row("Why:"; .reason),
    row("Gmail thread:"; .gmailThreadId as $g | if any((.refs // [])[]; .kind == "gmail.thread" and .ref == $g) then "" else $g end),
    row("Notes:"; .notes)
  ' --arg epic "$epic_title" --arg goal "$goal_title"

  # Links to things outside TimDo, grouped by role (Source, About, Reported by, Link)
  local refs
  refs=$(echo "$task" | jq '.refs // []')
  if [[ "$(echo "$refs" | jq 'length')" -gt 0 ]]; then
    echo ""
    echo "${B}Links ($(echo "$refs" | jq 'length'))${R}"
    echo "$refs" | jqt '
      ref_width as $cw
      | sort_by(role_order) | group_by(role_order) | .[]
      | if length > 3
        then (.[0:2][] | ref_line($cw)),
             ("  " + (.[0].role | role_label | pad(11)) + "  " + ("... and \(length - 2) more: timdo ref list \($id)" | paint("dim")))
        else .[] | ref_line($cw) end' --arg id "${full_id:0:8}"
  fi

  if [[ "$(echo "$linked" | jq 'length')" -gt 0 ]]; then
    echo ""
    echo "${B}Linked tasks ($(echo "$linked" | jq 'length'))${R}"
    echo "$linked" | jq -r '.[] | "  \(.relationType | . + (" " * ([12 - length, 0] | max)))  \(.shortId)  (\(.status), P\(.priority))  \(.title)"'
  fi

  echo ""
  echo "${B}Notes ($(echo "$updates" | jq 'length'))${R}"
  if [[ "$(echo "$updates" | jq 'length')" -eq 0 ]]; then
    echo "  (none yet)"
  else
    echo "$updates" | jqt 'sort_by(.createdAt) | note_lines'
  fi

  if [[ "$(echo "$activity" | jq 'length')" -gt 0 ]]; then
    echo ""
    echo "${B}Recent activity${R}"
    echo "$activity" | jqt 'activity_lines'
  fi
}

# ---------------------------------------------------------------------------
# add / update
# ---------------------------------------------------------------------------
usage_add() {
  cat <<'EOF'
Usage: timdo add "Task title" -p <project> [options]

  --title "..."                Give the title this way when it starts with a dash
  -p, --project <name>         Project/category name. Mandatory unless --project-id is given.
                               Existing writable project. Humans can use a new name to create a
                               project in their personal workspace. Bots must use an existing
                               writable project in their home workspace.
  --project-id <id|KEY|path>   Exact project, e.g. ASX or "Northstar Workshop/Acme Solar"
  --assign <who>               Humans default to me; bots default to unassigned.
                               Use none or a human workspace member; bots cannot be assigned.
  -e, --epic <title|id>        Epic
  -g, --goal <title|id>        Human-only: one of your private life goals; bots cannot have life goals.
  -r, --reason "..."           Why it matters
  -s, --status <status>        do (default), delay, delegate, awaiting, done
  --priority <1-10>            Default 5
  --size <* to *****>          Default ***
  -n, --notes "..."            Notes or next step
  --await-until YYYY-MM-DD     Return date (needs --status awaiting)
  --thread <threadId>          Gmail thread
  --customer <name>            Customer/company tag
  --tags <a,b>                 Comma-separated tags

Links to things outside TimDo (each flag repeats; a URL or kind:id, see: timdo ref --help):
  --ref <x>                    Related material, e.g. https://github.com/acme/widgets/issues/88
  --source <x>                 Where the task came from, e.g. forum.post:4411. Only one task per
                               workspace can have a given source; --on-duplicate says what happens
                               when another task already has it.
  --reported-by <x>            Who reported it, by their id in the other system, e.g. acme.member:123456
  --about <x>                  The outside person or thing it concerns
  --refs-json '<json>'         For scripts: [{"ref":"123456","kind":"acme.member","role":"reported_by","label":"..."}]
Record people by their id in the other system, not by name or email.

Duplicates:
  --on-duplicate <mode>        When the --source is already tracked by another task:
                                 error   (default) create nothing, fail and name that task
                                 return  create nothing, print that task, exit 0
                                 report  add this request's links and a "Reported again" note to
                                         that task, print it, exit 0. Repeats add nothing twice.
                               Retries with return or report are safe: one outside item, one task.
  -y, --yes                    Don't ask about similar tasks

On a terminal, add first looks for open tasks with a similar title and asks:
  Create anyway? [y]es / [n]o / [1-3] add as a note to that task:
(the default is no; a note carries the title, reason and notes you gave). With --yes, --json,
or when piped, it never asks: it creates the task and lists similar ones on stderr, as
  Similar open task: 3f2a91c0 "Broken offer page" (Acme Solar)
Check without creating: timdo similar "Title" -p <project>

Examples:
  timdo add "Broken offer page" -p "Acme Solar" --source forum.post:4411 \
        --reported-by acme.member:123456 --ref https://github.com/acme/widgets/issues/88
  timdo add "Offer page shows no prices" -p "Acme Solar" --source forum.post:4412 \
        --reported-by acme.member:123456 --on-duplicate report
EOF
}

# similar_query <title> <projectId> <category> [limit]: the query string for GET /tasks/similar
similar_query() {
  local q="title=$(urlencode "$1")"
  if [[ -n "$2" ]]; then q+="&projectId=$(urlencode "$2")"
  elif [[ -n "$3" ]]; then q+="&category=$(urlencode "$3")"; fi
  [[ -n "${4:-}" ]] && q+="&limit=$4"
  echo "$q"
}

# note_instead <task json> <title> <reason> <notes> <thread> <refs json>: the person said the task
# they were adding is already there, so put what they typed on it as a note (and add any links).
note_instead() {
  local task="$1" title="$2" reason="$3" notes="$4" thread="$5" refs="$6"
  local full_id title_note note body result author
  full_id=$(echo "$task" | jq -r '.id')
  title_note=$(echo "$task" | jqt '"\(.id[0:8]) \"\(.title // .project | oneline | safe)\""')
  note="$title"
  [[ -n "$reason" ]] && note+=$'\n'"$reason"
  [[ -n "$notes" ]] && note+=$'\n'"$notes"
  body=$(jq -n --arg note "$note" --arg t "$thread" '{note: $note, gmailThreadId: (if $t == "" then null else $t end)}')
  result=$(api POST "/projects/$full_id/updates" -d "$body")
  author=$(echo "$result" | jqt 'note_author')

  local ref_lines="" ref_failed=0 total i added
  total=$(echo "$refs" | jq 'length')
  for i in $(seq 0 $((total - 1))); do
    if added=$(add_ref "$full_id" "$(echo "$refs" | jq -c ".[$i]")"); then
      ref_lines+="$(echo "$added" | jqt 'ref_done_line')"$'\n'
    else
      ref_failed=$((ref_failed + 1))
    fi
  done

  if text_out; then
    echo "${GRN}Noted${R} on $title_note as $author. Nothing new was created."
    if [[ -n "$ref_lines" ]]; then printf '%s' "$ref_lines"; fi
  else
    echo "$result" | jq --arg id "$full_id" '. + {created: false, taskId: $id}'
  fi
  if [[ "$ref_failed" -gt 0 ]]; then
    die "Error: $ref_failed of $total links could not be added to ${full_id:0:8} (see above). The note was saved. Do not repeat the add or note request; retry only failed refs with: timdo ref add ${full_id:0:8} <url-or-kind:id> [--role <role>]."
  fi
}

# print_similar_hints <create response> <new id> <ids already shown>: similar-task hints on stderr for scripts and non-interactive users
print_similar_hints() {
  local created="$1" new_id="$2" shown="${3:-[]}" hints
  hints=$(echo "$created" | jq -c --argjson shown "$shown" \
    '[(.similar // [])[] | select(.id as $i | ($shown | index($i)) == null)]')
  [[ "$(echo "$hints" | jq 'length')" -eq 0 ]] && return 0
  local editable read_only
  editable=$(echo "$hints" | jq '[.[] | select(.canEdit != false)] | length')
  read_only=$(echo "$hints" | jq '[.[] | select(.canEdit == false)] | length')
  {
    echo "$hints" | jqt '.[] | similar_hint'
    if [[ "$editable" -gt 0 ]]; then
      echo "  Similarity is a suggestion, not proof of a duplicate. Review both tasks and get the user's explicit confirmation of the exact source and target before merging."
      if [[ "$(echo "$hints" | jq 'length')" -eq 1 ]]; then
        echo "  After that, run: timdo merge ${new_id:0:8} $(echo "$hints" | jq -r '.[0] | .shortId // .id[0:8]')"
      else
        echo "  After that, run: timdo merge ${new_id:0:8} <target-id>"
      fi
    fi
    if [[ "$read_only" -gt 0 ]]; then
      echo '  A match marked "view only" cannot take a note or be merged by you.'
    fi
  } >&2
}

# Resolve an assignee query for a project in a workspace. Prints a user id or "null".
assignee_for_org() {
  local org_id="$1" q="$2" l
  l=$(lower "$q")
  case "$l" in
    none|nobody|unassigned|null) echo "null"; return ;;
  esac
  local org
  org=$(sharing_json | jq --arg id "$org_id" '[.[] | select(.id == $id)][0] // empty')
  if [[ -z "$org" ]]; then
    if [[ "$l" == "me" ]]; then my_id; return; fi
    die "Not found: could not load the members of that workspace to assign \"$q\"."
  fi
  resolve_member "$org" "$q" | jq -r '.userId'
}

# Find the workspace a category name will land in when written (editable match first, else personal)
org_for_category() {
  local category="$1"
  sharing_json | jq -r --arg c "$category" '
    ($c | ascii_downcase) as $l
    | [.[] | . as $o | (.projects // [])[] | select((.name // "") | ascii_downcase == $l) | {orgId: $o.id, role: $o.role}]
    | (map(select(.role != "viewer"))[0].orgId) // (.[0].orgId) // empty'
}

personal_org_id() {
  sharing_json | jq -r '[.[] | select(.isPersonal == true)][0].id // empty'
}

describe_task() {
  # One-line summary of a task for confirmations
  jqt '"\((.id // "")[0:8])  \"\(.project)\"  " + (where | paint("cyan"))
    + (if .assigneeId == null then "  unassigned" else "  assigned to \(.assigneeName // .assigneeId)" end)
    + "  [\(.status), P\(.priority), \(.size)]"'
}

cmd_add() {
  local project="" reason="" status="do" priority=5 size="***" notes="" awaitUntil="" gmailThreadId=""
  local category="" project_id="" epic="" goal="" assign="" assign_set=false customer="" tags=""
  local refs="[]" extra_refs="" on_duplicate="" assume_yes=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_add; exit 0 ;;
      -y|--yes) assume_yes=true; shift ;;
      --on-duplicate|--on-dup)
        [[ -z "${2:-}" || "${2:-}" == -* ]] && usage_die "Error: $1 needs a mode: error, return or report (see: timdo add --help)."
        on_duplicate=$(lower "$2")
        case "$on_duplicate" in
          error|return|report) ;;
          *) usage_die "Error: --on-duplicate must be error, return or report, not \"$2\" (see: timdo add --help)." ;;
        esac
        shift 2 ;;
      --on-duplicate=*|--on-dup=*)
        on_duplicate=$(lower "${1#*=}")
        case "$on_duplicate" in
          error|return|report) ;;
          *) usage_die "Error: --on-duplicate must be error, return or report, not \"${1#*=}\" (see: timdo add --help)." ;;
        esac
        shift ;;
      --link|--unlink)
        usage_die "Unknown option: $1. To link two tasks use: timdo ${1#--} <task> <task>. For links to things outside TimDo see: timdo ref --help" ;;
      --ref|--source|--reported-by|--reported_by|--about)
        [[ -z "${2:-}" ]] && usage_die "Error: $1 needs a URL or kind:id, e.g. $1 forum.post:4411"
        refs=$(echo "$refs" | jq --argjson r "$(ref_input "$2" "$(ref_role_for_flag "$1")")" '. + [$r]'); shift 2 ;;
      --refs-json)
        extra_refs=$(refs_json_arg "${2:-}")
        refs=$(echo "$refs" | jq --argjson r "$extra_refs" '. + $r'); shift 2 ;;
      --title)
        [[ -z "${2:-}" ]] && usage_die "Error: --title needs the task title."
        project="$2"; shift 2 ;;
      --reason|-r) reason="$2"; shift 2 ;;
      --status|-s) status="$2"; shift 2 ;;
      --priority) priority="$2"; shift 2 ;;
      -p|--category|--project) category="$2"; shift 2 ;;
      --project-id) project_id="$2"; shift 2 ;;
      -e|--epic) epic="$2"; shift 2 ;;
      -g|--goal) goal="$2"; shift 2 ;;
      --size) size="$2"; shift 2 ;;
      --notes|-n) notes="$2"; shift 2 ;;
      --await-until) awaitUntil="$2"; shift 2 ;;
      --thread) gmailThreadId="$2"; shift 2 ;;
      --customer) customer="$2"; shift 2 ;;
      --tags|--tag) tags="$2"; shift 2 ;;
      --assign|--assignee|--assign-to) assign="$2"; assign_set=true; shift 2 ;;
      --unassigned) assign="none"; assign_set=true; shift ;;
      -*) usage_die "Unknown option for add: $1 (see: timdo add --help)" ;;
      *)
        if [[ -z "$project" ]]; then
          project="$1"; shift
        else
          usage_die "Unexpected argument: $1. Quote the task title."
        fi ;;
    esac
  done

  if [[ -z "$project" ]]; then
    usage_add >&2
    exit 1
  fi
  if [[ -z "$category" && -z "$project_id" ]]; then
    die "Error: -p/--project is mandatory when adding a task (or give --project-id)."
  fi
  if ! [[ "$priority" =~ ^[0-9]+$ ]]; then
    die "Error: --priority must be a number from 1 to 10."
  fi
  if [[ -n "$awaitUntil" && "$status" != "awaiting" ]]; then
    echo "Warning: --await-until passed but status is '$status', not 'awaiting'. Use --status awaiting to set an awaiting task." >&2
  fi

  local resolved_project_id="" target_org=""
  if [[ -n "$project_id" ]]; then
    local proj
    proj=$(resolve_project "$project_id")
    resolved_project_id=$(echo "$proj" | jq -r '.id')
    target_org=$(echo "$proj" | jq -r '.orgId')
  fi

  local assignee_id=""
  if [[ "$assign_set" == true ]]; then
    if [[ -z "$target_org" ]]; then
      target_org=$(org_for_category "$category")
      [[ -z "$target_org" ]] && target_org=$(personal_org_id)
    fi
    assignee_id=$(assignee_for_org "$target_org" "$assign")
  fi

  local epic_id="" goal_id=""
  [[ -n "$epic" ]] && epic_id=$(resolve_epic_id "$epic")
  if [[ -n "$goal" ]]; then goal_id=$(resolve_goal_id "$goal"); fi

  local has_source
  has_source=$(echo "$refs" | jq -r 'if any(.[]; (.role // "" | ascii_downcase) == "source") then "yes" else "" end')
  if [[ -n "$on_duplicate" && -z "$has_source" ]]; then
    echo "Note: --on-duplicate only applies with --source (or a source in --refs-json), so it is ignored here." >&2
  fi

  # A person at a terminal is asked about similar open tasks before anything is created.
  # Scripts (--json, piped, --yes) are never asked; --on-duplicate only controls source clashes.
  local shown="[]"
  if [[ "$assume_yes" != true ]] && is_text && can_prompt; then
    local similar
    if ! similar=$(api GET "/tasks/similar?$(similar_query "$project" "$resolved_project_id" "$category" 3)"); then
      die "Could not check for similar tasks. Nothing was created. Re-run with --yes to create anyway."
    fi
    if ! jq -e 'type == "array"' >/dev/null <<<"$similar"; then
      die "Could not check for similar tasks. Nothing was created. Re-run with --yes to create anyway."
    fi
    if [[ "$(echo "$similar" | jq 'length')" -gt 0 ]]; then
      shown=$(echo "$similar" | jq -c '[.[].id]')
      local choice
      choice=$(ask_similar "$similar")
      case "$choice" in
        create) ;;
        cancel) echo "Cancelled. Nothing was created."; exit 0 ;;
        *)
          note_instead "$(echo "$similar" | jq -c --argjson i "$choice" '.[$i - 1]')" \
            "$project" "$reason" "$notes" "$gmailThreadId" "$refs"
          return ;;
      esac
    fi
  fi

  local body
  body=$(jq -n \
    --arg project "$project" --arg reason "$reason" --arg status "$status" \
    --argjson priority "$priority" --arg size "$size" --arg notes "$notes" \
    --arg awaitUntil "$awaitUntil" --arg gmailThreadId "$gmailThreadId" \
    --arg category "$category" --arg projectId "$resolved_project_id" \
    --arg customer "$customer" --arg tags "$tags" --arg epicId "$epic_id" --arg goalId "$goal_id" \
    --argjson assignSet "$assign_set" --arg assigneeId "$assignee_id" \
    '{
      project: $project,
      reason: $reason,
      status: $status,
      priority: $priority,
      size: $size,
      notes: $notes,
      awaitUntil: (if $awaitUntil == "" then null else $awaitUntil end),
      gmailThreadId: (if $gmailThreadId == "" then null else $gmailThreadId end),
      category: (if $category == "" then null else $category end),
      customer: (if $customer == "" then null else $customer end),
      tags: (if $tags == "" then null else $tags end),
      epicId: (if $epicId == "" then null else $epicId end)
    }
    + (if $goalId == "" then {} else {goalId: $goalId} end)
    + (if $projectId != "" then {projectId: $projectId} else {} end)
    + (if $assignSet then {assigneeId: (if $assigneeId == "null" or $assigneeId == "" then null else $assigneeId end)} else {} end)
    + (if ($refs | length) > 0 then {refs: $refs} else {} end)
    + (if $onDuplicate != "" then {onDuplicate: $onDuplicate} else {} end)' \
    --argjson refs "$refs" --arg onDuplicate "$on_duplicate")

  local created
  [[ "$on_duplicate" != report ]] && CLASH_HINT="To add this report to that task instead: --on-duplicate report"
  created=$(api POST /projects -d "$body")
  CLASH_HINT=""

  # 200 with created: false means --on-duplicate return or report found the task with that source
  if [[ "$(echo "$created" | jq -r '.created')" == "false" ]]; then
    if text_out; then
      echo "$created" | jqt '"Already tracked as \((.id // "")[0:8]) \"\((.project // .title) | oneline | safe)\""'
      if [[ "$(echo "$created" | jq -r '.reported // false')" == "true" ]]; then
        echo "  Your report is on that task now (sending the same one again adds nothing)."
      else
        echo "  Nothing was created or changed."
      fi
    else
      echo "$created" | jq '.'
    fi
    return
  fi

  if text_out; then
    echo "${GRN}Added${R} $(echo "$created" | describe_task)"
    echo "$created" | jqt '(.refs // []) | sort_by(role_order) | .[] | ref_done_line'
  else
    echo "$created" | jq '.'
  fi
  print_similar_hints "$created" "$(echo "$created" | jq -r '.id')" "$shown"
}

usage_update() {
  cat <<'EOF'
Usage: timdo update <id> [options]

  --project "..."              Rename the task (historical flag name)
  -p, --category <name>        Move to another project by name
  --project-id <id|KEY|path>   Move to an exact project, e.g. ASX or "Northstar Workshop/Acme Solar"
  --assign <who>               me, none, or a human workspace member; bots cannot be assignees
  --claim                      Assign it to yourself (humans only)
  --unassign                   Leave it unassigned
  --done --do --delay --awaiting --delegate, or -s/--status <status>
  --await-until YYYY-MM-DD     Return date for awaiting tasks
  --priority <1-10>  --size <*..*****>  -r/--reason  -n/--notes  --customer  --tags
  -e, --epic <title|id|none>   Epic ("none" clears it)
  -g, --goal <title|id|none>   Your private life goal (humans only; bots cannot have life goals)
                               "none" clears it
  --thread <threadId>          Gmail thread

Links to things outside TimDo (each flag repeats; a URL or kind:id, see: timdo ref --help).
They are added to what the task already has, never replacing it:
  --ref <x>  --source <x>  --reported-by <x>  --about <x>
  --refs-json '<json>'         For scripts: [{"ref":"123456","kind":"acme.member","role":"about"}]
  --unref <x>                  Remove a ref (every role it has on this task), or a ref id from: timdo ref list

Example:
  timdo update 3f2a91c0 --ref https://github.com/acme/widgets/pull/7 --unref github.issue:acme/widgets#12

Viewers cannot edit; the API refuses with "View only: ...".
EOF
}

cmd_update() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == "-h" || "$id" == "--help" ]]; then
    usage_update
    [[ -z "$id" ]] && exit 1 || exit 0
  fi
  shift
  local body="{}" assign="" assign_set=false project_q=""
  local refs="[]" extra_refs="" unrefs=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_update; exit 0 ;;
      --link|--unlink)
        usage_die "Unknown option: $1. To link two tasks use: timdo ${1#--} <task> <task>. For links to things outside TimDo see: timdo ref --help" ;;
      --ref|--source|--reported-by|--reported_by|--about)
        [[ -z "${2:-}" ]] && usage_die "Error: $1 needs a URL or kind:id, e.g. $1 forum.post:4411"
        refs=$(echo "$refs" | jq --argjson r "$(ref_input "$2" "$(ref_role_for_flag "$1")")" '. + [$r]'); shift 2 ;;
      --refs-json)
        extra_refs=$(refs_json_arg "${2:-}")
        refs=$(echo "$refs" | jq --argjson r "$extra_refs" '. + $r'); shift 2 ;;
      --unref)
        [[ -z "${2:-}" ]] && usage_die "Error: --unref needs a URL, kind:id or ref id, e.g. --unref forum.post:4411"
        unrefs+=("$2"); shift 2 ;;
      --project|--title) body=$(echo "$body" | jq --arg v "$2" '. + {project: $v}'); shift 2 ;;
      --reason|-r) body=$(echo "$body" | jq --arg v "$2" '. + {reason: $v}'); shift 2 ;;
      --status|-s) body=$(echo "$body" | jq --arg v "$2" '. + {status: $v}'); shift 2 ;;
      --priority)
        [[ "$2" =~ ^[0-9]+$ ]] || die "Error: --priority must be a number from 1 to 10."
        body=$(echo "$body" | jq --argjson v "$2" '. + {priority: $v}'); shift 2 ;;
      -p|--category) body=$(echo "$body" | jq --arg v "$2" '. + {category: $v}'); shift 2 ;;
      --project-id) project_q="$2"; shift 2 ;;
      -e|--epic)
        local resolved_epic=""
        if [[ "$(lower "$2")" != "none" && -n "$2" ]]; then resolved_epic=$(resolve_epic_id "$2"); fi
        body=$(echo "$body" | jq --arg v "$resolved_epic" '. + {epicId: (if $v == "" then null else $v end)}'); shift 2 ;;
      -g|--goal)
        local resolved_goal=""
        if [[ "$(lower "$2")" != "none" && -n "$2" ]]; then resolved_goal=$(resolve_goal_id "$2"); fi
        body=$(echo "$body" | jq --arg v "$resolved_goal" '. + {goalId: (if $v == "" then null else $v end)}'); shift 2 ;;
      --size) body=$(echo "$body" | jq --arg v "$2" '. + {size: $v}'); shift 2 ;;
      --notes|-n) body=$(echo "$body" | jq --arg v "$2" '. + {notes: $v}'); shift 2 ;;
      --done) body=$(echo "$body" | jq '. + {status: "done", awaitUntil: null}'); shift ;;
      --do) body=$(echo "$body" | jq '. + {status: "do", awaitUntil: null}'); shift ;;
      --delay) body=$(echo "$body" | jq '. + {status: "delay", awaitUntil: null}'); shift ;;
      --awaiting) body=$(echo "$body" | jq '. + {status: "awaiting"}'); shift ;;
      --delegate) body=$(echo "$body" | jq '. + {status: "delegate", awaitUntil: null}'); shift ;;
      --await-until) body=$(echo "$body" | jq --arg v "$2" '. + {awaitUntil: $v}'); shift 2 ;;
      --thread) body=$(echo "$body" | jq --arg v "$2" '. + {gmailThreadId: $v}'); shift 2 ;;
      --customer) body=$(echo "$body" | jq --arg v "$2" '. + {customer: $v}'); shift 2 ;;
      --tags|--tag) body=$(echo "$body" | jq --arg v "$2" '. + {tags: $v}'); shift 2 ;;
      --claim) assign="me"; assign_set=true; shift ;;
      --assign|--assignee|--assign-to) assign="$2"; assign_set=true; shift 2 ;;
      --unassign) assign="none"; assign_set=true; shift ;;
      *) usage_die "Unknown option for update: $1 (see: timdo update --help)" ;;
    esac
  done

  local before full_id
  before=$(resolve_task "$id")
  full_id=$(echo "$before" | jq -r '.id')

  # Where the task will live after this update (for assignment checks)
  local target_org
  target_org=$(echo "$before" | jq -r '.orgId // empty')
  if [[ -n "$project_q" ]]; then
    local proj
    proj=$(resolve_project "$project_q")
    body=$(echo "$body" | jq --arg v "$(echo "$proj" | jq -r '.id')" '. + {projectId: $v}')
    target_org=$(echo "$proj" | jq -r '.orgId')
  elif [[ "$(echo "$body" | jq -r 'has("category")')" == "true" ]]; then
    local moved_org
    moved_org=$(org_for_category "$(echo "$body" | jq -r '.category // ""')")
    if [[ -n "$moved_org" ]]; then target_org="$moved_org"; else target_org=$(personal_org_id); fi
  fi

  if [[ "$assign_set" == true ]]; then
    local assignee_id
    if [[ "$(lower "$assign")" == "me" ]]; then
      assignee_id=$(my_id)
    elif [[ -n "$target_org" ]]; then
      assignee_id=$(assignee_for_org "$target_org" "$assign")
    else
      case "$(lower "$assign")" in
        none|nobody|unassigned|null) assignee_id="null" ;;
        *) die "Error: cannot work out which workspace this task is in, so cannot assign \"$assign\"." ;;
      esac
    fi
    body=$(echo "$body" | jq --arg v "$assignee_id" '. + {assigneeId: (if $v == "null" then null else $v end)}')
  fi

  local ref_count=$(( $(echo "$refs" | jq 'length') + ${#unrefs[@]} ))
  if [[ "$body" == "{}" && "$ref_count" -eq 0 ]]; then
    usage_die "Nothing to update. See: timdo update --help"
  fi

  # Strip --await-until unless the task is (or is becoming) awaiting
  local has_await new_status current_status
  has_await=$(echo "$body" | jq -r '.awaitUntil // empty')
  new_status=$(echo "$body" | jq -r '.status // empty')
  current_status=$(echo "$before" | jq -r '.status // empty')
  local strip_await=false
  if [[ -n "$has_await" ]]; then
    if [[ -n "$new_status" && "$new_status" != "awaiting" ]]; then
      strip_await=true
    elif [[ -z "$new_status" && "$current_status" != "awaiting" ]]; then
      strip_await=true
    fi
  fi
  if [[ "$strip_await" == true ]]; then
    echo "Warning: --await-until passed but status is '${new_status:-$current_status}', not 'awaiting'. Ignoring the date. Use --awaiting to set an awaiting task." >&2
    body=$(echo "$body" | jq 'del(.awaitUntil)')
  fi

  local after="$before" put_sent=false
  if [[ "$body" != "{}" ]]; then
    after=$(api PUT "/projects/$full_id" -d "$body")
    put_sent=true
    cache_clear
  fi

  # Refs go through their own endpoint after the task change: removals first, then additions.
  # One failure does not stop the rest; each error is printed and the exit code is 1.
  local ref_lines="" ref_failed=0
  if [[ "$ref_count" -gt 0 ]]; then
    local u removed added i line
    for u in ${unrefs[@]+"${unrefs[@]}"}; do
      if removed=$(remove_ref "$full_id" "$u"); then
        line=$(echo "$removed" | jqt '.[] | "  Removed " + (.role | role_noun) + " " + ref_canonical')
        [[ -n "$line" ]] && ref_lines+="$line"$'\n'
      else
        ref_failed=$((ref_failed + 1))
      fi
    done
    for i in $(seq 0 $(( $(echo "$refs" | jq 'length') - 1 ))); do
      if added=$(add_ref "$full_id" "$(echo "$refs" | jq -c ".[$i]")"); then
        ref_lines+="$(echo "$added" | jqt 'ref_done_line')"$'\n'
      else
        ref_failed=$((ref_failed + 1))
      fi
    done
    # Show the task as it is now, refs included
    after=$( (api GET "/projects/$full_id") 2>/dev/null || echo "$after")
    cache_clear
  fi

  # Nothing was sent but link changes, and every one failed: nothing changed, so say only that
  if [[ "$put_sent" == false && "$ref_failed" -gt 0 && "$ref_failed" -eq "$ref_count" ]]; then
    die "Error: $ref_failed of $ref_count link changes failed (see above). Nothing was changed."
  fi

  if text_out; then
    local changes
    changes=$(jq -rn --argjson a "$before" --argjson b "$after" '
      def show: if . == null or . == "" then "none" else tostring end;
      [ ["Title", "project"], ["Status", "status"], ["Priority", "priority"], ["Size", "size"],
        ["Project", "projectName"], ["Workspace", "orgName"], ["Assignee", "assigneeName"],
        ["Epic", "epicId"], ["Life goal", "goalId"], ["Return date", "awaitUntil"], ["Why", "reason"],
        ["Customer", "customer"], ["Tags", "tags"], ["Notes", "notes"], ["Gmail thread", "gmailThreadId"] ]
      | map(. as [$label, $k] | select(($a[$k] // null) != ($b[$k] // null))
          | if ($k == "epicId" or $k == "goalId") then "  \($label): \($a[$k] | show | .[0:8]) -> \($b[$k] | show | .[0:8])"
            elif ($k == "assigneeName") then "  \($label): \($a[$k] // "unassigned") -> \($b[$k] // "unassigned")"
            else "  \($label): \($a[$k] | show) -> \($b[$k] | show)" end)
      | .[]')
    echo "${GRN}Updated${R} $(echo "$after" | describe_task)"
    if [[ -n "$changes" ]]; then echo "$changes"; fi
    if [[ -n "$ref_lines" ]]; then printf '%s' "$ref_lines"; fi
    if [[ -z "$changes" && -z "$ref_lines" ]]; then echo "  (no changes)"; fi
  else
    echo "$after" | jq '.'
  fi
  if [[ "$ref_failed" -gt 0 ]]; then
    if [[ "$put_sent" == true ]]; then
      die "Error: $ref_failed of $ref_count link changes failed (see above). Everything else was saved."
    fi
    die "Error: $ref_failed of $ref_count link changes failed (see above). The others were saved."
  fi
}

# ---------------------------------------------------------------------------
# notes, add-note, delete
# ---------------------------------------------------------------------------
cmd_add_note() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == "-h" || "$id" == "--help" ]]; then
    echo "Usage: timdo add-note <id> \"note text\" [--thread <threadId>]   (alias: log)"
    echo "  Notes are signed with your name and visible to everyone in the task's workspace."
    [[ -z "$id" ]] && exit 1 || exit 0
  fi
  shift

  local note="" gmailThreadId=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --thread) gmailThreadId="$2"; shift 2 ;;
      *)
        if [[ -z "$note" ]]; then
          note="$1"; shift
        else
          usage_die "Unexpected argument: $1. Quote the note text."
        fi ;;
    esac
  done
  [[ -z "$note" ]] && usage_die "Usage: timdo add-note <id> \"note text\" [--thread <threadId>]"

  local task full_id
  task=$(resolve_task "$id")
  full_id=$(echo "$task" | jq -r '.id')

  local body result author
  body=$(jq -n --arg note "$note" --arg t "$gmailThreadId" '{note: $note, gmailThreadId: (if $t == "" then null else $t end)}')
  result=$(api POST "/projects/$full_id/updates" -d "$body")
  author=$(echo "$result" | jqt 'note_author')
  if text_out; then
    echo "${GRN}Noted${R} on $(echo "$task" | jq -r '"\(.id[0:8])  \"\(.project)\""') as $author."
  else
    echo "$result" | jq '.'
  fi
}

cmd_notes() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == "-h" || "$id" == "--help" ]]; then
    echo "Usage: timdo notes <id>   Dated notes on a task, with who wrote each one (alias: updates)"
    [[ -z "$id" ]] && exit 1 || exit 0
  fi

  local task full_id updates
  task=$(resolve_task "$id")
  full_id=$(echo "$task" | jq -r '.id')
  updates=$(api GET "/projects/$full_id/updates")

  if ! is_text; then
    echo "$updates" | jq '.'
    return
  fi

  echo "$task" | jqt '"Notes on \"\(.project)\"  " + (where | paint("cyan")) + "  (\($n))"' --argjson n "$(echo "$updates" | jq 'length')"
  if [[ "$(echo "$updates" | jq 'length')" -eq 0 ]]; then
    echo "  (none yet)"
  else
    echo "$updates" | jqt 'sort_by(.createdAt) | note_lines'
  fi
}

cmd_delete() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == "-h" || "$id" == "--help" ]]; then
    echo "Usage: timdo delete <id>   Soft-delete a task (members and owners only, not viewers)"
    [[ -z "$id" ]] && exit 1 || exit 0
  fi
  local task full_id result
  task=$(resolve_task "$id")
  full_id=$(echo "$task" | jq -r '.id')
  result=$(api DELETE "/projects/$full_id")
  if text_out; then
    echo "${GRN}Deleted${R} $(echo "$task" | describe_task)"
  else
    echo "$result" | jq '.'
  fi
}

# ---------------------------------------------------------------------------
# epics
# ---------------------------------------------------------------------------
usage_epic() {
  cat <<'EOF'
Usage: timdo epic <list|get|add|update|delete> ...

Epics belong to a project, so everyone in that project's workspace sees them.

  timdo epic list [-p <project>] [-w <workspace>]
  timdo epic get <id|title>                 Details, people, tasks with assignees, activity
  timdo epic add "Title" -p <project> [--project-id <id|KEY>] [-g <goal>] [-d "..."] [--status active|completed|on_hold]
  timdo epic update <id|title> [--title "..."] [-p <project>] [--project-id <id|KEY>] [-g <goal>] [-d "..."]
                    [--status <s>] [--completed] [--active] [--on-hold]
  timdo epic delete <id|title>

Life goal links on epics are private: only the epic's creator sees them.
EOF
}

epic_line_lib='
def epic_where: (.category // "") as $p
  | if .isShared == true then (if ($p | ascii_downcase) == ((.orgName // "") | ascii_downcase) then $p else "\(.orgName // "?")/\($p)" end) else $p end;
def epic_widths: {t: ([maxlen(.title | oneline), 48] | min), w: maxlen(epic_where)};
def epic_line($w):
  "  " + ("\(.progressPercentage // 0)%" | lpad(4) | paint("bold"))
  + "  " + ((.id // "")[0:8] | paint("dim"))
  + "  " + (.title | oneline | if $cols > 0 then trunc($w.t) else . end | pad($w.t))
  + "  " + (epic_where | pad($w.w) | paint("cyan"))
  + "  " + ("\(.doneTasks // 0)/\(.totalTasks // 0) done" | pad(11))
  + (if .status != "active" then "  " + (.status | paint("yellow")) else "" end)
  + (if .isShared == true and .createdByName then "  " + ("by \(.createdByName | first_name)" | paint("dim")) else "" end)
  + (if .canEdit == false then "  " + ("view only" | paint("red")) else "" end);
'

describe_epic() {
  jqt "$epic_line_lib"'"\((.id // "")[0:8])  \"\(.title)\"  " + (epic_where | paint("cyan")) + "  [\(.status)]"'
}

cmd_epic() {
  local subcmd="${1:-list}"
  shift || true

  case "$subcmd" in
    -h|--help|help) usage_epic ;;

    list)
      local category="" workspace=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -h|--help) usage_epic; exit 0 ;;
          -p|--category|--project) category="$2"; shift 2 ;;
          -w|--workspace) workspace="$2"; shift 2 ;;
          *) usage_die "Unknown option for epic list: $1" ;;
        esac
      done
      local path="/epics"
      [[ -n "$category" ]] && path="$path?category=$(urlencode "$category")"
      local raw
      raw=$(api GET "$path")
      if [[ -n "$workspace" ]]; then
        local org_id
        org_id=$(resolve_org "$workspace" | jq -r '.id')
        raw=$(echo "$raw" | jq --arg o "$org_id" '[.[] | select(.orgId == $o)]')
      fi
      if ! is_text; then
        echo "$raw" | jq '.'
        return
      fi
      if [[ "$(echo "$raw" | jq 'length')" -eq 0 ]]; then
        echo "No epics found."
        return
      fi
      echo "$raw" | jqt "$epic_line_lib"'epic_widths as $w | sort_by(.status != "active", (.orgName // ""), (.category // ""), .title) | .[] | epic_line($w)'
      ;;

    add)
      local title="" category="" project_q="" goal="" description="" status="active"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -h|--help) usage_epic; exit 0 ;;
          -p|--category|--project) category="$2"; shift 2 ;;
          --project-id) project_q="$2"; shift 2 ;;
          -g|--goal) goal="$2"; shift 2 ;;
          -d|--description) description="$2"; shift 2 ;;
          --status) status="$2"; shift 2 ;;
          -*) usage_die "Unknown option for epic add: $1" ;;
          *)
            if [[ -z "$title" ]]; then title="$1"; shift
            else usage_die "Unexpected argument: $1. Quote the epic title."; fi ;;
        esac
      done
      if [[ -z "$title" ]]; then
        usage_epic >&2
        exit 1
      fi
      local goal_id="" project_id=""
      if [[ -n "$goal" ]]; then goal_id=$(resolve_goal_id "$goal"); fi
      [[ -n "$project_q" ]] && project_id=$(resolve_project "$project_q" | jq -r '.id')
      local body
      body=$(jq -n --arg title "$title" --arg category "$category" --arg goalId "$goal_id" \
        --arg description "$description" --arg status "$status" --arg projectId "$project_id" \
        '{
          title: $title,
          category: (if $category == "" then null else $category end),
          description: (if $description == "" then null else $description end),
          status: $status
        } + (if $goalId == "" then {} else {goalId: $goalId} end)
          + (if $projectId != "" then {projectId: $projectId} else {} end)')
      local created
      created=$(api POST /epics -d "$body")
      if text_out; then
        echo "${GRN}Added epic${R} $(echo "$created" | describe_epic)"
      else
        echo "$created" | jq '.'
      fi
      ;;

    update)
      local target="${1:-}"
      shift || true
      if [[ -z "$target" || "$target" == "-h" || "$target" == "--help" ]]; then
        usage_epic
        [[ -z "$target" ]] && exit 1 || exit 0
      fi
      local epic_id
      epic_id=$(resolve_epic_id "$target")

      local title="" category="" goal="" description="" status="" project_q=""
      local has_title=false has_category=false has_goal=false has_desc=false has_status=false
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --title) title="$2"; has_title=true; shift 2 ;;
          -p|--category|--project) category="$2"; has_category=true; shift 2 ;;
          --project-id) project_q="$2"; shift 2 ;;
          -g|--goal) goal="$2"; has_goal=true; shift 2 ;;
          -d|--description) description="$2"; has_desc=true; shift 2 ;;
          --status) status="$2"; has_status=true; shift 2 ;;
          --completed) status="completed"; has_status=true; shift ;;
          --active) status="active"; has_status=true; shift ;;
          --on-hold) status="on_hold"; has_status=true; shift ;;
          *) usage_die "Unknown option for epic update: $1" ;;
        esac
      done

      local goal_id="" project_id=""
      if [[ "$has_goal" == true && -n "$goal" && "$(lower "$goal")" != "none" ]]; then
        goal_id=$(resolve_goal_id "$goal")
      fi
      [[ -n "$project_q" ]] && project_id=$(resolve_project "$project_q" | jq -r '.id')

      local body
      body=$(jq -n \
        --arg title "$title" --argjson has_title "$has_title" \
        --arg category "$category" --argjson has_cat "$has_category" \
        --arg goalId "$goal_id" --argjson has_goal "$has_goal" \
        --arg description "$description" --argjson has_desc "$has_desc" \
        --arg status "$status" --argjson has_status "$has_status" \
        --arg projectId "$project_id" \
        '{}
        | if $has_title then .title = $title else . end
        | if $has_cat then .category = (if ($category == "" or $category == "null") then null else $category end) else . end
        | if $has_goal then .goalId = (if ($goalId == "" or $goalId == "null") then null else $goalId end) else . end
        | if $has_desc then .description = (if ($description == "" or $description == "null") then null else $description end) else . end
        | if $has_status then .status = $status else . end
        | if $projectId != "" then .projectId = $projectId else . end')
      [[ "$body" == "{}" ]] && usage_die "Nothing to update. See: timdo epic --help"

      local updated
      updated=$(api PUT "/epics/$epic_id" -d "$body")
      if text_out; then
        echo "${GRN}Updated epic${R} $(echo "$updated" | describe_epic)"
      else
        echo "$updated" | jq '.'
      fi
      ;;

    delete)
      local target="${1:-}"
      if [[ -z "$target" || "$target" == "-h" || "$target" == "--help" ]]; then
        echo "Usage: timdo epic delete <id|title>"
        [[ -z "$target" ]] && exit 1 || exit 0
      fi
      local epic_id epic_json result
      epic_id=$(resolve_epic_id "$target")
      epic_json=$( (api GET "/epics/$epic_id" 2>/dev/null) || echo '{}')
      result=$(api DELETE "/epics/$epic_id")
      if text_out; then
        echo "${GRN}Deleted epic${R} $(echo "$epic_json" | jq -r '"\((.id // "")[0:8])  \"\(.title // "")\""')"
      else
        echo "$result" | jq '.'
      fi
      ;;

    get)
      local target="${1:-}"
      if [[ -z "$target" || "$target" == "-h" || "$target" == "--help" ]]; then
        echo "Usage: timdo epic get <id|title>"
        [[ -z "$target" ]] && exit 1 || exit 0
      fi
      local epic_id epic_json tasks_raw activity
      epic_id=$(resolve_epic_id "$target")
      epic_json=$(api GET "/epics/$epic_id")
      tasks_raw=$(api GET "/projects?epicId=$(urlencode "$epic_id")")
      tasks_raw=$(echo "$tasks_raw" | jq '[.[] | select(.isDeleted != true)] | sort_by((.status | {"do":0,"awaiting":1,"delegate":2,"delay":3,"done":4}[.] // 9), -.priority)')
      activity=$( (api GET "/activity?epicId=$(urlencode "$epic_id")&limit=8" 2>/dev/null) || echo '[]')

      if ! is_text; then
        echo "$epic_json" | jq --argjson tasks "$tasks_raw" --argjson activity "$activity" '. + {tasks: $tasks, activity: $activity}'
        return
      fi

      echo "$epic_json" | jqt "$epic_line_lib"'
        def row($k; $v): if ($v // "") == "" then empty else "  " + ($k | pad(15) | paint("dim")) + ($v | tostring | gsub("\n"; "\n" + (" " * 17))) end;
        ("Epic: " + .title | paint("bold")),
        row("ID:"; .id),
        row("Status:"; .status),
        row("Workspace:"; (.orgName // "") + (if .isShared == true then "  (shared, your role: \(.myRole // "?"))" else (if .orgName then "  (personal)" else "" end) end)),
        row("Project:"; (.category // "") + (if .projectKey then " (\(.projectKey))" else "" end)),
        row("Progress:"; "\(.progressPercentage // 0)%  \(.doneTasks // 0)/\(.totalTasks // 0) tasks done"),
        row("Created by:"; ((.createdByName // "") + "  " + (.createdAt | long_dt)) | sub("^ +"; "")),
        row("Last updated:"; ((.updatedByName // "") + "  " + (.updatedAt | long_dt)) | sub("^ +"; "")),
        row("Access:"; if .canEdit == false then "view only" else "can edit" end),
        row("Description:"; .description)'
      echo ""
      echo "${B}Tasks ($(echo "$tasks_raw" | jq 'length'))${R}"
      if [[ "$(echo "$tasks_raw" | jq 'length')" -eq 0 ]]; then
        echo "  (no tasks in this epic yet)"
      else
        echo "$tasks_raw" | jqt '
          task_widths as $w
          | .[]
          | (if .status == "done" then "x" else " " end) as $x
          | "  [\($x)] " + (.status | pad(8)) + (task_line($w) | sub("^  "; ""))'
      fi
      if [[ "$(echo "$activity" | jq 'length')" -gt 0 ]]; then
        echo ""
        echo "${B}Recent activity${R}"
        echo "$activity" | jqt 'activity_lines'
      fi
      ;;

    *)
      usage_die "Unknown epic subcommand: $subcmd. Use list, get, add, update or delete (see: timdo epic --help)."
      ;;
  esac
}

# ---------------------------------------------------------------------------
# goals (personal, never shared)
# ---------------------------------------------------------------------------
cmd_goal() {
  local subcmd="${1:-list}"
  shift || true

  case "$subcmd" in
    -h|--help|help)
      echo "Usage: timdo goal list [-t aims|focuses|values|housekeeping]"
      echo "  Life goals are private to you. Collaborators never see them."
      ;;
    list)
      local type=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -t|--type) type="$2"; shift 2 ;;
          *) usage_die "Unknown option for goal list: $1" ;;
        esac
      done
      local path="/goals"
      [[ -n "$type" ]] && path="$path?type=$(urlencode "$type")"
      local raw
      raw=$(api GET "$path")
      if ! is_text; then
        echo "$raw" | jq '.'
        return
      fi
      if [[ "$(echo "$raw" | jq 'length')" -eq 0 ]]; then
        echo "No goals found."
        return
      fi
      echo "$raw" | jqt 'group_by(.type) | .[] | ("", ((.[0].type // "other") | ascii_upcase | paint("bold"))),
        (.[] | "  " + ((.id // "")[0:8] | paint("dim")) + "  " + .title + (if .description then ("  - " + (.description | oneline) | paint("dim")) else "" end))'
      ;;
    *)
      usage_die "Unknown goal subcommand: $subcmd. Use 'timdo goal list'."
      ;;
  esac
}

# ---------------------------------------------------------------------------
# poster (personal: your own tasks across all workspaces)
# ---------------------------------------------------------------------------
cmd_poster() {
  local output="" category="" poster_type=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output|-o) output="$2"; shift 2 ;;
      --category|-c|-p) category="$2"; shift 2 ;;
      --type|-t) poster_type="$2"; shift 2 ;;
      -h|--help|help)
        echo "Usage: timdo poster --output <path> [-c|--category <list>] [--type <done|active|goals>]"
        echo "  Downloads a poster SVG. Posters show your own tasks (assigned to you) across all workspaces."
        exit 0
        ;;
      *) usage_die "Unknown option for poster: $1" ;;
    esac
  done
  [[ -z "$output" ]] && usage_die "Usage: timdo poster --output <path> [-c|--category <list>] [--type <done|active|goals>]"

  # Without --type: the Wall of Done when a category is given, otherwise the goals poster
  if [[ -z "$poster_type" ]]; then
    if [[ -n "$category" ]]; then poster_type="done"; else poster_type="goals"; fi
  fi

  local endpoint_path=""
  case "$poster_type" in
    done) endpoint_path="/poster/wall-of-done" ;;
    active) endpoint_path="/poster/active" ;;
    goals) endpoint_path="/goals/poster.svg" ;;
    *) usage_die "Unknown poster type: $poster_type. Supported types: done, active, goals" ;;
  esac
  if [[ -n "$category" && "$poster_type" != "goals" ]]; then
    endpoint_path="${endpoint_path}?categories=$(echo "$category" | tr ' ' '+')"
  fi

  local parent_dir
  parent_dir=$(dirname "$output")
  [[ -n "$parent_dir" && ! -d "$parent_dir" ]] && mkdir -p "$parent_dir"

  api GET "$endpoint_path" > "$output"
  echo "Downloaded $poster_type poster SVG to $output"
}

# ---------------------------------------------------------------------------
# search, merge, audit, customers, link, unlink
# ---------------------------------------------------------------------------
cmd_search() {
  local query="" include_done=false customer=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "Usage: timdo search \"query\" [--all] [--customer \"...\"]"
        echo "  Full-text search across every workspace you can see. --all includes done tasks."
        echo "  A URL or kind:id (e.g. github.issue:acme/widgets#12) lists tasks carrying that ref first."
        exit 0 ;;
      --all|-a) include_done=true; shift ;;
      --customer) customer="$2"; shift 2 ;;
      *) if [[ -z "$query" ]]; then query="$1"; else query="$query $1"; fi; shift ;;
    esac
  done
  [[ -z "$query" ]] && usage_die "Usage: timdo search \"query\" [--all] [--customer \"...\"]"

  local endpoint="/tasks/search?q=$(urlencode "$query")&includeDone=${include_done}"
  [[ -n "$customer" ]] && endpoint="${endpoint}&customer=$(urlencode "$customer")"

  local raw tasks enriched
  raw=$(api GET "$endpoint")
  tasks=$(api_optional /projects)
  # Search results carry no sharing fields yet, so add them from the task list
  echo "$raw" > "$TMPD/search.json"; echo "$tasks" > "$TMPD/tasks.json"
  enriched=$(jq -n --slurpfile rs "$TMPD/search.json" --slurpfile ts "$TMPD/tasks.json" '
    $rs[0] as $r | $ts[0] as $t
    | ($t | map({key: .id, value: .}) | from_entries) as $byId
    | $r | map(. as $s | ($byId[$s.id] // {}) as $v
        | $s + ($v | {category, projectId, projectKey, projectName, orgId, orgName, isShared, myRole, canEdit,
                      assigneeId, assigneeName, reporterName, updatedByName, isMine}
                   | with_entries(select(.value != null))))')

  if ! is_text; then
    echo "$enriched" | jq '.'
    return
  fi

  local count
  count=$(echo "$enriched" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    echo "No matching tasks found for: $query"
    return
  fi
  echo "${B}Found $count matching tasks${R}"
  echo "$enriched" | jqt '.[]
    | "  " + (.shortId | paint("dim")) + "  " + ("(\(.status), P\(.priority))" | pad(15)) + "  " + .title
      + (if (where) != "" then "  " + (where | paint("cyan")) else "" end)
      + (if .isShared == true then "  " + (who | paint("yellow")) else "" end)
      + (if .customer then "  " + ("customer: \(.customer)" | paint("dim")) else "" end)
      + (if .matchedRef == true then "  " + ("carries this ref" | paint("green")) else "" end)
      + (if .snippet then "\n             " + ("Match: " + (.snippet | gsub("<[^>]*>"; "") | oneline) | paint("dim")) else "" end)
      + (if (.linkedTasks // []) | length > 0 then "\n             Linked: " + ([.linkedTasks[] | "[\(.relationType)] \(.title) (\(.shortId))"] | join(", ")) else "" end)'
}

cmd_merge() {
  local source_arg="" target_arg="" assume_yes=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) assume_yes=true; shift ;;
      -h|--help) source_arg=""; target_arg=""; break ;;
      *)
        if [[ -z "$source_arg" ]]; then source_arg="$1"
        elif [[ -z "$target_arg" ]]; then target_arg="$1"
        else usage_die "Unexpected argument: $1"; fi
        shift ;;
    esac
  done

  if [[ -z "$source_arg" || -z "$target_arg" ]]; then
    echo "Usage: timdo merge <source_id> <target_id> [--yes|-y]" >&2
    echo "  Merges source task into target task (target survives, source is archived)." >&2
    echo "  You need edit rights on both tasks." >&2
    exit 1
  fi

  local source_json target_json
  source_json=$(resolve_task "$source_arg")
  target_json=$(resolve_task "$target_arg")
  local source_id target_id source_title target_title
  source_id=$(echo "$source_json" | jq -r '.id')
  target_id=$(echo "$target_json" | jq -r '.id')
  source_title=$(echo "$source_json" | jq -r '.project')
  target_title=$(echo "$target_json" | jq -r '.project')

  [[ "$source_id" == "$target_id" ]] && die "Error: Cannot merge a task into itself."

  if [[ "$assume_yes" != "true" && "$TIMDO_FORMAT" != "json" ]]; then
    echo ""
    echo "${B}Confirm task merge${R}"
    echo "  ABSORBING (source): $(echo "$source_json" | describe_task)  -> will be archived"
    echo "  KEEPING   (target): $(echo "$target_json" | describe_task)  -> absorbs notes and updates"
    echo ""
    confirm_or_exit "Proceed with merge?" false
  fi

  local result
  result=$(api POST "/projects/$target_id/merge" -d "$(jq -n --arg s "$source_id" '{sourceId: $s}')")
  if ! is_text; then
    echo "$result" | jq '.'
  else
    echo "Successfully merged '${source_title}' into '${target_title}' (${target_id:0:8})."
  fi
}

cmd_audit() {
  local scope="mine"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) scope="all"; shift ;;
      --mine) scope="mine"; shift ;;
      -h|--help)
        cat <<'EOF'
Usage: timdo audit [--all]

Hygiene check on active (not done) tasks: missing epic, life goal, project or reason,
plus active epics with no tasks.

Scope: by default only YOUR tasks (assigned to you, or unassigned and created by you)
that you can edit, and epics you created. Collaborators' tasks are theirs to tidy, and
life goal links are private, so their "missing goal" count would mean nothing to you.
--all widens it to every task and epic you can edit in every workspace.
EOF
        exit 0 ;;
      *) usage_die "Unknown option for audit: $1" ;;
    esac
  done

  local raw epics_raw me
  raw=$(all_tasks)
  epics_raw=$(api_cached /epics)
  me=$(api_optional /users/me '{}' | jq -r '.id // ""')

  local report
  echo "$raw" > "$TMPD/tasks.json"; echo "$epics_raw" > "$TMPD/epics.json"
  report=$(jq -n --slurpfile ts "$TMPD/tasks.json" --slurpfile es "$TMPD/epics.json" --arg scope "$scope" --arg me "$me" '
    def blank: . == null or . == "";
    $ts[0] as $t | $es[0] as $e |
    [$t[] | select(.isDeleted != true and .status != "done")
          | select(.canEdit != false)
          | select($scope == "all" or .isMine == true or (.isMine == null))] as $active
    | [$e[] | select(.status == "active" and (.totalTasks // 0) == 0)
            | select(.canEdit != false)
            | select($scope == "all" or (.createdById // null) == null or .createdById == $me)] as $emptyEpics
    | {
        scope: $scope,
        totalActiveTasks: ($active | length),
        missingEpic: ([$active[] | select(.epicId | blank)] | length),
        missingGoal: ([$active[] | select(.goalId | blank)] | length),
        missingCategory: ([$active[] | select(.category | blank)] | length),
        missingReason: ([$active[] | select(.reason | blank)] | length),
        activeEpicsWithNoTasks: ($emptyEpics | length),
        emptyEpics: [$emptyEpics[] | {id, title, category, orgName}],
        byWorkspace: ($active | group_by(.orgName // "") | map({workspace: (.[0].orgName // "unknown"), activeTasks: length,
                       missingEpic: ([.[] | select(.epicId | blank)] | length)}))
      }')

  if ! is_text; then
    echo "$report"
    return
  fi

  local mine_flag="--mine "
  [[ "$scope" == "all" ]] && mine_flag=""
  echo "$report" | jqt '
    ("TimDo alignment and hygiene audit" | paint("bold")),
    ("Scope: " + (if .scope == "all" then "every task and epic you can edit" else "your own tasks and epics (use --all for everything you can edit)" end) | paint("dim")),
    "",
    "  Active tasks:              \(.totalActiveTasks | lpad(4))",
    "  Missing epic:              \(.missingEpic | lpad(4))  " + ("view: timdo list \($f)--no-epic" | paint("dim")),
    "  Missing life goal:         \(.missingGoal | lpad(4))  " + ("view: timdo list \($f)--no-goal" | paint("dim")),
    "  Missing project:           \(.missingCategory | lpad(4))  " + ("view: timdo list \($f)--no-category" | paint("dim")),
    "  Missing why/reason:        \(.missingReason | lpad(4))",
    "  Active epics with 0 tasks: \(.activeEpicsWithNoTasks | lpad(4))",
    (.emptyEpics[] | "      " + (.id[0:8] | paint("dim")) + "  " + .title + "  " + ((if .orgName then "\(.orgName)/" else "" end) + (.category // "") | paint("cyan"))),
    (if (.byWorkspace | length) > 1 then "", "  By workspace:", (.byWorkspace[] | "    " + (.workspace | pad(24)) + "\(.activeTasks) active, \(.missingEpic) without an epic") else empty end),
    "",
    "To link an orphan task:",
    "  timdo update <id> -e <epic> [-g <goal>] [-p <project>]"
  ' --arg f "$mine_flag"
}

cmd_customers() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: timdo customers   Customers with open task counts, and the workspaces they appear in"
    exit 0
  fi
  local raw tasks enriched
  raw=$(api GET /customers)
  tasks=$(api_optional /projects)
  echo "$raw" > "$TMPD/customers.json"; echo "$tasks" > "$TMPD/tasks.json"
  enriched=$(jq -n --slurpfile rs "$TMPD/customers.json" --slurpfile ts "$TMPD/tasks.json" '
    $rs[0] as $r | $ts[0] as $t
    | $r | map(. as $c
      | ($c.customer | ascii_downcase | gsub("^\\s+|\\s+$"; "")) as $k
      | $c + {workspaces: ([$t[] | select(.isDeleted != true and ((.customer // "") | ascii_downcase | gsub("^\\s+|\\s+$"; "")) == $k) | .orgName // empty] | unique)})')

  if ! is_text; then
    echo "$enriched" | jq '.'
    return
  fi
  local count
  count=$(echo "$enriched" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    echo "No customers found."
    return
  fi
  echo "${B}Customers ($count)${R}"
  echo "$enriched" | jqt 'maxlen(.customer) as $w | .[]
    | "  " + (.customer | pad($w)) + "  " + ("\(.openCount) open" | lpad(8)) + "  " + (.workspaces | join(", ") | paint("cyan"))'
}

cmd_link() {
  local source_id="${1:-}" target_id="${2:-}"
  if [[ "$source_id" == "-h" || "$source_id" == "--help" ]]; then source_id=""; fi
  shift 2 || true
  local relation_type="relates_to" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type|-t) relation_type="$2"; shift 2 ;;
      --reason|-r) reason="$2"; shift 2 ;;
      *) usage_die "Unknown option for link: $1" ;;
    esac
  done
  if [[ -z "$source_id" || -z "$target_id" ]]; then
    usage_die "Usage: timdo link <task_id> <target_task_id> [--type relates_to|blocks|blocked_by|duplicates] [--reason \"...\"]"
  fi

  local source_json target_json
  source_json=$(resolve_task "$source_id")
  target_json=$(resolve_task "$target_id")
  local body result
  body=$(jq -n --arg t "$(echo "$target_json" | jq -r '.id')" --arg relation "$relation_type" --arg reason "$reason" \
    '{targetTaskId: $t, relation: $relation, reason: (if $reason == "" then null else $reason end)}')
  result=$(api POST "/tasks/$(echo "$source_json" | jq -r '.id')/links" -d "$body")
  if ! is_text; then
    echo "$result" | jq '.'
  else
    echo "Linked task $source_id to $target_id ($relation_type): \"$(echo "$source_json" | jq -r '.project')\" $relation_type \"$(echo "$target_json" | jq -r '.project')\"."
  fi
}

cmd_unlink() {
  local source_id="${1:-}" target_id="${2:-}"
  if [[ -z "$source_id" || -z "$target_id" || "$source_id" == "-h" || "$source_id" == "--help" ]]; then
    usage_die "Usage: timdo unlink <task_id> <target_task_id>"
  fi
  local result
  result=$(api DELETE "/tasks/$source_id/links/$target_id")
  if ! is_text; then
    echo "$result" | jq '.'
  else
    echo "Unlinked task $source_id and $target_id."
  fi
}

# ---------------------------------------------------------------------------
# recorded events
# ---------------------------------------------------------------------------
usage_events() {
  cat <<'EOF'
Usage:
  timdo events [--after 0|latest|CURSOR] [-w ID|SLUG] [--types LIST]
               [--include-refs] [--include-text] [-n 1-500] [--follow] [--interval 1-3600]
               [--state-file PATH]
  timdo events init --state-file PATH --after 0|latest [scope and include options]
  timdo events ack --state-file PATH --from OLD --to NEXT

Read one finite page from the recorded activity feed. JSON output is the complete
versioned page envelope, including when events is empty. --text is the global
human-readable format flag. Text output shows IDs and fixed attribution fields only.

--follow drains every hasMore page before waiting for the next poll. JSON follow
writes one compact page envelope per line. The cursor stays in memory and advances
only after that page was written. It stops on SIGINT or SIGTERM. Follow cannot use
a checkpoint file.

A checkpoint is created only by init. Use --after 0 to replay visible history, or
--after latest to start at the current high-water mark. A finite --state-file read
never changes the file. After every intended action succeeds, acknowledge with the
old and next cursor from the page. Replays are normal; use the immutable event ID
as the receiver's idempotency key. The file contains no credential or event body.

The checkpoint helper uses Node.js built-ins. Store the file in a private directory.
See docs/integrations.md for the feed's limits and a local receiver example.

Examples:
  timdo --json events --after 0 --workspace <workspace-id> --types task.completed
  timdo events --follow --interval 30 --include-text
  timdo events init --state-file ./private/events.json --after 0 --workspace <workspace-id>
  timdo --json events --state-file ./private/events.json > page.json
  timdo events ack --state-file ./private/events.json --from 0 --to <page-next>
EOF
}

EVENT_PUBLIC_TYPES_JSON='["bot.created","bot.disabled","bot.renamed","bot.role_changed","bot.token_created","bot.token_revoked","epic.completed","epic.created","epic.deleted","epic.moved","epic.status_changed","epic.updated","member.added","member.invited","member.joined","member.left","member.removed","member.role_changed","note.added","note.deleted","organisation.created","organisation.renamed","project.archived","project.created","project.moved","project.moved_out","project.renamed","project.unarchived","ref.added","ref.removed","task.assigned","task.completed","task.created","task.deleted","task.linked","task.merged","task.moved","task.moved_out","task.restored","task.status_changed","task.updated"]'

normalise_event_types() {
  local raw="$1" selected="$2" result
  if [[ "$selected" == false ]]; then
    printf '%s\n' "$EVENT_PUBLIC_TYPES_JSON"
    return
  fi
  if ! result=$(jq -cn --arg raw "$raw" --argjson public "$EVENT_PUBLIC_TYPES_JSON" '
    def expand($part):
      if ($part | endswith(".*")) then [$public[] | select(startswith($part[0:-1]))]
      elif ($public | index($part)) then [$part]
      else [] end;
    ($raw | split(",") | map(gsub("^[[:space:]]+|[[:space:]]+$"; ""))) as $parts
    | if any($parts[]; . == "") then error("empty event type")
      else [$parts[] as $part | expand($part) as $matches
        | if ($matches | length) == 0 then error("unknown event type") else $matches[] end]
        | unique | sort
      end' 2>/dev/null); then
    usage_die "Error: --types must be registered event types or a registered prefix such as task.*."
  fi
  printf '%s\n' "$result"
}

events_include_json() {
  jq -cn --argjson refs "$1" --argjson text "$2" \
    '[if $refs then "refs" else empty end, if $text then "text" else empty end] | sort'
}

events_validate_cursor() {
  local cursor="$1" allow_bootstrap="${2:-true}"
  if [[ "$allow_bootstrap" == true && ( "$cursor" == 0 || "$cursor" == latest ) ]]; then return 0; fi
  [[ ${#cursor} -ge 20 && ${#cursor} -le 2048 && "$cursor" =~ ^c1\.[A-Za-z0-9_-]+$ ]] \
    || usage_die "Error: cursor must be a bounded opaque events cursor."
}

events_validate_checkpoint_cursor() {
  local cursor="$1"
  [[ "$cursor" == 0 ]] && return 0
  events_validate_cursor "$cursor" false
}

events_state_helper() {
  local operation="$1" state_path="$2" payload="${3:-}"
  if [[ -n "$payload" ]]; then
    printf '%s' "$payload" | env -u TIMDO_TOKEN -u TIMDO_SECRET -u TIMDO_AS -u TIMDO_CONFIG \
      node "$TIMDO_SCRIPT_DIR/timdo-events-state.js" "$operation" "$state_path"
  else
    env -u TIMDO_TOKEN -u TIMDO_SECRET -u TIMDO_AS -u TIMDO_CONFIG \
      node "$TIMDO_SCRIPT_DIR/timdo-events-state.js" "$operation" "$state_path"
  fi
}

events_normalised_api() {
  local payload
  payload=$(jq -cn --arg api "$TIMDO_API" '{api:$api}')
  printf '%s' "$payload" | env -u TIMDO_TOKEN -u TIMDO_SECRET -u TIMDO_AS -u TIMDO_CONFIG \
    node "$TIMDO_SCRIPT_DIR/timdo-events-state.js" normalize-api
}

events_current_principal() {
  local me id
  me=$(api GET /users/me)
  id=$(jq -er 'if (.id | type) == "string" and (.id | length) > 0 then .id else error("missing id") end' <<< "$me" 2>/dev/null) \
    || die "Error: the authenticated account response has no principal id."
  printf '%s' "$id"
}

events_resolve_workspace() {
  local query="$1" org_id
  org_id=$(sharing_json | jq -er --arg q "$query" \
    '(([.[] | select(.id == $q)] | .[0].id) // ([.[] | select(.slug == $q)] | .[0].id) // empty)' 2>/dev/null) \
    || die "Not found: no accessible workspace has ID or slug \"$query\"."
  printf '%s' "$org_id"
}

events_page_path() {
  local after="$1" workspace="$2" types_json="$3" include_json="$4" limit="$5" send_types="$6" send_include="$7"
  local -a params=("after=$(urlencode "$after")")
  [[ -n "$workspace" ]] && params+=("workspace=$(urlencode "$workspace")")
  if [[ "$send_types" == true ]]; then
    params+=("types=$(urlencode "$(jq -r 'join(",")' <<< "$types_json")")")
  fi
  if [[ "$send_include" == true && "$(jq 'length' <<< "$include_json")" -gt 0 ]]; then
    params+=("include=$(urlencode "$(jq -r 'join(",")' <<< "$include_json")")")
  fi
  params+=("limit=$limit")
  printf '/events?%s' "$(IFS='&'; printf '%s' "${params[*]}")"
}

events_check_page() {
  jq -e 'type == "object" and .version == 1 and (.events | type == "array") and (.events | (all(.[]; type == "object" and (.id | type == "string") and (.id | length) > 0) and ((map(.id) | unique | length) == length))) and (.next | type == "string") and (.hasMore | type == "boolean")' \
    >/dev/null 2>&1 <<< "$1" || die "Error: the events API returned an invalid page envelope or unstable event IDs."
  events_validate_cursor "$(jq -r '.next' <<< "$1")" false
}

events_write_page() {
  local page="$1" following="$2" rendered
  events_check_page "$page"
  if ! is_text; then
    if [[ "$following" == true ]]; then
      rendered=$(jq -c '.' <<< "$page") || return 1
    else
      rendered=$(jq '.' <<< "$page") || return 1
    fi
  else
    rendered=$(jq -r '
      def safe: (. // "-") | tostring | gsub("[\\p{Cc}]"; " ");
      .events[] | [(.occurredAt // "time unavailable" | safe), (.type | safe),
        ("event " + (.id | safe)), ("task " + (.taskId | safe)),
        ("project " + (.projectId | safe)),
        ("actor " + ((.actor.kind // "unknown") | safe) + ":" + (.actor.id | safe)),
        ("via " + (.via | safe))] | join("  ")' <<< "$page") || return 1
    if [[ -z "$rendered" ]]; then
      [[ "$following" == true ]] && return 0
      rendered='No recorded events.'
    fi
  fi
  printf '%s\n' "$rendered" || return 1
}

events_follow_signal() {
  EVENT_STOP=1
  if [[ -n "${EVENT_STOP_FILE:-}" ]]; then : > "$EVENT_STOP_FILE" 2>/dev/null || true; fi
  if [[ -n "${EVENT_REQUEST_PID_FILE:-}" && -r "$EVENT_REQUEST_PID_FILE" ]]; then
    local request_pid=""
    IFS= read -r request_pid < "$EVENT_REQUEST_PID_FILE" || true
    rm -f "$EVENT_REQUEST_PID_FILE" 2>/dev/null || true
    if [[ "$request_pid" =~ ^[1-9][0-9]*$ ]]; then
      kill -TERM "$request_pid" 2>/dev/null || true
    fi
  fi
  if [[ -n "${EVENT_CHILD_PID:-}" ]]; then
    kill -TERM "$EVENT_CHILD_PID" 2>/dev/null || true
  fi
}

cmd_events() {
  local mode="read" after="0" after_set=false workspace="" workspace_set=false
  local types="" types_set=false include_refs=false include_refs_set=false include_text=false include_text_set=false
  local limit=100 limit_set=false follow=false interval=30 interval_set=false state_file=""
  local from_cursor="" from_set=false to_cursor="" to_set=false
  case "${1:-}" in
    init|ack) mode="$1"; shift ;;
  esac
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_events; return 0 ;;
      --after) need_value "$1" "${2:-}"; after="$2"; after_set=true; shift 2 ;;
      --after=*) after="${1#*=}"; after_set=true; shift ;;
      -w|--workspace) need_value "$1" "${2:-}"; workspace="$2"; workspace_set=true; shift 2 ;;
      --workspace=*) workspace="${1#*=}"; workspace_set=true; shift ;;
      --types) need_value "$1" "${2:-}"; types="$2"; types_set=true; shift 2 ;;
      --types=*) types="${1#*=}"; types_set=true; shift ;;
      --include-refs) include_refs=true; include_refs_set=true; shift ;;
      --include-text) include_text=true; include_text_set=true; shift ;;
      -n|--limit) need_value "$1" "${2:-}"; limit="$2"; limit_set=true; shift 2 ;;
      --limit=*) limit="${1#*=}"; limit_set=true; shift ;;
      --follow) follow=true; shift ;;
      --interval) need_value "$1" "${2:-}"; interval="$2"; interval_set=true; shift 2 ;;
      --interval=*) interval="${1#*=}"; interval_set=true; shift ;;
      --state-file) need_value "$1" "${2:-}"; state_file="$2"; shift 2 ;;
      --state-file=*) state_file="${1#*=}"; shift ;;
      --from) need_value "$1" "${2:-}"; from_cursor="$2"; from_set=true; shift 2 ;;
      --from=*) from_cursor="${1#*=}"; from_set=true; shift ;;
      --to) need_value "$1" "${2:-}"; to_cursor="$2"; to_set=true; shift 2 ;;
      --to=*) to_cursor="${1#*=}"; to_set=true; shift ;;
      *) usage_die "Unknown option for events: $1 (see: timdo events --help)" ;;
    esac
  done

  [[ "$limit" =~ ^[0-9]{1,3}$ ]] || usage_die "Error: --limit must be a whole number from 1 to 500."
  limit=$((10#$limit))
  (( limit >= 1 && limit <= 500 )) || usage_die "Error: --limit must be a whole number from 1 to 500."
  [[ "$interval" =~ ^[0-9]{1,4}$ ]] || usage_die "Error: --interval must be a whole number from 1 to 3600."
  interval=$((10#$interval))
  (( interval >= 1 && interval <= 3600 )) || usage_die "Error: --interval must be a whole number from 1 to 3600."

  local types_json include_json
  types_json=$(normalise_event_types "$types" "$types_set")
  include_json=$(events_include_json "$include_refs" "$include_text")

  if [[ "$mode" == "ack" ]]; then
    [[ -n "$state_file" && "$from_set" == true && "$to_set" == true ]] \
      || usage_die "Usage: timdo events ack --state-file PATH --from OLD --to NEXT"
    [[ "$after_set" == false && "$workspace_set" == false && "$types_set" == false && "$include_refs_set" == false && "$include_text_set" == false && "$limit_set" == false && "$follow" == false && "$interval_set" == false ]] \
      || usage_die "Error: events ack accepts only --state-file, --from and --to."
    events_validate_checkpoint_cursor "$from_cursor"
    events_validate_cursor "$to_cursor" false
    local ack_state api_base principal payload ack_result
    ack_state=$(events_state_helper read "$state_file")
    api_base=$(events_normalised_api)
    [[ "$(jq -r '.api' <<< "$ack_state")" == "$api_base" ]] \
      || die "Checkpoint API base does not match TIMDO_API."
    principal=$(events_current_principal)
    [[ "$(jq -r '.principal' <<< "$ack_state")" == "$principal" ]] \
      || die "Checkpoint principal does not match the current authenticated account."
    payload=$(jq -cn --arg from "$from_cursor" --arg to "$to_cursor" '{from:$from,to:$to}')
    ack_result=$(events_state_helper ack "$state_file" "$payload")
    if ! is_text; then jq '.' <<< "$ack_result"; else printf 'Acknowledged event checkpoint.\n'; fi
    return 0
  fi

  if [[ "$mode" == "init" ]]; then
    [[ -n "$state_file" && "$after_set" == true && ( "$after" == 0 || "$after" == latest ) ]] \
      || usage_die "Usage: timdo events init --state-file PATH --after 0|latest [scope and include options]"
    [[ "$follow" == false && "$from_set" == false && "$to_set" == false && "$interval_set" == false ]] \
      || usage_die "Error: events init does not accept follow, interval, from or to."
    if [[ -e "$state_file" || -L "$state_file" ]]; then
      die "Checkpoint already exists. Init never replaces a checkpoint."
    fi
  elif [[ "$mode" != "read" ]]; then
    usage_die "Unknown events operation: $mode. Use events, events init or events ack."
  fi

  [[ "$from_set" == false && "$to_set" == false ]] || usage_die "Error: --from and --to are only used by events ack."
  if [[ "$follow" == true && -n "$state_file" ]]; then
    usage_die "Error: --follow cannot be combined with --state-file."
  fi
  if [[ "$interval_set" == true && "$follow" != true ]]; then
    usage_die "Error: --interval requires --follow."
  fi
  if [[ "$follow" == true && ( "$from_set" == true || "$to_set" == true ) ]]; then
    usage_die "Error: --follow cannot be combined with acknowledgement options."
  fi
  if [[ "$follow" == true && "$interval_set" == false ]]; then interval=30; fi
  if [[ "$after_set" == true && "$mode" != "init" ]]; then
    events_validate_cursor "$after" true
  fi

  local api_base="" principal_id="" state="" query_workspace="" query_after="$after"
  local query_types="$types_json" query_include="$include_json" send_types="$types_set" send_include=false
  [[ "$(jq 'length' <<< "$include_json")" -gt 0 ]] && send_include=true

  if [[ "$mode" == "init" || -n "$state_file" ]]; then
    api_base=$(events_normalised_api)
  fi

  if [[ "$mode" == "init" ]]; then
    principal_id=$(events_current_principal)
    if [[ "$workspace_set" == true ]]; then query_workspace=$(events_resolve_workspace "$workspace"); fi
    if [[ "$after" == latest ]]; then
      local latest_path latest_page
      latest_path=$(events_page_path latest "$query_workspace" "$types_json" "$include_json" "$limit" "$send_types" "$send_include")
      latest_page=$(api GET "$latest_path")
      events_check_page "$latest_page"
      query_after=$(jq -r '.next' <<< "$latest_page")
    else
      query_after=0
    fi
    local state_payload init_result
    state_payload=$(jq -cn --arg api "$api_base" --arg principal "$principal_id" --arg workspace "$query_workspace" \
      --arg cursor "$query_after" --argjson types "$types_json" --argjson include "$include_json" \
      '{version:1,api:$api,principal:$principal,workspace:(if $workspace == "" then null else $workspace end),types:$types,include:$include,cursor:$cursor}')
    init_result=$(events_state_helper init "$state_file" "$state_payload")
    if ! is_text; then jq -cn --arg path "$state_file" --arg after "$after" '{initialized:true,stateFile:$path,after:$after}';
    else printf 'Created event checkpoint at %s.\n' "$state_file"; fi
    return 0
  fi

  if [[ -n "$state_file" ]]; then
    state=$(events_state_helper read "$state_file")
    [[ "$(jq -r '.api' <<< "$state")" == "$api_base" ]] \
      || die "Checkpoint API base does not match TIMDO_API."
    principal_id=$(events_current_principal)
    [[ "$(jq -r '.principal' <<< "$state")" == "$principal_id" ]] \
      || die "Checkpoint principal does not match the current authenticated account."
    local saved_workspace saved_types saved_include saved_cursor
    saved_workspace=$(jq -r '.workspace // ""' <<< "$state")
    saved_types=$(jq -c '.types' <<< "$state")
    saved_include=$(jq -c '.include' <<< "$state")
    saved_cursor=$(jq -r '.cursor' <<< "$state")
    if [[ "$after_set" == true && "$after" != "$saved_cursor" ]]; then
      die "Explicit --after conflicts with the checkpoint cursor."
    fi
    if [[ "$types_set" == true && "$types_json" != "$saved_types" ]]; then
      die "Explicit --types conflicts with the checkpoint filter."
    fi
    if [[ "$include_refs_set" == true || "$include_text_set" == true ]]; then
      [[ "$include_json" == "$saved_include" ]] || die "Explicit include options conflict with the checkpoint filter."
    fi
    if [[ "$workspace_set" == true ]]; then
      query_workspace=$(events_resolve_workspace "$workspace")
      [[ "$query_workspace" == "$saved_workspace" ]] || die "Explicit workspace conflicts with the checkpoint scope."
    else
      query_workspace="$saved_workspace"
    fi
    query_after="$saved_cursor"
    query_types="$saved_types"
    query_include="$saved_include"
    send_types=true
    [[ "$(jq 'length' <<< "$query_include")" -gt 0 ]] && send_include=true
  elif [[ "$workspace_set" == true ]]; then
    query_workspace=$(events_resolve_workspace "$workspace")
  fi

  if [[ "$follow" != true ]]; then
    local path page
    path=$(events_page_path "$query_after" "$query_workspace" "$query_types" "$query_include" "$limit" "$send_types" "$send_include")
    page=$(api GET "$path")
    events_write_page "$page" false || die "Error: could not write events output."
    return 0
  fi

  local EVENT_STOP=0 EVENT_CHILD_PID="" EVENT_REQUEST_PID_FILE="$TMPD/events-request.pid" EVENT_STOP_FILE="$TMPD/events-stop" EVENT_FOLLOW_ACTIVE=1
  trap 'events_follow_signal' INT TERM
  local current_after="$query_after" page_path page next has_more err_file page_file sleep_status
  err_file="$TMPD/events-api.err"
  page_file="$TMPD/events-page.json"
  while [[ "$EVENT_STOP" == 0 ]]; do
    while [[ "$EVENT_STOP" == 0 ]]; do
      page_path=$(events_page_path "$current_after" "$query_workspace" "$query_types" "$query_include" "$limit" "$send_types" "$send_include")
      if ! api GET "$page_path" >"$page_file" 2>"$err_file"; then
        if [[ "$EVENT_STOP" == 1 ]]; then break; fi
        cat "$err_file" >&2
        trap - INT TERM
        return 1
      fi
      [[ "$EVENT_STOP" == 1 ]] && break
      page=$(<"$page_file")
      if ! events_write_page "$page" true; then
        if [[ "$EVENT_STOP" == 1 ]]; then break; fi
        printf 'Error: could not write events output.\n' >&2
        trap - INT TERM
        return 1
      fi
      next=$(jq -r '.next' <<< "$page")
      has_more=$(jq -r '.hasMore' <<< "$page")
      if [[ "$has_more" == true && "$next" == "$current_after" ]]; then
        printf 'Error: events API cursor did not advance while more pages were available.\n' >&2
        trap - INT TERM
        return 1
      fi
      current_after="$next"
      [[ "$has_more" == true ]] || break
    done
    [[ "$EVENT_STOP" == 1 ]] && break
    sleep "$interval" &
    EVENT_CHILD_PID=$!
    [[ "$EVENT_STOP" == 1 ]] && kill -TERM "$EVENT_CHILD_PID" 2>/dev/null || true
    if wait "$EVENT_CHILD_PID"; then sleep_status=0; else sleep_status=$?; fi
    EVENT_CHILD_PID=""
    [[ "$EVENT_STOP" == 1 ]] && break
    if [[ "$sleep_status" != 0 ]]; then
      printf 'Error: event polling wait failed.\n' >&2
      trap - INT TERM
      return 1
    fi
  done
  trap - INT TERM
}

# ---------------------------------------------------------------------------
# activity
# ---------------------------------------------------------------------------
usage_activity() {
  cat <<'EOF'
Usage: timdo activity [--task <id>] [--epic <id|title>] [--project <name|KEY>] [--workspace <name>] [-n N]

Who did what, newest first, across everything you can see (default 20 entries).
  08 Oct 14:02  Robin Fairweather  Moved "Fix inverter" from Do to Done  [Acme Solar]
EOF
}

cmd_activity() {
  local task="" epic="" project="" workspace="" limit=20
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage_activity; exit 0 ;;
      --task|-t) task="$2"; shift 2 ;;
      --epic|-e) epic="$2"; shift 2 ;;
      --project|-p|--project-id) project="$2"; shift 2 ;;
      --workspace|-w) workspace="$2"; shift 2 ;;
      -n|--limit) limit="$2"; shift 2 ;;
      *) usage_die "Unknown option for activity: $1 (see: timdo activity --help)" ;;
    esac
  done
  [[ "$limit" =~ ^[0-9]+$ ]] || die "Error: -n must be a number."

  local params=("limit=$limit")
  [[ -n "$task" ]] && params+=("taskId=$(urlencode "$(resolve_task_id "$task")")")
  [[ -n "$epic" ]] && params+=("epicId=$(urlencode "$(resolve_epic_id "$epic")")")
  [[ -n "$project" ]] && params+=("projectId=$(urlencode "$(resolve_project "$project" | jq -r '.id')")")
  [[ -n "$workspace" ]] && params+=("orgId=$(urlencode "$(resolve_org "$workspace" | jq -r '.id')")")

  local raw
  raw=$(api GET "/activity?$(IFS='&'; echo "${params[*]}")")
  if ! is_text; then
    echo "$raw" | jq '.'
    return
  fi
  if [[ "$(echo "$raw" | jq 'length')" -eq 0 ]]; then
    echo "No activity yet."
    return
  fi
  echo "$raw" | jqt 'activity_lines | sub("^  "; "")'
}

# ---------------------------------------------------------------------------
# whoami
# ---------------------------------------------------------------------------
cmd_whoami() {
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help) echo "Usage: timdo whoami   Who the CLI is acting as, and your workspaces"; return ;;
      *) usage_die "Unknown option for whoami: $1" ;;
    esac
  fi
  local me
  me=$(api GET /users/me)
  if ! is_text; then
    echo "$me" | jq --arg as "$TIMDO_AS" --arg api "$TIMDO_API" '
      (if .kind == "bot" then del(.email) else . end)
      + {actingAs: (if $as == "" then null else $as end), api: $api}'
    return
  fi
  echo "$me" | jqt '((if .kind == "bot" then
      ((.name // "Bot") + " (bot in " + (.workspace.name // "unknown workspace") + ", " + (.workspace.role // "member") + ")")
    else ((.name // .email // "Unknown") + (if .email then " <" + .email + ">" else "" end)) end) | paint("bold"))
    + ("  id " + (.id // "") | paint("dim"))'
  if [[ -n "$TIMDO_TOKEN" ]]; then
    if [[ "$(echo "$me" | jq -r '.kind // "human"')" == "bot" ]]; then
      echo "  Signed in with a bot token."
    else
      echo "  Signed in with a personal token (${TIMDO_TOKEN:0:10}...)."
    fi
  elif [[ -n "$TIMDO_AS" ]]; then
    echo "  Acting as $TIMDO_AS (X-Timdo-User), via the internal secret."
  else
    echo "  Signed in with the owner secret."
  fi
  echo "  API: $TIMDO_API"
  local orgs
  orgs=$( (api GET /organisations 2>/dev/null) || echo '[]')
  echo "$orgs" | jqt 'if length > 0 then "  Workspaces: " + ([.[] | "\(.name) (\(.role)\(if .isPersonal then ", personal" elif (.memberCount // 1) > 1 then ", \(.memberCount) members" else "" end))"] | join("; ")) else empty end'
}

# ---------------------------------------------------------------------------
# login / logout (personal and bot access tokens)
# ---------------------------------------------------------------------------
config_set_token() {
  local token="$1" dir tmp
  dir=$(dirname "$TIMDO_CONFIG")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.config.XXXXXX")
  chmod 600 "$tmp"
  if [[ -f "$TIMDO_CONFIG" ]]; then
    grep -v '^TIMDO_TOKEN=' "$TIMDO_CONFIG" > "$tmp" || true
  fi
  if [[ -n "$token" ]]; then
    printf 'TIMDO_TOKEN=%q\n' "$token" >> "$tmp"
  fi
  mv "$tmp" "$TIMDO_CONFIG"
}

usage_login() {
  cat <<USAGE
Usage: timdo login              paste the token when asked (it isn't shown on screen)
       timdo login --token-stdin  read it from stdin, for scripts: pass-tool | timdo login --token-stdin

Saves a personal or bot access token so the CLI (and the TimDo MCP server) act as that account.
Create a personal token in the web app: $APP_URL/settings/access
Issue a bot token with: timdo bot token <workspace> <bot>
The token is stored in $TIMDO_CONFIG, readable only by you. Avoid putting a token on a
command line: it ends up in your shell history.
USAGE
}

cmd_login() {
  local token=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --token-stdin) IFS= read -r token || true; shift ;;
      --token) token="${2:-}"; shift 2
        echo "Note: --token leaves the token in your shell history. Next time run 'timdo login' and paste it." >&2 ;;
      --token=*) token="${1#--token=}"; shift ;;
      -h|--help) usage_login; return ;;
      *) usage_die "Unknown option for login: $1" ;;
    esac
  done
  if [[ -z "$token" ]]; then
    echo "Create a token at $APP_URL/settings/access, then paste it here."
    read -r -s -p "Token: " token
    echo
  fi
  token="$(printf '%s' "$token" | tr -d '[:space:]')"
  [[ "$token" =~ ^tdo_[A-Za-z0-9_-]{30,80}$ ]] || die "That doesn't look like a TimDo token (they start with tdo_)."

  # Check it works before saving it
  local me
  TIMDO_TOKEN="$token"
  TIMDO_AS=""
  me=$(api GET /users/me)
  config_set_token "$token"
  echo "$me" | jqt 'if .kind == "bot" then "Logged in as " + (.name // "Bot") + " (bot in " + (.workspace.name // "unknown workspace") + ", " + (.workspace.role // "member") + ")." else "Logged in as " + (.name // .email) + (if .email then " <" + .email + ">" else "" end) + "." end'
  echo "Saved to $TIMDO_CONFIG. Try: timdo list do --mine"
}

cmd_logout() {
  if [[ -f "$TIMDO_CONFIG" ]] && grep -q '^TIMDO_TOKEN=' "$TIMDO_CONFIG"; then
    config_set_token ""
    echo "Logged out: removed the token from $TIMDO_CONFIG."
    echo "To stop it working everywhere, revoke it at $APP_URL/settings/access."
  else
    echo "No saved token in $TIMDO_CONFIG."
  fi
}

# ---------------------------------------------------------------------------
# workspaces and sharing
# ---------------------------------------------------------------------------
usage_workspace() {
  cat <<'EOF'
Usage: timdo workspace <subcommand> ...      (aliases: ws, org)

A workspace holds projects; everyone in it sees every project, epic, task, note
and activity entry inside. Roles: owner (everything), admin (members, viewers,
projects), member (works on tasks, epics, notes), viewer (read-only).
Life goals stay private to each person.

  list                                   Your workspaces, your role, members and projects
  show <workspace>                       Members and roles, projects with counts, pending invites
  members <workspace>                    Just the members
  create <name>                          New shared workspace (you are owner)
  rename <workspace> <new name>
  share <workspace> <email> [--role member|viewer|admin]
                                         Add someone, or invite them if they have no account yet
  role <workspace> <email|name> <owner|admin|member|viewer>
  remove <workspace> <email|name> [--yes]
  revoke <workspace> <email>             Cancel a pending invite
  leave <workspace> [--yes]
  add-project <workspace> <name> [-d "description"]
  move-project <project> <workspace> --yes
                                         Move a project, its epics and tasks (history kept).
                                         Needs owner/admin on the source and edit rights on the target.
  accept <token>                         Accept an invite token

<workspace> is a name, "personal", an id or id prefix. <project> is a name,
a key such as ASX, or "Workspace/Project".

Examples:
  timdo ws list
  timdo ws show "Northstar Workshop"
  timdo ws share "Northstar Workshop" robin@example.com --role viewer
  timdo ws move-project Acme Solar "Northstar Workshop" --yes
EOF
}

print_share_result() {
  local res="$1" ws_name="$2"
  if ! is_text; then
    echo "$res" | jq --arg app "$APP_URL" 'if .status == "invited" and .token then . + {inviteUrl: "\($app)/invite/\(.token)"} else . end'
    return
  fi
  echo "$res" | jqt '
    if .status == "added" then "\(c("green"))Added\(c("reset")) \(.name // .email) <\(.email)> to \"\($ws)\" as \(.role). They can see it now."
    elif .status == "already_member" then "\(.name // .email // $email) is already a member of \"\($ws)\"\(if .role then " (" + .role + ")" else "" end). Nothing changed."
    elif .status == "invited" then
      "\(c("green"))Invited\(c("reset")) \(.email) to \"\($ws)\" as \(.role). They join automatically when they first sign in with that email.",
      "  Invite link: \($app)/invite/\(.token)",
      (if .expiresAt then "  Expires: \(.expiresAt | day)" else empty end)
    elif .success == true then "Invitation sent to \(.email // $email) for \"\($ws)\" with role \(.role // "member")."
    else tostring end' --arg ws "$ws_name" --arg app "$APP_URL" --arg email "${3:-}"
}

cmd_workspace() {
  local subcmd="${1:-list}"
  shift || true

  case "$subcmd" in
    -h|--help|help) usage_workspace ;;

    list|ls)
      local raw
      raw=$(api GET /organisations)
      if ! is_text; then
        echo "$raw" | jq '.'
        return
      fi
      if [[ "$(echo "$raw" | jq 'length')" -eq 0 ]]; then
        echo "No workspaces."
        return
      fi
      echo "$raw" | jqt '
        (maxlen(.name) | [., 9] | max) as $w
        | ("  " + ("WORKSPACE" | pad($w)) + "  ROLE    MEMBERS  PROJECTS  TYPE" | paint("dim")),
          (.[] | "  " + (.name | pad($w) | paint("bold"))
            + "  " + ((.role // "member") | pad(6))
            + "  " + ("\(.memberCount // "?")" | lpad(7))
            + "  " + ("\(.projectCount // "?")" | lpad(8))
            + "  " + (if .isPersonal == true then ("personal" | pad(8) | paint("dim")) elif (.memberCount // 1) > 1 then ("shared" | pad(8) | paint("cyan")) else ("private" | pad(8)) end)
            + ("  id " + (.id // "") | paint("dim")))'
      ;;

    show|get|info)
      local q="${1:-}"
      [[ -z "$q" ]] && usage_die "Usage: timdo workspace show <workspace>"
      local org
      org=$(resolve_org "$q")
      if ! is_text; then
        echo "$org" | jq '.'
        return
      fi
      echo "$org" | jqt '
        (.name | paint("bold")) + "  " + ("id \(.id)" | paint("dim")),
        "  Your role: \(.role // "?")" + (if .isPersonal == true then "   (personal workspace)" else "" end),
        "",
        ("Members (\(.members | length))" | paint("bold")),
        ((.members | maxlen(.userName // .name // "")) as $nw | (.members | maxlen(.userEmail // .email // "")) as $ew
          | .members | sort_by(({"owner":0,"admin":1,"member":2,"viewer":3}[.role] // 9), (.userName // "")) | .[]
          | .role as $role
          | "  " + ((.userName // .name // "") | pad($nw)) + "  " + ((.userEmail // .email // "") | pad($ew) | paint("dim"))
            + "  " + ($role | pad(6) | paint(if $role == "viewer" then "yellow" else "green" end)) + (if .isMe == true then "  (you)" else "" end)),
        "",
        ("Projects (\(.projects | length))" | paint("bold")),
        (if (.projects | length) == 0 then "  (none)" else
          ((.projects | maxlen(.name)) as $pw
           | .projects[] | "  " + ((.key // "") | pad(4) | paint("cyan")) + "  " + (.name | pad($pw))
             + "  " + ("\(.openTasks // 0) open" | lpad(8)) + "  " + ("\(.doneTasks // 0) done" | lpad(8))
             + "  " + ("\(.epicCount // 0) epics" | lpad(8)) + (if .isArchived == true then "  archived" else "" end))
         end),
        (if ((.invites // []) | length) > 0 then
          "", ("Pending invites (\(.invites | length))" | paint("bold")),
          ((.invites | maxlen(.email)) as $iw | .invites[] | "  " + (.email | pad($iw)) + "  " + (.role | pad(6)) + "  expires \(.expiresAt | day)  " + ("\($app)/invite/\(.token)" | paint("dim")))
         else empty end)
      ' --arg app "$APP_URL"
      ;;

    members)
      local q="${1:-}"
      [[ -z "$q" ]] && usage_die "Usage: timdo workspace members <workspace>"
      local org org_id raw
      org=$( (resolve_org "$q") 2>/dev/null || true)
      if [[ -n "$org" ]]; then
        org_id=$(echo "$org" | jq -r '.id')
      else
        # Fall back to the plain workspace list (older APIs have no /organisations/sharing)
        org_id=$(api GET /organisations | jq -r --arg q "$q" '[.[] | select(.id == $q or (.id | startswith($q)) or ((.name // "") | ascii_downcase) == ($q | ascii_downcase))][0].id // empty')
        [[ -z "$org_id" ]] && org_id="$q"
      fi
      raw=$(api GET "/organisations/$org_id/members")
      if ! is_text; then
        echo "$raw" | jq '.'
        return
      fi
      echo "$raw" | jqt '(maxlen(.userName // .name // "")) as $nw | (maxlen(.userEmail // .email // "")) as $ew | .[]
        | "  " + ((.userName // .name // "") | pad($nw)) + "  " + ("<\(.userEmail // .email // "")>" | pad($ew + 2)) + "  " + (.role // "member")'
      ;;

    create|new)
      local name="${1:-}"
      [[ -z "$name" ]] && usage_die "Usage: timdo workspace create <name>"
      local res
      res=$(api POST /organisations -d "$(jq -n --arg n "$name" '{name: $n}')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Created${R} workspace \"$(echo "$res" | jq -r '.name')\" ($(echo "$res" | jq -r '.id[0:8]')). You are the owner."
      echo "  Next: timdo ws add-project \"$name\" <project>   or   timdo ws move-project <project> \"$name\" --yes"
      echo "        timdo ws share \"$name\" <email>"
      ;;

    rename)
      local q="${1:-}" new_name="${2:-}"
      [[ -z "$q" || -z "$new_name" ]] && usage_die "Usage: timdo workspace rename <workspace> <new name>"
      local org_id res
      org_id=$(resolve_org "$q" | jq -r '.id')
      res=$(api PUT "/organisations/$org_id" -d "$(jq -n --arg n "$new_name" '{name: $n}')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Renamed${R} workspace to \"$new_name\"."
      ;;

    share|invite)
      local q="${1:-}" email="${2:-}" role="member"
      shift 2 || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --role|-r) role="$2"; shift 2 ;;
          *) usage_die "Unknown option for workspace share: $1" ;;
        esac
      done
      [[ -z "$q" || -z "$email" ]] && usage_die "Usage: timdo workspace share <workspace> <email> [--role member|viewer|admin]"
      case "$role" in admin|member|viewer) ;; *) usage_die "Error: --role must be admin, member or viewer (owners are set with: timdo ws role)." ;; esac
      local org org_id ws_name
      org=$( (resolve_org "$q") 2>/dev/null || true)
      if [[ -n "$org" ]]; then
        org_id=$(echo "$org" | jq -r '.id'); ws_name=$(echo "$org" | jq -r '.name')
      else
        org_id=$(api GET /organisations | jq -r --arg q "$q" '[.[] | select(.id == $q or (.id | startswith($q)) or ((.name // "") | ascii_downcase) == ($q | ascii_downcase))][0].id // empty')
        [[ -z "$org_id" ]] && die "Not found: no workspace called \"$q\"."
        ws_name="$q"
      fi
      local res
      res=$(api POST "/organisations/$org_id/invites" -d "$(jq -n --arg e "$email" --arg r "$role" '{email: $e, role: $r}')")
      print_share_result "$res" "$ws_name" "$email"
      ;;

    role)
      local q="${1:-}" who="${2:-}" role="${3:-}"
      [[ -z "$q" || -z "$who" || -z "$role" ]] && usage_die "Usage: timdo workspace role <workspace> <email|name> <owner|admin|member|viewer>"
      case "$role" in owner|admin|member|viewer) ;; *) usage_die "Error: role must be owner, admin, member or viewer." ;; esac
      local org member user_id res
      org=$(resolve_org "$q")
      member=$(resolve_member "$org" "$who")
      user_id=$(echo "$member" | jq -r '.userId')
      res=$(api PUT "/organisations/$(echo "$org" | jq -r '.id')/members/$(urlencode "$user_id")" -d "$(jq -n --arg r "$role" '{role: $r}')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Updated${R} $(echo "$member" | jq -r '.userName // .userEmail') in \"$(echo "$org" | jq -r '.name')\": $(echo "$member" | jq -r '.role') -> $role."
      ;;

    remove|kick)
      local q="${1:-}" who="${2:-}" yes=false
      shift 2 || true
      while [[ $# -gt 0 ]]; do
        case "$1" in -y|--yes) yes=true; shift ;; *) usage_die "Unknown option for workspace remove: $1" ;; esac
      done
      [[ -z "$q" || -z "$who" ]] && usage_die "Usage: timdo workspace remove <workspace> <email|name> [--yes]"
      local org member org_name member_name
      org=$(resolve_org "$q")
      member=$(resolve_member "$org" "$who")
      org_name=$(echo "$org" | jq -r '.name'); member_name=$(echo "$member" | jq -r '.userName // .userEmail')
      [[ "$(echo "$member" | jq -r '.isMe')" == "true" ]] && die "Error: that is you. Use: timdo workspace leave \"$org_name\""
      confirm_or_exit "Remove $member_name from \"$org_name\"? They will lose access to its projects." "$yes"
      local res
      res=$(api DELETE "/organisations/$(echo "$org" | jq -r '.id')/members/$(urlencode "$(echo "$member" | jq -r '.userId')")")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Removed${R} $member_name from \"$org_name\". Tasks assigned to them stay put; reassign them if needed."
      ;;

    leave)
      local q="${1:-}" yes=false
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in -y|--yes) yes=true; shift ;; *) usage_die "Unknown option for workspace leave: $1" ;; esac
      done
      [[ -z "$q" ]] && usage_die "Usage: timdo workspace leave <workspace> [--yes]"
      local org org_name me
      org=$(resolve_org "$q")
      org_name=$(echo "$org" | jq -r '.name')
      [[ "$(echo "$org" | jq -r '.isPersonal')" == "true" ]] && die "Error: you cannot leave your personal workspace."
      me=$(my_id)
      confirm_or_exit "Leave \"$org_name\"? You will lose access to its projects." "$yes"
      local res
      res=$(api DELETE "/organisations/$(echo "$org" | jq -r '.id')/members/$(urlencode "$me")")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Left${R} \"$org_name\"."
      ;;

    revoke)
      local q="${1:-}" email="${2:-}"
      [[ -z "$q" || -z "$email" ]] && usage_die "Usage: timdo workspace revoke <workspace> <email>"
      local org invite
      org=$(resolve_org "$q")
      invite=$(echo "$org" | jq --arg e "$(lower "$email")" '[(.invites // [])[] | select((.email // "") | ascii_downcase == $e)][0] // empty')
      [[ -z "$invite" ]] && die "Not found: no pending invite for $email in \"$(echo "$org" | jq -r '.name')\"."
      local res
      res=$(api DELETE "/organisations/$(echo "$org" | jq -r '.id')/invites/$(echo "$invite" | jq -r '.id')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Revoked${R} the invite for $email to \"$(echo "$org" | jq -r '.name')\"."
      ;;

    add-project)
      local q="${1:-}" name="${2:-}" description=""
      shift 2 || true
      while [[ $# -gt 0 ]]; do
        case "$1" in -d|--description) description="$2"; shift 2 ;; *) usage_die "Unknown option for workspace add-project: $1" ;; esac
      done
      [[ -z "$q" || -z "$name" ]] && usage_die "Usage: timdo workspace add-project <workspace> <name> [-d \"description\"]"
      local org res
      org=$(resolve_org "$q")
      res=$(api POST "/organisations/$(echo "$org" | jq -r '.id')/projects" \
        -d "$(jq -n --arg n "$name" --arg d "$description" '{name: $n} + (if $d == "" then {} else {description: $d} end)')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Added${R} project \"$name\"$(echo "$res" | jq -r 'if .key then " (\(.key))" else "" end') to \"$(echo "$org" | jq -r '.name')\"."
      ;;

    move-project)
      local pq="${1:-}" q="${2:-}" yes=false
      shift 2 || true
      while [[ $# -gt 0 ]]; do
        case "$1" in -y|--yes) yes=true; shift ;; *) usage_die "Unknown option for workspace move-project: $1" ;; esac
      done
      [[ -z "$pq" || -z "$q" ]] && usage_die "Usage: timdo workspace move-project <project> <workspace> --yes"
      local proj dest proj_name src_name dest_name
      proj=$(resolve_project "$pq")
      dest=$(resolve_org "$q")
      proj_name=$(echo "$proj" | jq -r '.name'); src_name=$(echo "$proj" | jq -r '.orgName'); dest_name=$(echo "$dest" | jq -r '.name')
      if [[ "$(echo "$proj" | jq -r '.orgId')" == "$(echo "$dest" | jq -r '.id')" ]]; then
        die "Error: \"$proj_name\" is already in \"$dest_name\"."
      fi
      local dest_members
      dest_members=$(echo "$dest" | jq -r '[.members[] | .userName // .userEmail] | join(", ")')
      if [[ "$yes" != true ]]; then
        echo "Move project \"$proj_name\" ($(echo "$proj" | jq -r '.openTasks // 0') open, $(echo "$proj" | jq -r '.doneTasks // 0') done, $(echo "$proj" | jq -r '.epicCount // 0') epics)"
        echo "  from \"$src_name\" to \"$dest_name\"."
        echo "  Afterwards these people can see it: $dest_members"
      fi
      confirm_or_exit "Move it?" "$yes"
      local res
      res=$(api PUT "/organisations/$(echo "$proj" | jq -r '.orgId')/projects/$(echo "$proj" | jq -r '.id')" \
        -d "$(jq -n --arg o "$(echo "$dest" | jq -r '.id')" '{orgId: $o}')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Moved${R} \"$proj_name\" from \"$src_name\" to \"$dest_name\". Visible to: $dest_members"
      ;;

    accept)
      local token="${1:-}"
      [[ -z "$token" ]] && usage_die "Usage: timdo workspace accept <token>"
      token="${token##*/invite/}"
      local res
      res=$(api POST /organisations/invites/accept -d "$(jq -n --arg t "$token" '{token: $t}')")
      if ! is_text; then echo "$res" | jq '.'; return; fi
      echo "${GRN}Joined${R} $(echo "$res" | jq -r '.name // .orgName // "the workspace"')."
      ;;

    *)
      usage_die "Unknown workspace subcommand: $subcmd (see: timdo workspace --help)"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# workspace bots
# ---------------------------------------------------------------------------
usage_bot() {
  cat <<'EOF'
Usage: timdo bot <list|create|rename|role|token|revoke-token|disable> ...

Manage workspace bot identities and their credentials. Only a workspace owner or
admin can do this. New tokens are shown once and cannot be recovered.

  timdo bot list <workspace>
  timdo bot create <workspace> "<name>" [--role member|viewer] [--token-name name]
  timdo bot rename <workspace> <bot> "<name>"
  timdo bot role <workspace> <bot> member|viewer
  timdo bot token <workspace> <bot> [--name name]
  timdo bot revoke-token <workspace> <bot> <token-id|prefix|name> [--yes]
  timdo bot disable <workspace> <bot> [--yes]

<workspace> resolves by a unique name, slug, or id prefix. <bot> resolves by a
unique name or id prefix. Token revocation accepts a unique name or id prefix.
Duplicate matches are errors. Use -- before positional values that start with a dash.
Revoke and disable need an interactive confirmation or --yes; a pipe is not approval.

--owner-secret is available only on these bot commands. It deliberately selects
TIMDO_SECRET even when a personal token is configured. It never retries a token denial.

Examples:
  timdo bot list "Northstar Workshop"
  timdo bot create "Northstar Workshop" "Forum watcher" --role viewer
  timdo bot token "Northstar Workshop" "Forum watcher" --name "Nightly check"
  timdo bot disable "Northstar Workshop" "Forum watcher" --yes
EOF
}

resolve_bot_workspace() {
  local q="$1" orgs found count names
  orgs=$(sharing_json)
  found=$(echo "$orgs" | jq --arg q "$q" '
    ($q | ascii_downcase) as $l
    | [.[] | select(
        .id == $q or ((.id // "") | ascii_downcase | startswith($l))
        or ((.name // "") | ascii_downcase == $l)
        or ((.name // "") | ascii_downcase | startswith($l))
        or ((.slug // "") | ascii_downcase == $l)
      )] | unique_by(.id)')
  count=$(echo "$found" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    names=$(echo "$orgs" | jq -r '[.[].name] | unique | join(", ")')
    die "Not found: no workspace called \"$q\". Your workspaces: $names"
  fi
  if [[ "$count" -gt 1 ]]; then
    die "Ambiguous workspace \"$q\": $(echo "$found" | jq -r '[.[] | "\(.name) (\(.id[0:8]))"] | join(", ")'). Use a longer name or id prefix."
  fi
  echo "$found" | jq -c '.[0]'
}

resolve_bot_record() {
  local items="$1" q="$2" found count matches
  found=$(jq -c --arg q "$q" '
    ($q | ascii_downcase) as $l
    | [.[] | select(
        ((.id // "") | ascii_downcase == $l)
        or ((.id // "") | ascii_downcase | startswith($l))
        or ((.name // "") | ascii_downcase == $l)
        or ((.name // "") | ascii_downcase | startswith($l))
      )] | unique_by(.id)' <<< "$items")
  count=$(echo "$found" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    die "Not found: no bot called or identified by \"$q\"."
  fi
  if [[ "$count" -gt 1 ]]; then
    matches=$(echo "$found" | jq -r '[.[] | "\(.name) (\(.id))"] | join(", ")')
    die "Ambiguous bot \"$q\": $matches. Use a longer name or id prefix."
  fi
  echo "$found" | jq -c '.[0]'
}

resolve_bot_token() {
  local tokens="$1" q="$2" found count matches
  found=$(jq -c --arg q "$q" '
    ($q | ascii_downcase) as $l
    | [.[] | select(
        ((.id // "") | ascii_downcase == $l)
        or ((.id // "") | ascii_downcase | startswith($l))
        or ((.name // "") | ascii_downcase == $l)
        or ((.name // "") | ascii_downcase | startswith($l))
      )] | unique_by(.id)' <<< "$tokens")
  count=$(echo "$found" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    die "Not found: no active token called or identified by \"$q\"."
  fi
  if [[ "$count" -gt 1 ]]; then
    matches=$(echo "$found" | jq -r '[.[] | "\(.name) (\(.id))"] | join(", ")')
    die "Ambiguous token \"$q\": $matches. Use a longer name or id prefix."
  fi
  echo "$found" | jq -c '.[0]'
}

bot_parse_arguments() {
  local mode="$1"
  shift
  BOT_POSITIONALS=()
  BOT_ROLE_ARG=""
  BOT_TOKEN_NAME_ARG=""
  BOT_NAME_ARG=""
  BOT_CREATE_NAME_ARG=""
  BOT_ASSUME_YES=false
  local parse_options=true
  while [[ $# -gt 0 ]]; do
    if [[ "$parse_options" == true && "$1" == "--" ]]; then
      parse_options=false
      shift
      continue
    fi
    if [[ "$parse_options" == false ]]; then
      BOT_POSITIONALS+=("$1")
      shift
      continue
    fi
    case "$1" in
      -h|--help) usage_bot; exit 0 ;;
      --role)
        [[ "$mode" == create ]] || usage_die "Error: --role is only used by bot create."
        [[ $# -ge 2 && -n "$2" ]] || usage_die "Error: --role needs member or viewer."
        BOT_ROLE_ARG="$2"; shift 2 ;;
      --token-name)
        [[ "$mode" == create ]] || usage_die "Error: --token-name is only used by bot create."
        [[ $# -ge 2 && -n "$2" ]] || usage_die "Error: --token-name needs a name."
        BOT_TOKEN_NAME_ARG="$2"; shift 2 ;;
      --name)
        [[ "$mode" == create || "$mode" == token ]] || usage_die "Error: --name is only used by bot create or token."
        [[ $# -ge 2 && -n "$2" ]] || usage_die "Error: --name needs a name."
        if [[ "$mode" == create ]]; then BOT_CREATE_NAME_ARG="$2"; else BOT_NAME_ARG="$2"; fi
        shift 2 ;;
      -y|--yes)
        [[ "$mode" == revoke-token || "$mode" == disable ]] || usage_die "Error: --yes is only used by bot revoke-token and disable."
        BOT_ASSUME_YES=true; shift ;;
      --owner-secret)
        usage_die "Error: --owner-secret must appear with the bot command, before -- positional data."
        ;;
      -*) usage_die "Unknown option for bot $mode: $1 (see: timdo bot --help)" ;;
      *) BOT_POSITIONALS+=("$1"); shift ;;
    esac
  done
}

confirm_bot_or_exit() {
  local prompt="$1" assume_yes="$2"
  [[ "$assume_yes" == true ]] && return 0
  if [[ -t 0 && -t 1 ]]; then
    local answer=""
    read -r -p "$prompt [y/N] " answer || true
    if [[ "$answer" =~ ^[Yy] ]]; then return 0; fi
    if text_out; then echo "Cancelled. Nothing changed."; else echo '{"cancelled":true,"changed":false}'; fi
    exit 0
  fi
  die "Nothing changed. Re-run with --yes to confirm."
}

bot_json_result() {
  local result="$1"
  if [[ -z "$result" ]]; then echo '{"success":true}'; else echo "$result" | jq '.'; fi
}

bot_summary() {
  echo "$1" | jqt '(.name // "Unnamed bot") + " (" + ((.id // "")[0:8]) + ") in \"" + $workspace + "\" as " + (.role // "disabled")' --arg workspace "$2"
}

cmd_bot() {
  local -a remaining=()
  local owner_flag=false parse_owner=true
  while [[ $# -gt 0 ]]; do
    if [[ "$parse_owner" == true && "$1" == "--" ]]; then
      parse_owner=false
      remaining+=("$1")
    elif [[ "$parse_owner" == true && ( "$1" == "--role" || "$1" == "--token-name" || "$1" == "--name" ) ]]; then
      remaining+=("$1")
      shift
      if [[ $# -gt 0 ]]; then remaining+=("$1"); fi
    elif [[ "$parse_owner" == true && "$1" == "--owner-secret" ]]; then
      [[ "$owner_flag" == false ]] || usage_die "Error: use --owner-secret once."
      owner_flag=true
    else
      remaining+=("$1")
    fi
    shift
  done
  BOT_OWNER_SECRET_SELECTED="$owner_flag"
  set -- "${remaining[@]}"

  local subcmd="${1:-list}"
  shift || true
  case "$subcmd" in
    -h|--help|help) usage_bot; return ;;
    list|create|rename|role|token|revoke-token|disable) ;;
    *) usage_die "Unknown bot subcommand: $subcmd (see: timdo bot --help)" ;;
  esac
  bot_parse_arguments "$subcmd" "$@"
  local count="${#BOT_POSITIONALS[@]}"
  local expected=0
  case "$subcmd" in
    list) expected=1 ;;
    create) if [[ -n "$BOT_CREATE_NAME_ARG" ]]; then expected=1; else expected=2; fi ;;
    token|disable) expected=2 ;;
    rename|role|revoke-token) expected=3 ;;
  esac
  [[ "$count" -eq "$expected" ]] || usage_die "Usage: timdo bot $subcmd ... (see: timdo bot --help)"

  local org org_id org_name base bots bot bot_id bot_name result body token_name token_value create_name
  org=$(resolve_bot_workspace "${BOT_POSITIONALS[0]}")
  org_id=$(echo "$org" | jq -r '.id')
  org_name=$(echo "$org" | jq -r '.name')
  base="/organisations/$(urlencode "$org_id")/bots"

  case "$subcmd" in
    list)
      bots=$(api GET "$base")
      jq -e 'type == "array"' >/dev/null <<< "$bots" || die "Error: bot list response was not an array."
      if ! text_out; then echo "$bots" | jq '.'; return; fi
      if [[ "$(echo "$bots" | jq 'length')" -eq 0 ]]; then echo "No bots in \"$org_name\"."; return; fi
      echo "$bots" | jqt 'maxlen(.name // "") as $nw | .[]
        | "  " + ((.name // "Unnamed bot") | pad($nw) | paint("bold"))
          + "  " + ((.id // "")[0:8] | paint("dim"))
          + "  " + ((.role // "disabled") | pad(8))
          + "  " + (if .disabledAt then "disabled" else "active" end)
          + "  " + ((.tokens // [] | length) | tostring) + " active token(s)"'
      ;;

    create)
      case "$BOT_ROLE_ARG" in ""|member|viewer) ;; *) die "Error: --role must be member or viewer." ;; esac
      create_name="${BOT_CREATE_NAME_ARG:-${BOT_POSITIONALS[1]:-}}"
      body=$(jq -n --arg name "$create_name" --arg role "$BOT_ROLE_ARG" --arg tokenName "$BOT_TOKEN_NAME_ARG" \
        '{name: $name} + (if $role == "" then {} else {role: $role} end) + (if $tokenName == "" then {} else {tokenName: $tokenName} end)')
      result=$(api POST "$base" -d "$body")
      echo "This response contains a one-time token. Store it now; it cannot be recovered. If it is lost, revoke it and issue another." >&2
      if text_out; then
        bot=$(echo "$result" | jq -c '.bot')
        token_value=$(echo "$result" | jq -r '.token')
        echo "Created bot $(echo "$bot" | jqt '"\\(.name)"') in \"$org_name\" as $(echo "$bot" | jq -r '.role // "disabled"')."
        echo "Bot ID: $(echo "$bot" | jq -r '.id')"
        echo "One-time token: $token_value"
      else
        echo "$result" | jq '.'
      fi
      ;;

    rename|role|token|revoke-token|disable)
      bots=$(api GET "$base")
      bot=$(resolve_bot_record "$bots" "${BOT_POSITIONALS[1]}")
      bot_id=$(echo "$bot" | jq -r '.id')
      bot_name=$(echo "$bot" | jq -r '.name')
      local bot_path="$base/$(urlencode "$bot_id")"
      case "$subcmd" in
        rename)
          result=$(api PUT "$bot_path" -d "$(jq -n --arg name "${BOT_POSITIONALS[2]}" '{name: $name}')")
          if text_out; then echo "Renamed bot in \"$org_name\": $(bot_summary "$result" "$org_name")."; else echo "$result" | jq '.'; fi
          ;;
        role)
          case "${BOT_POSITIONALS[2]}" in member|viewer) ;; *) die "Error: bot role must be member or viewer." ;; esac
          result=$(api PUT "$bot_path" -d "$(jq -n --arg role "${BOT_POSITIONALS[2]}" '{role: $role}')")
          if text_out; then echo "Updated bot role in \"$org_name\": $(bot_summary "$result" "$org_name")."; else echo "$result" | jq '.'; fi
          ;;
        token)
          token_name="${BOT_NAME_ARG:-CLI token}"
          result=$(api POST "$bot_path/tokens" -d "$(jq -n --arg name "$token_name" '{name: $name}')")
          echo "This response contains a one-time token. Store it now; it cannot be recovered. If it is lost, revoke it and issue another." >&2
          if text_out; then
            token_value=$(echo "$result" | jq -r '.token')
            echo "Issued a replacement token for bot \"$bot_name\" in \"$org_name\"."
            echo "Token ID: $(echo "$result" | jq -r '.id')"
            echo "One-time token: $token_value"
          else
            echo "$result" | jq '.'
          fi
          ;;
        revoke-token)
          local tokens token token_id token_label
          tokens=$(echo "$bot" | jq -c '.tokens // []')
          token=$(resolve_bot_token "$tokens" "${BOT_POSITIONALS[2]}")
          token_id=$(echo "$token" | jq -r '.id')
          token_label="${token_id:0:12}"
          confirm_bot_or_exit "Revoke token $token_label from bot \"$bot_name\" in \"$org_name\"?" "$BOT_ASSUME_YES"
          result=$(api DELETE "$bot_path/tokens/$(urlencode "$token_id")")
          if text_out; then echo "Revoked token $token_label from bot \"$bot_name\" in \"$org_name\"."; else bot_json_result "$result"; fi
          ;;
        disable)
          confirm_bot_or_exit "Disable bot \"$bot_name\" in \"$org_name\"? This revokes its tokens and removes its workspace membership." "$BOT_ASSUME_YES"
          result=$(api DELETE "$bot_path")
          if text_out; then echo "Disabled bot \"$bot_name\" in \"$org_name\"."; else bot_json_result "$result"; fi
          ;;
      esac
      ;;
  esac
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------
cmd_help() {
  cat <<'HELP'
timdo: command line client for TimDo (tasks, epics, life goals, workspaces and bots)

Structure: workspace -> project -> epic -> task. Everyone in a workspace sees all of
its projects, epics, tasks, notes and activity. Roles: owner, admin, member, viewer
(read-only). Human-created tasks default to their creator; bot-created tasks default to unassigned.
Bots must use existing projects in their home workspace and cannot be assigned or have life goals.
Life goals are private to people.

GLOBAL FLAGS (anywhere on the line):
  --json                       JSON output (raw API objects, plus extra fields noted below)
  --text                       Human-readable output. Write commands print JSON when piped
                               unless --text is given, so existing scripts keep working.
  --as <email>                 Owner secret only: act as another TimDo account (sends
                               X-Timdo-User). Also: TIMDO_AS=<email>. Good for previewing
                               what a collaborator sees, e.g. --as robin@example.com.
                               A personal token always acts as its owner.
  --no-color                   No colour (colour is only used on a terminal; NO_COLOR is respected)

SIGNING IN:
  login                        Save a personal or bot token (personal: /settings/access)
                               Issue bot tokens with: timdo bot token <workspace> <bot>
  logout                       Remove the saved token
  whoami                       Who the CLI is acting as, and your workspaces

ENVIRONMENT:
  TIMDO_TOKEN (personal or bot token), TIMDO_API, TIMDO_CONFIG (default ~/.config/timdo/config).
  Owner only: TIMDO_SECRET, TIMDO_AS. Environment variables override the config file.
  If both a token and the secret are set, the token wins except for bot commands with --owner-secret.

TASKS:
  list [status] [opts]         List tasks; --limit 1-200 and --cursor page through results
                               --fields summary|full, --group-by project|epic|assignee
                               Filters include --mine, --assignee, --ref, --shared, --unlinked
  counts [status] [filters]    SQL counts for all five statuses, with membership filters
  get <id>                     Task with workspace, project, people, notes and recent activity
  add "title" -p <project>     Create a task (--title for a dash-leading title, --assign, --project-id, ...)
                               A terminal checks similar open tasks and offers to add a note instead;
                               --yes or --json skips the prompt. --on-duplicate handles source clashes.
  similar "title" [-p project] Open tasks that look like this title, without creating anything
  update <id> [opts]           Edit a task (--assign <who>, --claim, --unassign, --done, ...)
  delete <id>                  Soft-delete a task
  add-note <id> "note"         Add a dated note signed with your name (alias: log)
  notes <id>                   Notes with their authors (alias: updates)
  merge <src> <tgt> [--yes]    Merge source task into target (target survives)
  link <id> <target> [opts]    Link tasks (--type relates_to|blocks|blocked_by|duplicates)
  unlink <id> <target>         Remove a link
  search <query> [opts]        Full-text search (--all, --customer <name>); a pasted URL or
                               kind:id finds tasks carrying that ref first
  activity [opts]              Who did what, newest first (--task, --epic, --project, --workspace, -n)
  events [opts]                Read recorded activity pages (see: timdo events --help)

LINKS TO THINGS OUTSIDE TIMDO (refs):
  A ref is a URL or kind:id with a role: link (default), source (where the task came from,
  one task per workspace), reported_by (who reported it) or about (who or what it concerns).
    github.issue:acme/widgets#12   forum.post:4411   acme.member:123456
  Record people by their id in the other system, not by name or email.
  ref list <id>                Links on a task
  ref add <id> <x> [--role r] [--label "..."]    Adding the same ref twice changes nothing
  ref rm <id> <x> [--role r]   Remove by URL, kind:id or ref id
  find <x> [--role r]          Tasks carrying a ref, any status (same as: list all --ref <x>)
  add/update ... --ref <x> --source <x> --reported-by <x> --about <x>   (update also: --unref <x>)
  add ... --source <x> --on-duplicate error|return|report
                               When that source already has a task: fail (default), print that
                               task, or add this report to it. Safe to retry: one item, one task.

BOTS:
  bot list <workspace>         List safe bot identities and active token counts
  bot create <workspace> <name> [--role member|viewer] [--token-name name]
  bot rename <workspace> <bot> <name>  bot role <workspace> <bot> member|viewer
  bot token <workspace> <bot> [--name name]
  bot revoke-token <workspace> <bot> <token-id|prefix|name> [--yes]
  bot disable <workspace> <bot> [--yes]
                               New tokens are shown once. Revoke and disable need
                               an interactive confirmation or --yes.
                               --owner-secret explicitly selects TIMDO_SECRET for bot commands only.

EPICS, GOALS AND OVERVIEWS:
  epic list|get|add|update|delete   Epics (see: timdo epic --help)
  goal list [-t type]          Your private life goals
  audit [--all]                Hygiene check on your own tasks (--all: everything you can edit)
  customers                    Customers with open counts and their workspaces
  poster --output <path>       Poster SVG of your own tasks (--type done|active|goals)

WORKSPACES AND SHARING (alias: ws, org):
  workspace list               Your workspaces with your role, members and projects
  workspace show <ws>          Members, projects with counts, pending invites
  workspace share <ws> <email> [--role member|viewer|admin]
  workspace role <ws> <email> <role>     workspace remove <ws> <email>
  workspace revoke <ws> <email>          workspace leave <ws>
  workspace create <name>                workspace add-project <ws> <name>
  workspace move-project <project> <ws> --yes
  whoami                       Who the CLI is acting as, and your workspaces

Run `timdo <command> --help` for the options of list, add, update, ref, find, similar,
epic, workspace, activity, events, audit and search.

EXAMPLES:
  timdo list do --mine
  timdo list do -w "Northstar Workshop" --assignee robin
  timdo add "Check inverter firmware" -p Acme Solar --assign robin@example.com
  timdo update ea9f --claim --do
  timdo get ea9f
  timdo activity --project Acme Solar -n 10
  timdo ws share "Northstar Workshop" robin@example.com --role viewer
  timdo --as robin@example.com list do --mine
  timdo add "Renew passport" -p Personal --status awaiting --await-until 2026-08-03
  timdo merge ea9f 1234 --yes
  timdo add "Broken offer page" -p "Acme Solar" --source forum.post:4411 --reported-by acme.member:123456
  timdo ref add ea9f https://github.com/acme/widgets/issues/12
  timdo find forum.post:4411 --role source
  timdo similar "Fix the offer page" -p "Acme Solar"
  timdo add "Offer page shows no prices" -p "Acme Solar" --source forum.post:4412 --on-duplicate report
HELP
}

case "${1:-help}" in
  bot)                 shift; cmd_bot "$@" ;;
  list|ls)             shift; cmd_list "$@" ;;
  counts)               shift; cmd_counts "$@" ;;
  add)                 shift; cmd_add "$@" ;;
  update)              shift; cmd_update "$@" ;;
  workspace|workspaces|ws|org|orgs) shift; cmd_workspace "$@" ;;
  epic|epics)          shift; cmd_epic "$@" ;;
  goal|goals)          shift; cmd_goal "$@" ;;
  poster)              shift; cmd_poster "$@" ;;
  add-note|log)        shift; cmd_add_note "$@" ;;
  notes|updates)       shift; cmd_notes "$@" ;;
  delete)              shift; cmd_delete "$@" ;;
  merge)               shift; cmd_merge "$@" ;;
  get|show)            shift; cmd_get "$@" ;;
  search)              shift; cmd_search "$@" ;;
  audit)               shift; cmd_audit "$@" ;;
  customers)           shift; cmd_customers "$@" ;;
  link)                shift; cmd_link "$@" ;;
  unlink)              shift; cmd_unlink "$@" ;;
  ref|refs)            shift; cmd_ref "$@" ;;
  find)                shift; cmd_find "$@" ;;
  similar)             shift; cmd_similar "$@" ;;
  activity|history)    shift; cmd_activity "$@" ;;
  events)              shift; cmd_events "$@" ;;
  whoami|me)           shift; cmd_whoami "$@" ;;
  login)               shift; cmd_login "$@" ;;
  logout)              shift; cmd_logout "$@" ;;
  help|-h|--help)      cmd_help ;;
  *) usage_die "Unknown command: $1. Run 'timdo help' for usage." ;;
esac
