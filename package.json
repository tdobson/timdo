{
	"name": "timdo",
	"version": "1.0.0",
	"description": "A Next.js and Mantine application to display Tim's projects, inspired by an SVG poster.",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"start": "next start",
		"pages:build": "npx @cloudflare/next-on-pages",
		"deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --commit-dirty=true",
		"update-data": "cp ../../../Documents/poster/tims_projects_json.json app/data/tims_projects.json",
		"typecheck": "tsc --noEmit",
		"lint": "npm run eslint && npm run stylelint",
		"eslint": "next lint",
		"stylelint": "stylelint '**/*.css' --cache",
		"jest": "jest",
		"jest:watch": "jest --watch",
		"prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
		"prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
		"test": "npm run prettier:write && npm run lint && npm run typecheck && npm run jest",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.1.0",
		"@dnd-kit/modifiers": "^7.0.0",
		"@dnd-kit/sortable": "^8.0.0",
		"@langchain/core": "^0.3.61",
		"@langchain/groq": "^0.2.3",
		"@mantine/core": "7.17.7",
		"@mantine/dates": "^7.17.7",
		"@mantine/form": "7.17.7",
		"@mantine/hooks": "7.17.7",
		"@mantine/notifications": "7.17.7",
		"@next/bundle-analyzer": "^15.2.3",
		"@tabler/icons-react": "^3.31.0",
		"@tanstack/react-query": "^5.80.6",
		"dayjs": "1.11.23",
		"dompurify": "^3.4.14",
		"groq-sdk": "^0.25.0",
		"marked": "^18.0.11",
		"next": "15.5",
		"next-auth": "^5.0.0-beta.32",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"uuid": "^10.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.26.10",
		"@cloudflare/next-on-pages": "^1.13.16",
		"@eslint/js": "^9.23.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.1",
		"@storybook/nextjs": "^8.6.8",
		"@storybook/react": "^8.6.8",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/dompurify": "^3.0.5",
		"@types/eslint-plugin-jsx-a11y": "^6",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.11",
		"@types/react": "19.0.12",
		"@types/react-dom": "^19.1.6",
		"@types/uuid": "^10.0.0",
		"babel-loader": "^10.0.0",
		"eslint": "^9.23.0",
		"eslint-config-mantine": "^4.0.3",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.4",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"postcss": "^8.5.3",
		"postcss-preset-mantine": "1.17.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.5.3",
		"storybook": "^8.6.8",
		"storybook-dark-mode": "^4.0.2",
		"stylelint": "^16.16.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"ts-jest": "^29.2.6",
		"typescript": "5.8.2",
		"typescript-eslint": "^8.27.0",
		"wrangler": "^4.0.0"
	},
	"license": "AGPL-3.0-or-later"
}
