{
	"name": "timdo-v2-worker",
	"version": "1.0.0",
	"private": true,
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev src/index.ts",
		"deploy": "wrangler deploy",
		"test": "vitest",
		"lint": "eslint src/**/*.ts",
		"typecheck": "tsc --noEmit",
		"migrations:generate": "drizzle-kit generate",
		"migrations:apply:local": "wrangler d1 migrations apply timdo-v2-db --local",
		"migrations:apply:remote": "wrangler d1 migrations apply timdo-v2-db --remote"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.2.2",
		"@langchain/core": "^0.3.61",
		"@langchain/groq": "^0.2.3",
		"drizzle-orm": "^0.33.0",
		"groq-sdk": "^0.25.0",
		"hono": "^4.13.13",
		"jose": "^5.6.3",
		"uuid": "^10.0.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20240725.0",
		"@types/uuid": "^10.0.0",
		"drizzle-kit": "^0.24.2",
		"eslint": "^8.57.0",
		"typescript": "5.8.2",
		"vitest": "^2.0.4",
		"wrangler": "^4.0.0"
	},
	"license": "AGPL-3.0-or-later"
}
