# Auth0
# You can get these values from your Auth0 Application settings.
# The application should be a "Regular Web Application".
# AUTH0_AUDIENCE should match the API identifier in your Auth0 dashboard
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_ISSUER="https://your-auth0-domain.auth0.com"
AUTH0_AUDIENCE="https://api.yourdomain.com"

# NextAuth.js
# The URL of your application. For local development, it's http://localhost:3000.
# For production, it must be your public deployment URL.
# This is used for redirects by Auth0.
NEXTAUTH_URL="http://localhost:3000"

# A secret used to sign and encrypt session cookies.
# You can generate a good secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET="a-long-random-string-for-session-encryption"

# API Endpoint for Next.js to call Worker
# Public URL for client-side calls
NEXT_PUBLIC_WORKER_API_BASE_URL="http://127.0.0.1:8787/api/v2"
# Secret for Next.js to Worker internal calls (e.g., for /users/ensure)
INTERNAL_API_SECRET="a-very-strong-secret-for-nextjs-to-worker-calls"

# Groq API Key for AI features
# Get a key from https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# This instance's name and branding (all optional; the defaults are timdo.tdobson.net's).
# See docs/running-your-own-instance.md.
# NEXT_PUBLIC_APP_NAME="TimDo"
# NEXT_PUBLIC_SITE_TITLE="TimDo - Tim's Projects"
# NEXT_PUBLIC_SITE_DESCRIPTION="A dynamic display of Tim's projects, inspired by the SVG project poster."
# NEXT_PUBLIC_CONTACT_EMAIL="tim@example.com"
# NEXT_PUBLIC_REPO_URL="https://github.com/tdobson/timdo"
# NEXT_PUBLIC_COPYRIGHT="© 2025 Tim Dobson"
# NEXT_PUBLIC_CREATOR_NAME="Tim Dobson"          # set to "" to hide the "Made by" card
# NEXT_PUBLIC_CREATOR_BIO="..."
# NEXT_PUBLIC_CREATOR_TAGLINE="..."
# NEXT_PUBLIC_CREATOR_LINKS="LinkedIn|https://linkedin.com/in/tdobson,GitHub|https://github.com/tdobson"
# NEXT_PUBLIC_APP_URL="https://timdo.tdobson.net"   # only needed for server-rendered invite links
