# Keep LF endings in every checkout, whatever core.autocrlf says. A clone made with
# autocrlf=true (the Git for Windows default, often inherited by WSL) otherwise turns
# bin/timdo into a CRLF file and the shebang fails with "bash\r: No such file or directory".
* text=auto eol=lf

# Executables and shell scripts must be LF to run at all
bin/timdo text eol=lf
*.sh text eol=lf
mcp/index.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
